---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const logoSrc = `${import.meta.env.BASE_URL}images/LOGO.webp`;
---

<a href="#inicio" class="inline-flex shrink-0 items-center" aria-label="Ferremax — ir al inicio">
  <img
    src={logoSrc}
    alt=""
    class={compact ? 'h-8 w-auto' : 'h-10 w-auto'}
    width="286"
    height="72"
    decoding="async"
  />
</a>
