---
/**
 * PROPUESTA E
 * Barra negra en una sola fila: logo, todas las secciones juntas, buscador
 * (en la barra desde 2xl; antes, una lupa lo abre en el panel), Llamar y
 * Cotizar. Los enlaces "ruedan" al pasar el cursor.
 * "Catálogo" abre pestañas verticales: un bloque amarillo se desliza entre
 * las familias y el lado derecho cambia con fundido (subfamilias + foto +
 * pictograma gigante de fondo). Móvil: pantalla completa que se revela en
 * círculo desde el botón de menú.
 */
import Logo from '../Logo.astro';
import Pictogram from '../ui/Pictogram.astro';
import HeaderSearch from '../catalog/HeaderSearch';
import { whatsappUrl, siteSeo } from '../../lib/seo';
import { rutaInterna, assetUrl } from '../../lib/asset-url';
import { enlaces, sucursales, prepararNav } from './nav-data';
import type { Producto } from '../../lib/types';

interface Props {
  productos: Producto[];
}
const { productos } = Astro.props;
const { familiasNav, catalogo } = prepararNav(productos);

const [nosotros, servicios, sucursalesLink, contacto] = enlaces;
/* Ciudades de la que tiene más sucursales a la que tiene menos (Tijuana, Ensenada, Mexicali). */
const porCiudad = (c: string) => sucursales.filter((s) => s.ciudad === c).length;
const ciudadesLista = [...new Set(sucursales.map((s) => s.ciudad))].sort((a, b) => porCiudad(b) - porCiudad(a));
const ciudades = ciudadesLista.join(' · ');
const avisos = [
  `Sucursales en ${ciudades}`,
  'Corte de placa a la medida',
  'Entregas en obra',
  `Llámanos ${siteSeo.phone}`,
  'Armex, castillos y anillos de fabricación propia',
];
---

<header data-ne class="ne sticky top-0 z-40 text-text-inverse">

  <!-- Barra -->
  <!-- La barra no tiene alto fijo: crece con el logo (mínimo 72 px) -->
  <div class="ne-bar relative" data-ne-bar>
    <!-- Una sola fila: logo · todas las secciones juntas · buscador · acciones -->
    <div class="container-page flex min-h-[4.5rem] items-center gap-6 py-2 xl:gap-8">
      <div class="shrink-0"><Logo /></div>

      <nav aria-label="Navegación principal" class="hidden items-center gap-6 lg:flex xl:gap-7">
        <button type="button" data-ne-trigger="catalogo" aria-expanded="false" aria-controls="ne-mega" class="ne-link">
          <span class="ne-roll" data-text="Catálogo"><span>Catálogo</span></span>
          <span class="ne-plus" aria-hidden="true"></span>
        </button>
        <button type="button" data-ne-trigger="sucursales" aria-expanded="false" aria-controls="ne-mega" class="ne-link">
          <span class="ne-roll" data-text={sucursalesLink.label}><span>{sucursalesLink.label}</span></span>
          <span class="ne-plus" aria-hidden="true"></span>
        </button>
        {[servicios, nosotros, contacto].map((e) => (
          <a href={e.href} class="ne-link" data-ne-plain><span class="ne-roll" data-text={e.label}><span>{e.label}</span></span></a>
        ))}
      </nav>

      <!-- Buscador en la barra (pantallas anchas) -->
      <div class="ne-search ml-auto hidden min-w-0 max-w-80 flex-1 2xl:block" data-ne-plain>
        <HeaderSearch idBase="buscar-barra" client:idle />
      </div>

      <div class="ml-auto flex shrink-0 items-center gap-3 2xl:ml-0">
        <!-- Lupa: abre el buscador en el panel (escritorio sin espacio para la barra) -->
        <button type="button" data-ne-buscar aria-expanded="false" aria-controls="ne-mega" aria-label="Buscar productos" class="ne-lupa max-lg:!hidden 2xl:!hidden">
          <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"><use href={`${assetUrl('/icons.svg')}#search`} /></svg>
        </button>
        <a href={`tel:${siteSeo.phoneHref}`} class="ne-call btn-chamfer max-md:!hidden lg:max-xl:!hidden" aria-label={`Llamar al ${siteSeo.phone}`}>
          <span class="ne-roll" data-text="Llamar"><span>Llamar</span></span>
        </a>
        <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="ne-cta btn-chamfer">
          <span class="ne-roll" data-text="Cotizar"><span>Cotizar</span></span>
        </a>
        <button type="button" data-ne-burger aria-expanded="false" aria-controls="ne-full" aria-label="Abrir menú" class="ne-burger lg:!hidden">
          <i></i><i></i><i></i>
        </button>
      </div>
    </div>
  </div>
  <div class="h-1.5 bg-accent-primary" aria-hidden="true"></div>

  <!-- Mega con pestañas verticales -->
  <div id="ne-mega" data-ne-mega class="ne-mega hidden lg:block" aria-hidden="true">
    <div data-ne-view="catalogo" class="container-page grid grid-cols-[17rem_1fr] gap-10 py-10">
      <div role="tablist" aria-orientation="vertical" aria-label="Familias" class="relative flex flex-col">
        <span data-ne-marker class="ne-marker" aria-hidden="true"></span>
        {familiasNav.map((f, i) => (
          <button type="button" role="tab" data-ne-tab={i} aria-selected={i === 0 ? 'true' : 'false'} class="ne-tab">
            <span class="tabular-nums opacity-60">{String(i + 1).padStart(2, '0')}</span>
            {f.titulo}
          </button>
        ))}
        <a href={catalogo} class="mt-4 inline-flex items-center gap-2 px-4 type-button-s text-accent-primary hover:text-accent-hover">Catálogo completo →</a>
      </div>

      <div class="relative grid min-h-80">
        {familiasNav.map((f, i) => (
          <div role="tabpanel" data-ne-pane={i} class:list={['ne-pane grid grid-cols-[1fr_16rem] gap-8', { 'is-active': i === 0 }]}>
            <Pictogram name={f.icono} class="ne-watermark" />
            <div class="relative">
              <p class="type-overline text-accent-primary">{String(i + 1).padStart(2, '0')} / Familia</p>
              <h3 class="mt-2 type-h1">{f.titulo}</h3>
              <ul class="mt-6 grid grid-cols-2 gap-x-6">
                {f.items.map((item, j) => (
                  <li class="ne-sub" style={`--i:${j}`}>
                    <a href={f.href} class="group flex items-center justify-between border-b border-white/10 py-3 type-label text-text-inverse-muted transition-colors hover:text-text-inverse">
                      {item}
                      <span class="translate-x-[-6px] text-accent-primary opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <a href={f.href} class="ne-photo chamfer relative block h-full overflow-hidden" aria-label={`Ver ${f.titulo}`}>
              <img src={f.foto} alt="" loading="lazy" class="absolute inset-0 size-full object-cover" />
              <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-4 type-button-s">Ver {f.corto} →</span>
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Sucursales: misma distribución (una columna por ciudad), con el lenguaje del menú de catálogo -->
    <div data-ne-view="sucursales" hidden class="container-page grid grid-cols-3 gap-10 py-10">
      {ciudadesLista.map((ciudad, c) => {
        const deCiudad = sucursales.filter((s) => s.ciudad === ciudad);
        return (
          <div class="ne-col" style={`--c:${c}`}>
            <p class="type-overline text-accent-primary">{deCiudad.length === 1 ? '1 sucursal' : `${deCiudad.length} sucursales`}</p>
            <h3 class="mt-2 type-h2">{ciudad}</h3>
            <ul class="mt-5 flex flex-col">
              {deCiudad.map((s, j) => (
                <li class="ne-suc-item" style={`--i:${c * 3 + j}`}>
                  <a href={rutaInterna(`/sucursales/#${s.id}`)} class="ne-suc">
                    <span class="type-label">{s.nombre.replace('Sucursal ', '')}</span>
                    <span class="ne-suc-dato type-caption">{s.direccion}, <span class="whitespace-nowrap">{s.telefonos[0]}</span></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>

    <!-- Buscar: mismo lenguaje que las otras vistas (dato real arriba, título grande) -->
    <div data-ne-view="buscar" hidden class="container-page grid grid-cols-[17rem_1fr] gap-10 py-10">
      <div>
        <p class="type-overline text-accent-primary">{familiasNav.length} familias de producto</p>
        <h3 class="mt-2 type-h2">Buscar</h3>
      </div>
      <div class="ne-buscar-campo self-end">
        <HeaderSearch idBase="buscar-panel" client:idle />
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
          {familiasNav.map((f) => (
            <li><a href={f.href} class="type-label text-text-inverse-muted transition-colors hover:text-accent-primary">{f.titulo}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Pantalla completa (móvil) -->
  <div id="ne-full" data-ne-full class="ne-full lg:hidden" hidden>
    <nav aria-label="Navegación principal" class="container-page flex min-h-full flex-col pb-10 pt-6">
      <div class="ne-full-item mb-4" style="--i:0">
        <HeaderSearch idBase="buscar-movil" client:idle />
      </div>
      <ul class="flex flex-col">
        {[{ href: catalogo, label: 'Catálogo' }, ...enlaces].map((e, i) => (
          <li class="ne-full-item" style={`--i:${i}`}>
            <a href={e.href} class="flex items-baseline gap-4 border-b border-white/10 py-3">
              <span class="type-overline text-accent-primary">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-display text-5xl font-extrabold uppercase leading-none">{e.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="ne-full-item mt-auto flex flex-col gap-1 pt-10 type-body-s text-text-inverse-muted" style="--i:6">
        <a href={`tel:${siteSeo.phoneHref}`} class="text-text-inverse">{siteSeo.phone}</a>
        <span>{ciudades}</span>
      </div>
    </nav>
  </div>
</header>

<script>
  const root = document.querySelector<HTMLElement>('[data-ne]');
  if (root) {
    const triggers = [...root.querySelectorAll<HTMLButtonElement>('[data-ne-trigger]')];
    const vistas = [...root.querySelectorAll<HTMLElement>('[data-ne-view]')];
    const mega = root.querySelector<HTMLElement>('[data-ne-mega]')!;
    const lupa = root.querySelector<HTMLButtonElement>('[data-ne-buscar]')!;
    let tCerrar: number | undefined;
    let abierta: string | null = null;

    /* Abre el panel con la vista indicada ('catalogo' o 'sucursales'); null lo cierra. */
    const alternarMega = (vista: string | null) => {
      window.clearTimeout(tCerrar);
      abierta = vista;
      triggers.forEach((t) => t.setAttribute('aria-expanded', String(t.dataset.neTrigger === vista)));
      lupa.setAttribute('aria-expanded', String(vista === 'buscar'));
      mega.classList.toggle('is-open', vista !== null);
      mega.setAttribute('aria-hidden', String(vista === null));
      if (vista === null) return;
      vistas.forEach((v) => (v.hidden = v.dataset.neView !== vista));
      if (vista === 'catalogo') requestAnimationFrame(() => moverMarcador(tabs.find((t) => t.getAttribute('aria-selected') === 'true')!));
    };
    triggers.forEach((t) => {
      const vista = t.dataset.neTrigger!;
      t.addEventListener('click', () => alternarMega(abierta === vista ? null : vista));
      t.addEventListener('mouseenter', () => alternarMega(vista));
    });
    root.querySelectorAll('[data-ne-plain]').forEach((a) => a.addEventListener('mouseenter', () => abierta !== 'buscar' && alternarMega(null)));
    /* El buscador solo se cierra con clic fuera, Escape o la lupa: no al sacar el cursor mientras se escribe. */
    root.addEventListener('mouseleave', () => {
      if (abierta !== 'buscar') tCerrar = window.setTimeout(() => alternarMega(null), 300);
    });
    lupa.addEventListener('click', () => {
      alternarMega(abierta === 'buscar' ? null : 'buscar');
      if (abierta === 'buscar') window.setTimeout(() => mega.querySelector<HTMLInputElement>('[data-ne-view="buscar"] input')?.focus(), 80);
    });
    root.addEventListener('mouseenter', () => window.clearTimeout(tCerrar));
    document.addEventListener('mousedown', (e) => {
      if (mega.classList.contains('is-open') && !root.contains(e.target as Node)) alternarMega(null);
    });

    /* Pestañas verticales con marcador deslizante */
    const marker = root.querySelector<HTMLElement>('[data-ne-marker]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-ne-tab]')];
    const panes = [...root.querySelectorAll<HTMLElement>('[data-ne-pane]')];
    const moverMarcador = (t: HTMLElement) => {
      marker.style.setProperty('--y', `${t.offsetTop}px`);
      marker.style.setProperty('--h', `${t.offsetHeight}px`);
    };
    const activar = (t: HTMLButtonElement) => {
      if (t.getAttribute('aria-selected') === 'true') return;
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      panes.forEach((p) => p.classList.toggle('is-active', p.dataset.nePane === t.dataset.neTab));
      moverMarcador(t);
    };
    tabs.forEach((t) => {
      t.addEventListener('mouseenter', () => activar(t));
      t.addEventListener('click', () => activar(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const sig = tabs[(tabs.indexOf(t) + d + tabs.length) % tabs.length];
        sig.focus();
        activar(sig);
      });
    });

    /* Alto real de la barra (depende del logo): el menú móvil empieza debajo de ella. */
    const barra = root.querySelector<HTMLElement>('[data-ne-bar]')!;
    new ResizeObserver(() => root.style.setProperty('--ne-alto', `${barra.offsetHeight}px`)).observe(barra);

    /* Posición del cursor para el aura amarilla (una actualización por cuadro). */
    let cuadro = 0;
    barra.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || cuadro) return;
      cuadro = requestAnimationFrame(() => {
        cuadro = 0;
        const r = barra.getBoundingClientRect();
        barra.style.setProperty('--mx', `${e.clientX - r.left}px`);
        barra.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });

    /* Pantalla completa con revelado circular */
    const burger = root.querySelector<HTMLButtonElement>('[data-ne-burger]')!;
    const full = root.querySelector<HTMLElement>('[data-ne-full]')!;
    const alternarFull = (abrir: boolean) => {
      const r = burger.getBoundingClientRect();
      full.style.setProperty('--cx', `${r.left + r.width / 2}px`);
      full.style.setProperty('--cy', `${r.top + r.height / 2}px`);
      burger.setAttribute('aria-expanded', String(abrir));
      burger.setAttribute('aria-label', abrir ? 'Cerrar menú' : 'Abrir menú');
      document.documentElement.style.overflow = abrir ? 'hidden' : '';
      if (abrir) { full.hidden = false; requestAnimationFrame(() => requestAnimationFrame(() => full.classList.add('is-open'))); }
      else { full.classList.remove('is-open'); window.setTimeout(() => (full.hidden = true), 550); }
    };
    burger.addEventListener('click', () => alternarFull(full.hidden));
    /* En escritorio no hay botón de menú: si se agranda la ventana con el menú abierto, se cierra. */
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (m) => m.matches && !full.hidden && alternarFull(false));

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      alternarMega(null);
      if (!full.hidden) alternarFull(false);
    });
  }
</script>

<style>
  .ne { --ease: cubic-bezier(0.2, 0.8, 0.2, 1); }

  /* Barra siempre negra sólida, sin cambio al hacer scroll. */
  .ne-bar { background: var(--color-neutral-950); }
  .ne-bar > * { position: relative; z-index: 1; }

  /* Aura amarilla muy tenue que sigue al cursor dentro de la barra (solo con mouse). */
  .ne-bar::before {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background: radial-gradient(22rem circle at var(--mx, 50%) var(--my, 50%), rgb(234 192 43 / 9%), transparent 70%);
    transition: opacity 400ms;
  }
  @media (hover: hover) and (pointer: fine) {
    .ne-bar:hover::before { opacity: 1; }
  }

  /* Texto que rueda */
  .ne-link { display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; font-family: var(--font-display); font-weight: 600; font-size: 1rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .ne-roll { position: relative; display: inline-block; overflow: hidden; line-height: 1.3; }
  .ne-roll > span { display: inline-block; transition: transform 450ms var(--ease); }
  .ne-roll::after { content: attr(data-text); position: absolute; left: 0; top: 100%; color: var(--color-accent-primary); transition: transform 450ms var(--ease); }
  :is(.ne-link, .ne-cta):hover .ne-roll > span,
  :is(.ne-link, .ne-cta):focus-visible .ne-roll > span,
  .ne-link[aria-expanded="true"] .ne-roll > span { transform: translateY(-100%); }
  :is(.ne-link, .ne-cta):hover .ne-roll::after,
  :is(.ne-link, .ne-cta):focus-visible .ne-roll::after,
  .ne-link[aria-expanded="true"] .ne-roll::after { transform: translateY(-100%); }

  .ne-plus { position: relative; width: 10px; height: 10px; }
  .ne-plus::before, .ne-plus::after { content: ""; position: absolute; inset: 4px 0; background: var(--color-accent-primary); transition: transform 350ms var(--ease); }
  .ne-plus::after { transform: rotate(90deg); }
  [aria-expanded="true"] .ne-plus::after { transform: rotate(0deg); }
  [aria-expanded="true"] .ne-plus::before { transform: rotate(180deg); }

  .ne-cta { --btn-bg: var(--color-accent-primary); display: inline-flex; align-items: center; height: 2.75rem; padding: 0 1.4rem; color: var(--color-neutral-1000); font-family: var(--font-display); font-weight: 700; font-size: 1rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .ne-cta .ne-roll::after { color: var(--color-neutral-1000); }
  .ne-cta:hover { --btn-bg: var(--color-neutral-0); }

  /* Lupa: cuadro de 44 px; activa en amarillo como los enlaces abiertos. */
  .ne-lupa { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; cursor: pointer; color: var(--color-text-inverse); transition: color 200ms, background 200ms; }
  .ne-lupa:hover, .ne-lupa[aria-expanded="true"] { color: var(--color-accent-primary); background: rgb(255 255 255 / 6%); }
  .ne-lupa:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--color-accent-primary); }
  /* Buscador del panel: un poco más alto que el de la barra. */
  .ne-buscar-campo :global(form) { height: 3.25rem; }

  /* Llamar: contorno blanco, mismo alto que Cotizar; el texto rueda a amarillo. */
  .ne-call { display: inline-flex; align-items: center; height: 2.75rem; padding: 0 1.2rem; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 40%); font-family: var(--font-display); font-weight: 700; font-size: 1rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .ne-call:hover { --btn-bg: rgb(255 255 255 / 6%); box-shadow: inset 0 0 0 1px var(--color-text-inverse); }
  .ne-call:hover .ne-roll > span, .ne-call:focus-visible .ne-roll > span,
  .ne-call:hover .ne-roll::after, .ne-call:focus-visible .ne-roll::after { transform: translateY(-100%); }

  .ne-burger { display: inline-flex; flex-direction: column; align-items: flex-end; justify-content: center; gap: 5px; width: 2.75rem; height: 2.75rem; cursor: pointer; }
  .ne-burger i { display: block; height: 2px; background: currentColor; transition: width 350ms var(--ease), transform 350ms var(--ease), opacity 200ms; }
  .ne-burger i:nth-child(1) { width: 24px; }
  .ne-burger i:nth-child(2) { width: 16px; }
  .ne-burger i:nth-child(3) { width: 20px; }
  .ne-burger:hover i { width: 24px; }
  .ne-burger[aria-expanded="true"] i:nth-child(1) { width: 24px; transform: translateY(7px) rotate(45deg); }
  .ne-burger[aria-expanded="true"] i:nth-child(2) { opacity: 0; }
  .ne-burger[aria-expanded="true"] i:nth-child(3) { width: 24px; transform: translateY(-7px) rotate(-45deg); }

  /* Mega */
  .ne-mega {
    position: absolute; inset-inline: 0; top: 100%; background: var(--color-neutral-950); box-shadow: 0 30px 60px rgb(0 0 0 / 45%);
    clip-path: inset(0 0 100% 0); visibility: hidden; transition: clip-path 500ms var(--ease), visibility 0s 500ms;
  }
  .ne-mega.is-open { clip-path: inset(0 0 -80px 0); visibility: visible; transition: clip-path 550ms var(--ease); }
  .ne-marker { position: absolute; left: 0; right: 0; top: 0; height: var(--h, 0); transform: translateY(var(--y, 0)); background: var(--color-accent-primary); transition: transform 400ms var(--ease), height 400ms var(--ease); }
  .ne-tab { position: relative; display: flex; gap: 0.9rem; padding: 0.75rem 1rem; cursor: pointer; text-align: left; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; text-transform: uppercase; color: var(--color-text-inverse-muted); transition: color 300ms, padding 300ms var(--ease); }
  .ne-tab:hover { color: var(--color-text-inverse); }
  .ne-tab[aria-selected="true"] { color: var(--color-neutral-1000); padding-left: 1.4rem; }

  /* Todos los paneles comparten la misma celda: el alto es el del más alto y la foto lo llena siempre. */
  .ne-pane { position: relative; grid-area: 1 / 1; opacity: 0; visibility: hidden; }
  .ne-pane.is-active { opacity: 1; visibility: visible; }
  .ne-pane :global(.ne-watermark) { position: absolute; right: 17rem; top: -1rem; width: 14rem; height: 14rem; color: rgb(255 255 255 / 4%); stroke-width: 1; transform: rotate(-8deg); transition: transform 900ms var(--ease); pointer-events: none; }
  .ne-pane.is-active :global(.ne-watermark) { transform: rotate(0deg) scale(1.05); }
  .ne-sub { opacity: 0; transform: translateY(6px); }
  .ne-pane.is-active .ne-sub { opacity: 1; transform: none; transition: opacity 350ms, transform 450ms var(--ease); transition-delay: calc(140ms + var(--i) * 40ms); }
  .ne-photo { min-height: 18rem; align-self: stretch; }

  /* Sucursales: filas con línea tenue como las subfamilias; al pasar el cursor entra
     el bloque amarillo de las pestañas del catálogo y el texto se recorre. */
  .ne-col + .ne-col { border-left: 1px solid rgb(255 255 255 / 8%); padding-left: 2.5rem; }
  .ne-suc {
    position: relative; isolation: isolate; display: flex; flex-direction: column; gap: 0.15rem;
    padding: 0.8rem 1rem; border-bottom: 1px solid rgb(255 255 255 / 10%);
    color: var(--color-text-inverse-muted); transition: color 300ms, padding 300ms var(--ease);
  }
