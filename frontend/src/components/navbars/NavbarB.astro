---
/**
 * PROPUESTA B · "Isla dinámica" (ref. Supaste)
 * Una cápsula negra flotante. Una píldora amarilla sigue al cursor entre los
 * enlaces. Al bajar, la isla se angosta; al abrir "Catálogo" se transforma
 * (crece en ancho y alto) y revela buscador + chips de familias + tarjetas
 * deslizables que cambian con cada chip. En móvil la misma isla contiene el
 * menú completo.
 */
import Logo from '../Logo.astro';
import HeaderSearch from '../catalog/HeaderSearch';
import Pictogram from '../ui/Pictogram.astro';
import { whatsappUrl } from '../../lib/seo';
import { assetUrl } from '../../lib/asset-url';
import { enlaces, prepararNav } from './nav-data';
import type { Producto } from '../../lib/types';

interface Props {
  productos: Producto[];
}
const { productos } = Astro.props;
const { familiasNav, catalogo } = prepararNav(productos);
---

<!-- Alto 0: la isla flota sobre la primera sección en vez de dejar una franja vacía arriba. -->
<header data-nb class="nb pointer-events-none sticky top-3 z-40 h-0 px-3 sm:px-4">
  <div data-nb-island class="nb-island pointer-events-auto mx-auto bg-neutral-950 text-text-inverse">
    <!-- Barra -->
    <div class="flex h-16 items-center gap-3 pl-4 pr-2 sm:pl-5">
      <div class="nb-logo shrink-0"><Logo compact /></div>

      <nav aria-label="Navegación principal" data-nb-links class="relative mx-auto hidden items-center lg:flex">
        <span data-nb-pill class="nb-pill" aria-hidden="true"></span>
        <button type="button" data-nb-toggle aria-expanded="false" aria-controls="nb-panel" class="nb-link group">
          Catálogo
          <svg viewBox="0 0 10 6" class="h-1.5 w-2.5 transition-transform duration-300 group-aria-expanded:rotate-180" fill="none" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        {enlaces.map((e) => <a href={e.href} class="nb-link">{e.label}</a>)}
      </nav>

      <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="nb-cta ml-auto lg:ml-0">
        <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"><use href={`${assetUrl('/icons.svg')}#whatsapp`} /></svg>
        <span class="hidden sm:inline">Cotizar</span>
      </a>
      <button type="button" data-nb-toggle data-nb-mobile aria-expanded="false" aria-controls="nb-panel" aria-label="Abrir menú" class="nb-round lg:hidden">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="nb-ico-a" d="M4 8h16M4 16h16" /><path class="nb-ico-b" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <!-- Contenido expandible -->
    <div id="nb-panel" data-nb-panel class="nb-panel">
      <div class="min-h-0 overflow-hidden">
        <div class="nb-panel-inner flex flex-col gap-5 px-4 pb-5 pt-1 sm:px-5">
          <HeaderSearch client:visible />

          <!-- Enlaces (solo móvil) -->
          <ul class="grid grid-cols-2 gap-2 lg:hidden">
            {enlaces.map((e) => <li><a href={e.href} class="nb-tile block">{e.label}</a></li>)}
          </ul>

          <div role="tablist" aria-label="Familias de producto" class="nb-chips flex gap-2 overflow-x-auto pb-1">
            {
              familiasNav.map((f, i) => (
                <button type="button" role="tab" data-nb-chip={i} aria-selected={i === 0 ? 'true' : 'false'} class="nb-chip">
                  {f.corto}
                  <span class="nb-count">{f.items.length}</span>
                </button>
              ))
            }
            <a href={catalogo} class="nb-chip nb-chip-plus" aria-label="Ver catálogo completo">+</a>
          </div>

          {
            familiasNav.map((f, i) => (
              <div role="tabpanel" data-nb-cards={i} hidden={i !== 0} class="nb-cards flex snap-x gap-3 overflow-x-auto pb-2">
                <a href={f.href} class="nb-card nb-card-photo group" style="--i:0">
                  <img src={f.foto} alt="" loading="lazy" class="absolute inset-0 size-full object-cover transition-transform duration-700 group-hover:scale-105" />
                  <span class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent" />
                  <span class="relative mt-auto type-h4 uppercase">{f.titulo}</span>
                  <span class="relative type-caption text-text-inverse-muted">Ver todo →</span>
                </a>
                {f.items.map((item, j) => (
                  <a href={f.href} class="nb-card group" style={`--i:${j + 1}`}>
                    <Pictogram name={f.icono} class="size-7 text-accent-primary transition-transform duration-300 group-hover:-translate-y-1 group-hover:rotate-[-6deg]" />
                    <span class="mt-auto type-label">{item}</span>
                    <span class="type-caption text-text-inverse-muted">{f.corto}</span>
                  </a>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const root = document.querySelector<HTMLElement>('[data-nb]');
  if (root) {
    const island = root.querySelector<HTMLElement>('[data-nb-island]')!;
    const toggles = [...root.querySelectorAll<HTMLButtonElement>('[data-nb-toggle]')];
    const movil = root.querySelector<HTMLButtonElement>('[data-nb-mobile]')!;

    let asentado: number | undefined;
    const alternar = (abrir: boolean) => {
      island.classList.toggle('is-open', abrir);
      /* Al terminar la animación se libera el overflow para que las
         sugerencias del buscador no se recorten. */
      window.clearTimeout(asentado);
      island.classList.remove('is-settled');
      if (abrir) asentado = window.setTimeout(() => island.classList.add('is-settled'), 620);
      toggles.forEach((t) => t.setAttribute('aria-expanded', String(abrir)));
      movil.setAttribute('aria-label', abrir ? 'Cerrar menú' : 'Abrir menú');
    };
    toggles.forEach((t) => t.addEventListener('click', () => alternar(!island.classList.contains('is-open'))));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && alternar(false));
    document.addEventListener('mousedown', (e) => {
      if (!island.contains(e.target as Node)) alternar(false);
    });

    /* Píldora que sigue al cursor entre los enlaces */
    const links = root.querySelector<HTMLElement>('[data-nb-links]')!;
    const pill = root.querySelector<HTMLElement>('[data-nb-pill]')!;
    links.querySelectorAll<HTMLElement>('.nb-link').forEach((link) => {
      const mover = () => {
        pill.style.setProperty('--x', `${link.offsetLeft}px`);
        pill.style.setProperty('--w', `${link.offsetWidth}px`);
        pill.classList.add('is-on');
      };
      link.addEventListener('mouseenter', mover);
      link.addEventListener('focus', mover);
    });
    links.addEventListener('mouseleave', () => pill.classList.remove('is-on'));

    /* Chips → tarjetas */
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-nb-chip]')];
    const grupos = [...root.querySelectorAll<HTMLElement>('[data-nb-cards]')];
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-selected', String(c === chip)));
        grupos.forEach((g) => (g.hidden = g.dataset.nbCards !== chip.dataset.nbChip));
      }),
    );

    /* Scroll: la isla se angosta */
    let pendiente = false;
    window.addEventListener('scroll', () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pendiente = false;
        root.classList.toggle('is-scrolled', window.scrollY > 60);
      });
    }, { passive: true });
  }
</script>

<style>
  .nb-island {
    --ease: cubic-bezier(0.32, 0.72, 0, 1);
    max-width: 72rem;
    border-radius: 2rem;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 8%), 0 18px 50px rgb(0 0 0 / 35%);
    transition: max-width 600ms var(--ease), border-radius 600ms var(--ease), box-shadow 400ms;
  }
  .nb.is-scrolled .nb-island { max-width: 58rem; }
  .nb .nb-island.is-open { max-width: 72rem; border-radius: 1.75rem; box-shadow: 0 0 0 1px rgb(255 255 255 / 10%), 0 30px 80px rgb(0 0 0 / 55%); }
  @media (max-width: 63.99rem) { .nb.is-scrolled .nb-island { max-width: 72rem; } }

  /* La isla flota sobre la primera sección: esta se extiende por detrás (sin franja blanca)
     y su contenido baja lo que mide la isla (12 px de aire + 64 px de barra). */
  :global(.nb ~ main > :first-child:not(.contents)),
  :global(.nb ~ main > .contents:first-child > :first-child) { padding-top: 4.75rem; }

  .nb-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 600ms var(--ease); }
  .is-open .nb-panel { grid-template-rows: 1fr; }
  .is-settled .nb-panel > div { overflow: visible; }
  .nb-panel-inner { opacity: 0; transform: translateY(-8px) scale(0.98); transform-origin: top; transition: opacity 250ms, transform 500ms var(--ease); }
  .is-open .nb-panel-inner { opacity: 1; transform: none; transition-delay: 120ms; }
  .nb-island:not(.is-open) .nb-panel { visibility: hidden; transition: grid-template-rows 600ms var(--ease), visibility 0s 600ms; }

  .nb-link {
    position: relative; z-index: 1;
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.55rem 1rem; border-radius: 999px; cursor: pointer;
    font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; letter-spacing: 0.02em;
    color: var(--color-text-inverse-muted); transition: color 250ms;
  }
  .nb-link:hover, .nb-link:focus-visible, .nb-link[aria-expanded="true"] { color: var(--color-text-on-accent); }
  .nb-link[aria-expanded="true"] { background: var(--color-accent-primary); }
  .nb-pill {
    position: absolute; top: 50%; left: 0; height: 2.4rem; width: var(--w, 0);
    translate: var(--x, 0) -50%; border-radius: 999px; background: var(--color-accent-primary);
    opacity: 0; transition: translate 450ms var(--ease, ease), width 450ms var(--ease, ease), opacity 200ms;
  }
  .nb-pill.is-on { opacity: 1; }

  .nb-cta {
    display: inline-flex; align-items: center; gap: 0.5rem; height: 3rem; padding: 0 1.25rem; border-radius: 999px;
    background: var(--color-neutral-0); color: var(--color-neutral-1000);
    font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; letter-spacing: 0.03em; text-transform: uppercase;
    transition: transform 300ms var(--ease, ease), background 200ms;
  }
  .nb-cta:hover { background: var(--color-accent-primary); transform: scale(1.04); }
  .nb-round { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 999px; background: rgb(255 255 255 / 8%); cursor: pointer; }
  .nb-round path { transition: opacity 250ms, transform 350ms; transform-origin: center; }
  .nb-ico-b { opacity: 0; transform: rotate(-90deg); }
  [aria-expanded="true"] .nb-ico-a { opacity: 0; transform: rotate(90deg); }
  [aria-expanded="true"] .nb-ico-b { opacity: 1; transform: none; }

  .nb-chips { scrollbar-width: none; }
  .nb-chip {
    display: inline-flex; flex-shrink: 0; align-items: center; gap: 0.5rem;
    height: 2.5rem; padding: 0 0.6rem 0 1.1rem; border-radius: 999px; cursor: pointer;
    background: rgb(255 255 255 / 8%); color: var(--color-text-inverse);
    font-size: 0.875rem; font-weight: 600; transition: background 250ms, color 250ms, transform 250ms;
  }
  .nb-chip:hover { background: rgb(255 255 255 / 14%); }
  .nb-chip[aria-selected="true"] { background: var(--color-neutral-0); color: var(--color-neutral-1000); }
  .nb-count { min-width: 1.6rem; padding: 0.1rem 0.4rem; border-radius: 999px; background: rgb(255 255 255 / 10%); font-size: 0.75rem; text-align: center; color: var(--color-text-inverse-muted); }
  .nb-chip[aria-selected="true"] .nb-count { background: var(--color-accent-primary); color: var(--color-neutral-1000); }
  .nb-chip-plus { justify-content: center; width: 2.5rem; padding: 0; font-size: 1.25rem; }

  .nb-cards { scrollbar-width: thin; scrollbar-color: rgb(255 255 255 / 20%) transparent; }
  .nb-card {
    position: relative; overflow: hidden; flex-shrink: 0; scroll-snap-align: start;
    display: flex; flex-direction: column; gap: 0.25rem;
    width: 11rem; height: 9.5rem; padding: 1rem; border-radius: 1.1rem;
    background: var(--color-neutral-900); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 6%);
    animation: nb-card-in 500ms var(--ease, ease) both; animation-delay: calc(var(--i) * 45ms);
    transition: background 250ms, transform 300ms;
  }
  .nb-card:hover { background: var(--color-neutral-800); transform: translateY(-3px); }
  .nb-card-photo { width: 14rem; }
  @keyframes nb-card-in { from { opacity: 0; transform: translateX(24px) scale(0.96); } }

  .nb-tile { padding: 0.85rem 1rem; border-radius: 1rem; background: rgb(255 255 255 / 6%); font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; text-transform: uppercase; }
  .nb-tile:hover { background: var(--color-accent-primary); color: var(--color-neutral-1000); }

  @media (prefers-reduced-motion: reduce) {
    .nb *, .nb-island { transition-duration: 1ms !important; animation: none !important; }
  }
</style>
