---
/**
 * RESEÑAS E · "Notas del plano"
 * Fondo claro. Al centro se dibuja en línea una casa en obra (la misma
 * geometría de los heros, src/lib/construcciones.ts). Alrededor, cuatro
 * reseñas como notas de un plano, una por tema (atención, surtido, cortes y
 * armex, entregas); cada nota tiene su marca en el dibujo y, al pasar el
 * cursor o enfocar la nota, su marca se resalta.
 *
 * Sin JavaScript o con "reducir movimiento" el dibujo aparece completo.
 *
 * Uso: <ResenasE />
 */
import { escenas, ANCHO_ESCENA, ALTO_ESCENA } from '../../lib/construcciones';
import Button from '../ui/Button.astro';
import Cota from '../ui/Cota.astro';
import Estrellas from './Estrellas.astro';
import AvisoEjemplo from './AvisoEjemplo.astro';
import { resenas5, fichaGoogle, cotaGoogle, temas, type Resena } from './resenas-data';

const casa = escenas.find((e) => e.id === 'casa') ?? escenas[0];

/* Una reseña por tema, con su marca en el dibujo (coordenadas del viewBox). */
const marcas: Record<Resena['tema'], [number, number]> = {
  atencion: [190, 250],
  servicio: [330, 170],
  surtido: [420, 300],
  entrega: [250, 390],
};
const notas = (Object.keys(marcas) as Resena['tema'][])
  .map((t) => resenas5.find((r) => r.tema === t))
  .filter((r): r is Resena => Boolean(r));
const izquierda = notas.filter((_, i) => i % 2 === 0);
const derecha = notas.filter((_, i) => i % 2 === 1);
---

<section id="resenas" data-rse class="rse relative scroll-mt-24 overflow-hidden bg-neutral-100 py-20 text-text-primary lg:py-28">
  <div aria-hidden="true" class="rse-reticula absolute inset-0"></div>

  <div class="container-page relative">
    <div class="flex flex-col items-center text-center">
      <Cota texto={cotaGoogle} class="text-text-brand" />
      <h2 class="mt-5 max-w-[20ch] font-display text-[clamp(2.5rem,5.5vw,4.5rem)] leading-[0.9] font-extrabold uppercase">
        Notas de quienes ya construyeron
      </h2>
      <AvisoEjemplo class="mt-5" />
    </div>

    <div class="mt-12 grid grid-cols-[minmax(0,1fr)] items-center gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)_minmax(0,1fr)]">
      <!-- Dibujo -->
      <figure class="rse-dibujo min-w-0 text-green-800 lg:order-2">
        <svg viewBox={`0 0 ${ANCHO_ESCENA} ${ALTO_ESCENA}`} class="h-auto w-full" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {casa.trazos.map((t) => (
            <path d={t.d} pathLength="1" class={t.tipo === 'cara' ? 'rse-cara' : 'rse-det'} style={`--r:${t.retraso}`} />
          ))}
          {notas.map((r) => {
            const [x, y] = marcas[r.tema];
            return (
              <g data-rse-marca={r.id} class="rse-marca">
                <circle cx={x} cy={y} r="16" class="rse-halo" />
                <rect x={x - 6} y={y - 6} width="12" height="12" transform={`rotate(45 ${x} ${y})`} />
                <text x={x + 14} y={y - 12}>{temas[r.tema]}</text>
              </g>
            );
          })}
        </svg>
      </figure>

      {[izquierda, derecha].map((col, c) => (
        <ul class:list={['grid min-w-0 gap-6', c === 0 ? 'lg:order-1' : 'lg:order-3']}>
          {col.map((r) => (
            <li data-rse-nota={r.id} tabindex="0" class="rse-nota chamfer bg-neutral-0 p-5 [--chamfer:14px]">
              <p class="flex items-center justify-between gap-3">
                <span class="rse-tema">{temas[r.tema]}</span>
                <Estrellas n={r.estrellas} class="text-accent-primary" />
              </p>
              <blockquote class="mt-3 type-body-s text-text-secondary"><p>{r.texto}</p></blockquote>
              <p class="mt-4 type-caption text-text-muted"><b class="font-semibold text-text-primary">{r.nombre}</b>, {r.fuente}, {r.fecha}</p>
            </li>
          ))}
        </ul>
      ))}
    </div>

    <div class="mt-12 flex justify-center">
      <Button href={fichaGoogle.url} target="_blank" variant="primary" size="lg" icon="star" iconPosition="left" label="Ver todas en Google" />
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-rse]');
  if (root) {
    /* El dibujo se traza una vez al aparecer. */
    new IntersectionObserver(([e], o) => {
      if (e.isIntersecting) { root.classList.add('is-trazado'); o.disconnect(); }
    }, { threshold: 0.25 }).observe(root.querySelector('.rse-dibujo')!);

    root.querySelectorAll<HTMLElement>('[data-rse-nota]').forEach((nota) => {
      const marca = root.querySelector(`[data-rse-marca="${nota.dataset.rseNota}"]`);
      const on = (si: boolean) => { marca?.classList.toggle('is-on', si); nota.classList.toggle('is-on', si); };
      nota.addEventListener('pointerenter', () => on(true));
      nota.addEventListener('pointerleave', () => on(false));
      nota.addEventListener('focus', () => on(true));
      nota.addEventListener('blur', () => on(false));
    });
  }
</script>

<style>
  .rse-reticula {
    background-image:
      linear-gradient(to right, rgb(0 74 52 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(0 74 52 / 0.05) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .rse-cara, .rse-det { stroke: currentColor; }
  .rse-cara { stroke-width: 1.3; fill: var(--color-neutral-100); }
  .rse-det { stroke-width: 0.8; opacity: 0.7; }
  :global(html.js) .rse-cara, :global(html.js) .rse-det { stroke-dasharray: 1; stroke-dashoffset: 1; }
  :global(html.js) .rse.is-trazado .rse-cara, :global(html.js) .rse.is-trazado .rse-det {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 900ms cubic-bezier(0.65, 0, 0.35, 1) calc(var(--r) * 0.6s);
  }

  .rse-marca rect { fill: var(--color-accent-primary); stroke: var(--color-neutral-950); stroke-width: 1.5; }
  .rse-marca text { fill: var(--color-neutral-950); font: 700 13px var(--font-sans); stroke: var(--color-neutral-100); stroke-width: 4px; paint-order: stroke; }
  .rse-halo { fill: none; stroke: var(--color-accent-primary); stroke-width: 2; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .rse-marca.is-on .rse-halo { opacity: 1; animation: rse-halo 1.2s ease-out infinite; }
  @keyframes rse-halo { from { transform: scale(0.6); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }

  .rse-nota { box-shadow: inset 0 0 0 1px var(--color-neutral-300); transition: box-shadow 150ms, transform 200ms; cursor: default; }
  .rse-nota.is-on { box-shadow: inset 0 0 0 2px var(--color-green-800); transform: translateY(-2px); }
  .rse-nota:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--color-border-focus); }
  .rse-tema { position: relative; padding-left: 1.1rem; font-size: 0.75rem; font-weight: 700; }
  .rse-tema::before { content: ""; position: absolute; left: 0.15rem; top: 50%; width: 0.55rem; height: 0.55rem; background: var(--color-accent-primary); outline: 1.5px solid var(--color-neutral-950); transform: translateY(-50%) rotate(45deg); }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .rse-cara, :global(html.js) .rse-det { stroke-dashoffset: 0; transition: none; }
    .rse-marca.is-on .rse-halo { animation: none; opacity: 1; }
    .rse-nota { transition: none; }
  }
</style>
