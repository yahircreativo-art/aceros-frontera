---
/**
 * RESEÑAS C · "Dos bandas"
 * Fondo verde de marca. Titular centrado y dos bandas de reseñas que corren
 * en sentidos opuestos, como material en una banda transportadora. Al pasar
 * el cursor o enfocar una tarjeta, la banda se detiene. Las copias que
 * completan el bucle van con aria-hidden para que el lector de pantalla lea
 * cada reseña una sola vez.
 *
 * Con "reducir movimiento" las bandas no corren: se desplazan a mano.
 *
 * Uso: <ResenasC />
 */
import Button from '../ui/Button.astro';
import Cota from '../ui/Cota.astro';
import Estrellas from './Estrellas.astro';
import AvisoEjemplo from './AvisoEjemplo.astro';
import { resenas5, fichaGoogle, cotaGoogle } from './resenas-data';

const mitad = Math.ceil(resenas5.length / 2);
const bandas = [resenas5.slice(0, mitad), resenas5.slice(mitad)];
---

<section id="resenas" class="rsc relative scroll-mt-24 overflow-hidden bg-green-800 py-20 text-text-inverse lg:py-28">
  <div aria-hidden="true" class="pattern-placa absolute inset-0 opacity-[0.06]"></div>

  <div class="container-page relative flex flex-col items-center text-center">
    <Cota texto={cotaGoogle} class="text-text-accent" />
    <h2 class="mt-5 max-w-[18ch] font-display text-[clamp(2.75rem,6vw,5rem)] leading-[0.9] font-extrabold uppercase">
      Obras que salieron bien, contadas por sus dueños
    </h2>
    <AvisoEjemplo class="mt-5" />
  </div>

  <div class="relative mt-14 flex flex-col gap-4">
    {bandas.map((banda, b) => (
      <div class:list={['rsc-banda', { 'rsc-inversa': b === 1 }]}>
        <ul class="rsc-pista" style={`--n:${banda.length}`}>
          {[0, 1].map((copia) =>
            banda.map((r) => (
              <li class="rsc-card chamfer [--chamfer:16px]" aria-hidden={copia === 1 ? 'true' : undefined}>
                <Estrellas n={r.estrellas} class="text-accent-primary" />
                <p class="mt-3 type-body-m">{r.texto}</p>
                <p class="mt-auto pt-5 type-caption text-text-inverse-muted">
                  <b class="font-semibold text-text-inverse">{r.nombre}</b>, {r.fuente}, {r.fecha}
                </p>
              </li>
            )),
          )}
        </ul>
      </div>
    ))}
  </div>

  <div class="container-page relative mt-12 flex justify-center">
    <Button href={fichaGoogle.url} target="_blank" variant="secondary" size="lg" icon="star" iconPosition="left" label="Ver reseñas en Google" />
  </div>
</section>

<style>
  .rsc-banda {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .rsc-pista {
    display: flex; gap: 1rem; width: max-content; padding-block: 0.25rem;
    animation: rsc-corre calc(var(--n) * 9s) linear infinite;
  }
  .rsc-inversa .rsc-pista { animation-direction: reverse; }
  .rsc-banda:hover .rsc-pista, .rsc-banda:focus-within .rsc-pista { animation-play-state: paused; }
  /* Recorre exactamente una copia (mitad de la pista, contando el espacio entre copias). */
  @keyframes rsc-corre { to { transform: translateX(calc(-50% - 0.5rem)); } }

  .rsc-card {
    display: flex; flex-direction: column; width: min(22rem, 80vw); min-height: 13rem; padding: 1.5rem;
    background: var(--color-green-950); text-align: left;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .rsc-pista { animation: none; }
    .rsc-banda { overflow-x: auto; mask-image: none; padding-inline: var(--container-gutter, 1rem); }
    .rsc-pista li[aria-hidden='true'] { display: none; }
  }
</style>
