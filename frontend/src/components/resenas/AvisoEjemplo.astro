---
/**
 * Aviso visible mientras src/data/resenas.ts tenga reseñas de ejemplo.
 * Desaparece solo cuando todas son reales (sin `ejemplo: true`).
 */
import { hayResenasDeEjemplo } from './resenas-data';

interface Props {
  class?: string;
}
const { class: clase = '' } = Astro.props;
---

{hayResenasDeEjemplo && (
  <p class:list={['aviso-ej chamfer inline-flex items-center gap-2 bg-accent-primary px-3 py-1.5 text-xs font-semibold text-text-on-accent [--chamfer:6px]', clase]}>
    Reseñas de ejemplo: cambiar por las reales antes de publicar
  </p>
)}
