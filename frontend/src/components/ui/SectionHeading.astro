---
/**
 * Encabezado de sección (Figma: Eyebrow Body/Overline + Title Heading/H2).
 * `accent` pinta en amarillo la última parte del título, como la referencia.
 */
interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  description?: string;
  tone?: 'light' | 'dark';
  align?: 'left' | 'center';
  class?: string;
  id?: string;
}

const {
  eyebrow,
  title,
  accent,
  description,
  tone = 'light',
  align = 'left',
  class: clase = '',
  id,
} = Astro.props;

const oscuro = tone === 'dark';
---

<div class={`reveal max-w-3xl ${align === 'center' ? 'mx-auto text-center' : ''} ${clase}`}>
  {
    eyebrow && (
      <p class={`flex items-center gap-3 type-overline ${align === 'center' ? 'justify-center' : ''} ${oscuro ? 'text-text-accent' : 'text-text-brand'}`}>
        <span aria-hidden="true" class={`h-0.5 w-10 ${oscuro ? 'bg-accent-primary' : 'bg-brand-primary'}`} />
        {eyebrow}
      </p>
    )}
  <h2
    id={id}
    class={`mt-3 font-display text-4xl leading-[0.95] font-extrabold uppercase sm:text-5xl lg:text-6xl ${oscuro ? 'text-text-inverse' : 'text-text-primary'}`}
  >
    {title}
    {accent && <span class={oscuro ? 'text-text-accent' : 'text-text-brand'}> {accent}</span>}
  </h2>
  {
    description && (
      <p class={`mt-4 type-body-l ${oscuro ? 'text-text-inverse-muted' : 'text-text-secondary'}`}>{description}</p>
    )
  }
  <slot />
</div>
