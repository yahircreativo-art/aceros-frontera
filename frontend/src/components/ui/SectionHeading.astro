---
/**
 * Encabezado de sección con la dirección "plano de taller":
 * titular de un solo color y, si hay un dato real que dar, una <Cota> debajo
 * (en lugar de la etiqueta en mayúsculas de arriba).
 *
 * `accent` se conserva por compatibilidad: se une al título con el mismo color.
 * `eyebrow` ya no se muestra (se dejó de usar la etiqueta sobre el título).
 */
import Cota from './Cota.astro';

interface Props {
  /** @deprecated Ya no se muestra; usa `cota` con un dato real. */
  eyebrow?: string;
  title: string;
  accent?: string;
  /** Dato real y medible bajo el titular, p. ej. "6 sucursales en Tijuana, Mexicali y Ensenada". */
  cota?: string;
  description?: string;
  tone?: 'light' | 'dark';
  align?: 'left' | 'center';
  class?: string;
  id?: string;
}

const { title, accent, cota, description, tone = 'light', align = 'left', class: clase = '', id } = Astro.props;

const oscuro = tone === 'dark';
---

<div class={`reveal max-w-3xl ${align === 'center' ? 'mx-auto text-center' : ''} ${clase}`}>
  <h2
    id={id}
    class={`font-display text-4xl leading-[0.95] font-extrabold uppercase sm:text-5xl lg:text-6xl ${oscuro ? 'text-text-inverse' : 'text-text-primary'}`}
  >
    {accent ? `${title} ${accent}` : title}
  </h2>
  {cota && <Cota texto={cota} class={`mt-4 ${align === 'center' ? 'mx-auto' : ''} ${oscuro ? 'text-text-accent' : 'text-text-brand'}`} />}
  {
    description && (
      <p class={`mt-4 type-body-l ${oscuro ? 'text-text-inverse-muted' : 'text-text-secondary'}`}>{description}</p>
    )
  }
  <slot />
</div>
