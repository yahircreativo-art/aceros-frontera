---
/** Figma: Pictograma/* (32 × 32, trazo de 2 px). Hereda el color con currentColor. */
export type PictogramName =
  | 'viga' | 'angulo' | 'tubos' | 'lamina' | 'varilla'
  | 'malla' | 'placa' | 'tornillo' | 'taladro' | 'herramienta';

interface Props {
  name: PictogramName;
  class?: string;
}

const { name, class: clase = 'size-8' } = Astro.props;

const PATHS: Record<PictogramName, string> = {
  viga: '<path d="M20 6H4V9H10V23H4V26H20V23H14V9H20V6Z"/><path d="M4 6L11 2H27L20 6"/><path d="M27 2V5L20 9"/><path d="M20 23L27 19V22L20 26"/>',
  angulo: '<path d="M6 8V26H24V22H10V8H6Z"/><path d="M6 8L12 3H16L10 8"/><path d="M16 3V17H30"/><path d="M24 22L30 17V21L24 26"/>',
  tubos: '<circle cx="9" cy="22" r="6"/><circle cx="23" cy="22" r="6"/><circle cx="16" cy="10" r="6"/><circle cx="9" cy="22" r="2.5"/><circle cx="23" cy="22" r="2.5"/><circle cx="16" cy="10" r="2.5"/>',
  lamina: '<path d="M2 24H6L9 18H13L16 24H20L23 18H27L30 24"/><path d="M2 14H6L9 8H13L16 14H20L23 8H27L30 14"/><path d="M2 14V24M30 14V24"/>',
  varilla: '<path d="M22 4L4 22L8 26L26 8L22 4Z"/><path d="M9 17L13 21M13 13L17 17M17 9L21 13"/>',
  malla: '<path d="M28 4H4V28H28V4Z"/><path d="M12 4V28M20 4V28M4 12H28M4 20H28"/>',
  placa: '<path d="M17 7L3 14L15 20L29 13L17 7Z"/><path d="M29 13V17L15 24L3 18V14M15 24V20"/><path d="M11 13L14 11.5M16 15L19 13.5M15 10L18 8.5M20 12L23 10.5"/>',
  tornillo: '<path d="M23 3H9V8H23V3Z"/><path d="M13 8V24L16 29L19 24V8"/><path d="M13 12L19 14M13 16L19 18M13 20L19 22"/>',
  taladro: '<path d="M20 7H4V16H20V7Z"/><path d="M20 9H24V14H20"/><path d="M24 11.5H30"/><path d="M8 16V25M15 16V25"/><path d="M17 25H6V29H17V25Z"/>',
  herramienta: '<path d="M29 12H3V27H29V12Z"/><path d="M11 12V7H21V12"/><path d="M3 17H29"/><rect x="14" y="15.5" width="4" height="4" rx="2" fill="currentColor" stroke="none"/>',
};
---

<svg
  viewBox="0 0 32 32"
  class={clase}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={PATHS[name]}
/>
