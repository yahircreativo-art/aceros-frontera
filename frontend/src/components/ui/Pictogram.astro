  aerosol: '<path d="M10 12H20V29H10V12Z"/><path d="M12 8H18V12H12V8Z"/><path d="M15 8V5H19"/><path d="M24 4V4M27 7V7M24 10V10M28 12V12"/>',
  puerta: '<path d="M8 3H24V29H8V3Z"/><path d="M12 7H20V14H12V7Z"/><path d="M12 18H20V25H12"/><path d="M20 16.5V18.5"/>',
