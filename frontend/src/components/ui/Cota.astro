---
/**
 * Cota de plano técnico: línea de medida con remates oblicuos (como en los
 * planos de herrería y obra) y un dato real escrito encima, en minúsculas.
 * Sustituye a la etiqueta en mayúsculas sobre los titulares: en lugar de
 * repetir el nombre de la sección, dice algo medible (cuántas sucursales,
 * en qué ciudades, cuántos pasos…).
 *
 * <Cota texto="6 sucursales en Tijuana, Mexicali y Ensenada" />
 *   ancho: 'texto' (lo que mide el texto) o 'completo' (todo el contenedor).
 *   El color es el del texto (currentColor).
 */
interface Props {
  texto: string;
  ancho?: 'texto' | 'completo';
  class?: string;
}
const { texto, ancho = 'texto', class: clase = '' } = Astro.props;
---

<p class:list={['cota', { 'cota-ajustada': ancho === 'texto' }, clase]}>
  <span class="cota-txt">{texto}</span>
  <span class="cota-linea" aria-hidden="true"></span>
</p>

<style>
  .cota {
    --remate: linear-gradient(135deg, transparent 44%, currentColor 44%, currentColor 56%, transparent 56%);
    display: grid; gap: 0.45rem;
    font-family: var(--font-sans); font-weight: 600; font-size: 0.875rem; line-height: 1.3;
  }
  .cota-ajustada { width: fit-content; }
  .cota-txt { padding-inline: 0.85rem; }

  /* Línea de medida + líneas de referencia verticales + remates a 45° */
  .cota-linea {
    position: relative; height: 11px;
    background:
      var(--remate) left center / 9px 9px no-repeat,
      var(--remate) right center / 9px 9px no-repeat;
  }
  .cota-linea::before { content: ""; position: absolute; inset-inline: 0; top: 50%; height: 1px; background: currentColor; opacity: 0.6; }
  .cota-linea::after {
    content: ""; position: absolute; inset: 0; opacity: 0.6;
    background:
      linear-gradient(currentColor, currentColor) left center / 1px 100% no-repeat,
      linear-gradient(currentColor, currentColor) right center / 1px 100% no-repeat;
  }
</style>
