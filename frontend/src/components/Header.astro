---
/**
 * Figma: Navbar [Type=Tienda]
 * Top Bar (surface/inverse) → Logo · Search Bar[Header] · Button[Secondary, M]
 * Brand Stripe[S] (6 px amarillo)
 * Category Bar (blanco) → enlaces Body/Label · separador · categorías Body/Body-S
 */
import Logo from './Logo.astro';
import Button from './ui/Button.astro';
import HeaderCatalogoDropdown from './HeaderCatalogoDropdown.tsx';
import HeaderSearch from './catalog/HeaderSearch';
import { whatsappUrl } from '../lib/seo';
import { rutaCategoria } from '../lib/categorias';
import type { Producto } from '../lib/types';

interface Props {
  productos: Producto[];
}

const { productos } = Astro.props;
const categorias = [...new Set(productos.map((producto) => producto.Categoria).filter(Boolean))]
  .map((c) => String(c).trim())
  .filter(Boolean)
  .sort((a, b) => a.localeCompare(b, 'es'));

/* Categorías con más productos primero, como accesos rápidos de la barra. */
const conteo = new Map<string, number>();
for (const producto of productos) {
  const categoria = String(producto.Categoria ?? '').trim();
  if (categoria) conteo.set(categoria, (conteo.get(categoria) ?? 0) + 1);
}
const categoriasRapidas = [...conteo.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 7)
  .map(([categoria]) => categoria);

const enlaces = [
  { href: '/#nosotros', label: 'Nosotros' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/sucursales', label: 'Sucursales' },
  { href: '/#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-40 bg-surface-primary shadow-header">
  <div class="brand-stripe bg-surface-inverse">
    <div class="container-page flex flex-wrap items-center justify-between gap-x-8 gap-y-3 py-4 md:flex-nowrap">
      <Logo />

      <HeaderSearch productos={productos} client:load />

      <div class="hidden shrink-0 md:block">
        <Button
          href={whatsappUrl()}
          target="_blank"
          variant="secondary"
          size="md"
          icon="whatsapp"
          iconPosition="right"
          label="Cotizar"
        />
      </div>
    </div>
  </div>

  <nav
    aria-label="Navegación secundaria"
    class="container-page flex h-[2.875rem] items-center gap-6 overflow-x-auto whitespace-nowrap [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    <HeaderCatalogoDropdown categorias={categorias} client:only="react" />
    {
      enlaces.map((enlace) => (
        <a
          class="shrink-0 type-label text-text-primary transition-colors hover:text-text-brand"
          href={enlace.href}
        >
          {enlace.label}
        </a>
      ))
    }
    {
      categoriasRapidas.length > 0 && (
        <>
          <span aria-hidden="true" class="h-5 w-px shrink-0 bg-border-default" />
          {categoriasRapidas.map((categoria) => (
            <a
              class="shrink-0 type-body-s text-text-secondary transition-colors hover:text-text-brand"
              href={rutaCategoria(categoria, categorias)}
            >
              {categoria}
            </a>
          ))}
        </>
      )
    }
  </nav>
</header>
