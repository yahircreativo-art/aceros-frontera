---
/**
 * Navbar en una sola barra oscura:
 * Logo · secciones principales (Catálogo ▾ abre el mega menú) · buscador
 * compacto · botón Cotizar. Debajo, la franja amarilla de marca.
 * En pantallas chicas las secciones pasan a un menú desplegable (☰) y el
 * buscador ocupa su propia fila.
 */
import Logo from './Logo.astro';
import Button from './ui/Button.astro';
import MegaMenu from './MegaMenu.astro';
import HeaderSearch from './catalog/HeaderSearch';
import { whatsappUrl } from '../lib/seo';
import { rutaInterna } from '../lib/asset-url';
import type { Producto } from '../lib/types';

interface Props {
  productos: Producto[];
}

const { productos } = Astro.props;
const categorias = [...new Set(productos.map((producto) => producto.Categoria).filter(Boolean))]
  .map((c) => String(c).trim())
  .filter(Boolean)
  .sort((a, b) => a.localeCompare(b, 'es'));

const enlaces = [
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/sucursales', label: 'Sucursales' },
  { href: '/contacto', label: 'Contacto' },
];
const enlace = 'shrink-0 type-label text-text-inverse transition-colors hover:text-text-accent';
---

<header class="sticky top-0 z-40 brand-stripe bg-surface-inverse shadow-header">
  <div class="container-page flex flex-wrap items-center gap-x-8 gap-y-3 py-3 lg:flex-nowrap">
    <Logo />

    <!-- Secciones principales (escritorio) -->
    <nav aria-label="Navegación principal" class="hidden items-center gap-6 lg:flex xl:gap-8">
      <button
        type="button"
        data-mega-trigger
        aria-expanded="false"
        aria-controls="mega-menu"
        class={`group inline-flex cursor-pointer items-center gap-1.5 ${enlace} aria-expanded:text-text-accent`}
      >
        Catálogo
        <svg viewBox="0 0 10 6" class="h-1.5 w-2.5 transition-transform group-aria-expanded:rotate-180" fill="none" aria-hidden="true">
          <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      {enlaces.map((e) => <a class={enlace} href={rutaInterna(e.href)}>{e.label}</a>)}
    </nav>

    <div class="ml-auto flex items-center gap-3 lg:order-last lg:ml-0">
      <div class="hidden shrink-0 md:block">
        <Button
          href={whatsappUrl()}
          target="_blank"
          variant="secondary"
          size="md"
          icon="whatsapp"
          iconPosition="right"
          label="Cotizar"
        />
      </div>

      <!-- Menú (celular y tableta) -->
      <button
        type="button"
        data-menu-movil-boton
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
        class="grid size-11 cursor-pointer place-items-center text-text-inverse hover:text-text-accent lg:hidden"
      >
        <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path data-icono-abrir d="M4 7h16M4 12h16M4 17h16" />
          <path data-icono-cerrar d="M6 6l12 12M18 6L6 18" class="hidden" />
        </svg>
      </button>
    </div>

    <!-- Buscador: fila propia en celular, compacto en escritorio -->
    <div class="order-last w-full lg:order-none lg:ml-auto lg:w-64 lg:shrink-0 xl:w-72">
      <HeaderSearch productos={productos} client:load />
    </div>
  </div>

  <nav
    id="menu-movil"
    data-menu-movil
    aria-label="Navegación principal"
    hidden
    class="absolute inset-x-0 top-[calc(100%+6px)] z-50 max-h-[calc(100svh-8rem)] overflow-y-auto bg-surface-inverse shadow-modal lg:hidden"
  >
    <ul class="container-page flex flex-col py-2">
      {
        [{ href: '/catalogo', label: 'Catálogo' }, ...enlaces].map((e) => (
          <li class="border-b border-white/10 last:border-0">
            <a
              href={rutaInterna(e.href)}
              class="flex items-center justify-between py-4 type-h4 text-text-inverse hover:text-text-accent"
            >
              {e.label}
              <span aria-hidden="true" class="text-text-accent">›</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <MegaMenu categorias={categorias} />
</header>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-movil-boton]');
  const menu = document.querySelector<HTMLElement>('[data-menu-movil]');

  if (boton && menu) {
    const alternar = (abrir: boolean) => {
      menu.hidden = !abrir;
      boton.setAttribute('aria-expanded', String(abrir));
      boton.setAttribute('aria-label', abrir ? 'Cerrar menú' : 'Abrir menú');
      boton.querySelector('[data-icono-abrir]')?.classList.toggle('hidden', abrir);
      boton.querySelector('[data-icono-cerrar]')?.classList.toggle('hidden', !abrir);
    };

    boton.addEventListener('click', () => alternar(menu.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        alternar(false);
        boton.focus();
      }
    });
    document.addEventListener('mousedown', (e) => {
      const objetivo = e.target as Node;
      if (!menu.hidden && !menu.contains(objetivo) && !boton.contains(objetivo)) alternar(false);
    });
    /* Al pasar a escritorio el menú móvil deja de tener sentido. */
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && alternar(false));
  }
</script>
