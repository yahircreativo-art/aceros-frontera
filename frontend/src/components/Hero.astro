---
import { assetUrl } from '../lib/asset-url';
import Button from './ui/Button.astro';
---

<section
  id="inicio"
  class="relative isolate overflow-hidden bg-brand-950"
  data-hide-on-product-detail
>
  {/* Imagen de fondo LCP: usa <img> real para que el navegador la descubra en el HTML
      y aplicarle fetchpriority="high". Posicionada como fondo con object-fit. */}
  <img
    src={assetUrl('/images/hero-bg.webp')}
    alt=""
    fetchpriority="high"
    loading="eager"
    decoding="async"
    style="aspect-ratio: 1920 / 1080"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-black/80 via-black/35 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative flex min-h-[620px] flex-col justify-center py-20 sm:min-h-[720px] lg:min-h-[720px] xl:min-h-[800px] lg:py-28">
    <div class="max-w-2xl">

      <h1
        class="mt-6 text-display text-white"
        style="text-shadow: 0 2px 4px rgb(0 0 0 / 95%), 0 6px 16px rgb(0 0 0 / 85%)"
      >
        EL ACERO QUE TU PROYECTO NECESITA
      </h1>

      <p
        class="mt-6 max-w-xl text-lg text-white"
        style="text-shadow: 0 2px 4px rgb(0 0 0 / 95%), 0 5px 12px rgb(0 0 0 / 80%)"
      >
        En Aceros Frontera encuentras perfiles, alambrón, malla y materiales de acero para
        construcción, fabricación y mantenimiento. Atención local en Tijuana, Baja California.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button
          href="#formulario-cotizacion"
          variant="secondary"
          size="lg"
          icon="arrow-right"
          iconPosition="right"
          label="Solicitar cotización"
          className="shadow-lg shadow-black/10"
        />
        <Button
          href="/catalogo"
          variant="primary"
          size="lg"
          icon="arrow-right"
          iconPosition="right"
          label="Explorar catálogo"
          className="shadow-lg shadow-black/10"
        />
      </div>

      
    </div>
  </div>
</section>
