---
/**
 * Figma: "Mega Menu" — se despliega desde "Catálogo" en la barra del header.
 * Panel negro (hasta 1200 px, centrado) con las familias de producto
 * (pictograma amarillo, título blanco, enlaces gris claro) y el enlace
 * "Ver catálogo completo". Debajo, las categorías reales del catálogo.
 * Se despliega con animación (ver <style> al final).
 *
 * Uso: <MegaMenu> va dentro del <header> (que es el contenedor posicionado)
 * y su botón disparador se pinta con el slot "trigger" en la barra de enlaces.
 */
import { rutaInterna } from '../lib/asset-url';
import { rutaCategoria } from '../lib/categorias';
import { familias, rutaFamilia } from '../data/familias';
import Pictogram from './ui/Pictogram.astro';

interface Props {
  categorias: string[];
}

const { categorias } = Astro.props;
---

<div
  id="mega-menu"
  data-mega-menu
  hidden
  class="absolute inset-x-0 top-[calc(100%+4px)] max-w-[1200px] mx-auto z-50 max-h-[calc(100svh-8rem)] overflow-y-auto bg-surface-inverse shadow-modal ring-1 ring-white/10"
>
  <div class="container-page flex flex-col gap-10 pb-12 pt-10 lg:flex-row lg:gap-12">
    <div class="min-w-0 flex-1">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-3 xl:grid-cols-4">
        {
          familias.map((familia, indice) => {
            const href = rutaInterna(rutaFamilia(familia, categorias));
            return (
              <li class="mega-item flex flex-col gap-2" style={`--i: ${indice}`}>
                <a href={href} class="group flex flex-col gap-2">
                  <Pictogram name={familia.icono} class="size-8 text-accent-primary transition-transform group-hover:-translate-y-0.5" />
                  <span class="type-h4 text-text-inverse transition-colors group-hover:text-accent-primary">
                    {familia.titulo}
                  </span>
                </a>
                <ul class="flex flex-col gap-2">
                  {familia.items.map((item) => (
                    <li>
                      <a href={href} class="type-body-s text-text-inverse-muted transition-colors hover:text-text-inverse">
                        {item}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            );
          })
        }
        <li class="mega-item flex items-start pt-2" style={`--i: ${familias.length}`}>
          <a
            href={rutaInterna('/catalogo')}
            class="inline-flex items-center gap-2 type-button-m text-accent-primary transition-colors hover:text-accent-hover"
          >
            <svg viewBox="0 0 12 12" class="size-3" aria-hidden="true"><path d="M3 2l6 4-6 4z" fill="currentColor" /></svg>
            Ver catálogo completo
          </a>
        </li>
      </ul>

      {
        categorias.length > 0 && (
          <div class="mega-item mt-10 border-t border-white/10 pt-6" style={`--i: ${familias.length + 1}`}>
            <p class="type-overline text-text-inverse-muted">Catálogo en línea</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {categorias.map((categoria) => (
                <li>
                  <a
                    href={rutaInterna(rutaCategoria(categoria, categorias))}
                    class="inline-flex bg-white/5 px-3 py-1.5 type-label text-text-inverse ring-1 ring-white/10 transition-colors ring-inset hover:bg-accent-primary hover:text-text-on-accent hover:ring-accent-primary"
                  >
                    {categoria}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</div>

<script>
  /* Abre y cierra solo con clic (o teclado) en "Catálogo"; también cierra
     con Escape, con clic fuera del menú o al salir de él con el tabulador. */
  const menu = document.querySelector<HTMLElement>('[data-mega-menu]');
  const trigger = document.querySelector<HTMLButtonElement>('[data-mega-trigger]');

  if (menu && trigger) {
    let ocultar: number | undefined;
    const DURACION_CIERRE = 180; // igual que la animación mega-cerrar

    const abrir = () => {
      window.clearTimeout(ocultar);
      menu.classList.remove('cerrando');
      menu.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
    };
    const cerrar = () => {
      if (menu.hidden) return;
      trigger.setAttribute('aria-expanded', 'false');
      /* Deja correr la animación de salida antes de ocultarlo. */
      menu.classList.add('cerrando');
      window.clearTimeout(ocultar);
      ocultar = window.setTimeout(() => {
        menu.hidden = true;
        menu.classList.remove('cerrando');
      }, DURACION_CIERRE);
    };
    trigger.addEventListener('click', () =>
      menu.hidden || menu.classList.contains('cerrando') ? abrir() : cerrar(),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        cerrar();
        trigger.focus();
      }
    });
    document.addEventListener('mousedown', (e) => {
      const objetivo = e.target as Node;
      if (!menu.hidden && !menu.contains(objetivo) && !trigger.contains(objetivo)) cerrar();
    });
    menu.addEventListener('focusout', (e) => {
      const siguiente = e.relatedTarget as Node | null;
      if (siguiente && !menu.contains(siguiente) && siguiente !== trigger) cerrar();
    });
  }
</script>

<style>
  /* Apertura: el panel se despliega hacia abajo desde la franja amarilla y
     sus bloques aparecen escalonados. */
  [data-mega-menu]:not([hidden]) {
    animation: mega-abrir 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  [data-mega-menu]:not([hidden]) .mega-item {
    animation: mega-item 360ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(80ms + var(--i, 0) * 30ms);
  }

  /* Cierre: se recoge rápido hacia arriba. */
  [data-mega-menu].cerrando {
    animation: mega-cerrar 180ms ease-in both;
  }
  [data-mega-menu].cerrando .mega-item {
    animation: none;
  }

  @keyframes mega-abrir {
    from {
      opacity: 0;
      transform: translateY(-8px);
      clip-path: inset(0 -60px 100% -60px);
    }
    to {
      opacity: 1;
      transform: none;
      /* Margen negativo para no recortar la sombra del panel. */
      clip-path: inset(0 -60px -60px -60px);
    }
  }
  @keyframes mega-item {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes mega-cerrar {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-mega-menu],
    [data-mega-menu] .mega-item {
      animation: none !important;
    }
  }
</style>
