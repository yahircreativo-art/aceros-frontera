---
/**
 * Figma: "Mega Menu" — se despliega desde "Catálogo" en la barra del header.
 * Panel blanco (padding 40/64/48/64, sombra) con las familias de producto
 * (pictograma verde, título Heading/H4, enlaces Body/Body-S), enlace
 * "Ver catálogo completo" y mosaico amarillo "¿No encuentras lo que buscas?".
 * Debajo, las categorías reales del catálogo en línea.
 *
 * Uso: <MegaMenu> va dentro del <header> (que es el contenedor posicionado)
 * y su botón disparador se pinta con el slot "trigger" en la barra de enlaces.
 */
import { rutaInterna } from '../lib/asset-url';
import { rutaCategoria } from '../lib/categorias';
import { familias, rutaFamilia } from '../data/familias';
import Pictogram from './ui/Pictogram.astro';

interface Props {
  categorias: string[];
}

const { categorias } = Astro.props;
---

<!--
  El contenedor exterior solo posiciona el menú bajo la franja amarilla y es
  transparente a los clics; el panel visible no pasa del ancho máximo de la
  navbar (container-page) y lleva padding interno.
-->
<div
  id="mega-menu"
  data-mega-menu
  hidden
  class="pointer-events-none absolute inset-x-0 top-[calc(100%+6px)] z-50"
>
  <div class="container-page">
    <div
      class="mega-panel pointer-events-auto max-h-[calc(100svh-8rem)] overflow-y-auto bg-surface-inverse px-6 py-6 shadow-modal ring-1 ring-white/10 sm:px-8 lg:px-10 lg:py-8"
    >
      <ul class="grid grid-cols-2 gap-x-6 gap-y-6 md:grid-cols-4">
        {
          familias.map((familia, indice) => {
            const href = rutaInterna(rutaFamilia(familia, categorias));
            return (
              <li class="mega-item flex flex-col gap-2" style={`--i: ${indice}`}>
                <a href={href} class="group flex items-center gap-2">
                  <Pictogram name={familia.icono} class="size-6 shrink-0 text-accent-400" />
                  <span class="type-label text-text-inverse transition-colors group-hover:text-accent-400">
                    {familia.titulo}
                  </span>
                </a>
                <ul class="flex flex-col gap-1.5 pl-8">
                  {familia.items.map((item) => (
                    <li>
                      <a href={href} class="type-body-s text-text-inverse-muted transition-colors hover:text-accent-400">
                        {item}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            );
          })
        }
        <li class="mega-item flex items-start" style={`--i: ${familias.length}`}>
          <a
            href={rutaInterna('/catalogo')}
            class="inline-flex items-center gap-2 type-button-s text-accent-400 transition-colors hover:text-accent-hover"
          >
            <svg viewBox="0 0 12 12" class="size-2.5" aria-hidden="true"><path d="M3 2l6 4-6 4z" fill="currentColor" /></svg>
            Ver catálogo completo
          </a>
        </li>
      </ul>

      {
        categorias.length > 0 && (
          <div class="mt-6 border-t border-white/10 pt-5">
            <p class="type-overline text-text-inverse-muted">Catálogo en línea</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {categorias.map((categoria) => (
                <li>
                  <a
                    href={rutaInterna(rutaCategoria(categoria, categorias))}
                    class="inline-flex rounded-xs bg-white/10 px-2.5 py-1 type-caption text-text-inverse transition-colors hover:bg-accent-primary hover:text-text-on-accent"
                  >
                    {categoria}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</div>

<script>
  /* Abre con clic, con el cursor (en pantallas con puntero) y con teclado;
     cierra con Escape, clic fuera o al salir del menú. */
  const menu = document.querySelector<HTMLElement>('[data-mega-menu]');
  const trigger = document.querySelector<HTMLButtonElement>('[data-mega-trigger]');

  if (menu && trigger) {
    let cierre: number | undefined;
    const conPuntero = window.matchMedia('(hover: hover) and (pointer: fine)');

    let ocultar: number | undefined;
    const DURACION_CIERRE = 180; // igual que la animación mega-cerrar

    const abrir = () => {
      window.clearTimeout(cierre);
      window.clearTimeout(ocultar);
      menu.classList.remove('cerrando');
      menu.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
    };
    const cerrar = () => {
      window.clearTimeout(cierre);
      if (menu.hidden) return;
      trigger.setAttribute('aria-expanded', 'false');
      /* Deja correr la animación de salida antes de ocultarlo. */
      menu.classList.add('cerrando');
      window.clearTimeout(ocultar);
      ocultar = window.setTimeout(() => {
        menu.hidden = true;
        menu.classList.remove('cerrando');
      }, DURACION_CIERRE);
    };
    const programarCierre = () => {
      window.clearTimeout(cierre);
      cierre = window.setTimeout(cerrar, 200);
    };

    trigger.addEventListener('click', () =>
      menu.hidden || menu.classList.contains('cerrando') ? abrir() : cerrar(),
    );
    for (const el of [trigger, menu]) {
      el.addEventListener('mouseenter', () => conPuntero.matches && abrir());
      el.addEventListener('mouseleave', () => conPuntero.matches && programarCierre());
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        cerrar();
        trigger.focus();
      }
    });
    document.addEventListener('mousedown', (e) => {
      const objetivo = e.target as Node;
      if (!menu.hidden && !menu.contains(objetivo) && !trigger.contains(objetivo)) cerrar();
    });
    menu.addEventListener('focusout', (e) => {
      const siguiente = e.relatedTarget as Node | null;
      if (siguiente && !menu.contains(siguiente) && siguiente !== trigger) cerrar();
    });
  }
</script>

<style>
  /* Apertura: el panel se despliega hacia abajo desde la franja amarilla y
     las familias aparecen escalonadas. */
  [data-mega-menu]:not([hidden]) .mega-panel {
    animation: mega-abrir 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  [data-mega-menu]:not([hidden]) .mega-item {
    animation: mega-item 360ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(80ms + var(--i, 0) * 30ms);
  }

  /* Cierre: se recoge rápido hacia arriba. */
  [data-mega-menu].cerrando .mega-panel {
    animation: mega-cerrar 180ms ease-in both;
  }
  [data-mega-menu].cerrando .mega-item {
    animation: none;
  }

  @keyframes mega-abrir {
    from {
      opacity: 0;
      transform: translateY(-8px);
      clip-path: inset(0 -60px 100% -60px);
    }
    to {
      opacity: 1;
      transform: none;
      /* Margen negativo para no recortar la sombra del panel. */
      clip-path: inset(0 -60px -60px -60px);
    }
  }
  @keyframes mega-item {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes mega-cerrar {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-mega-menu] .mega-panel,
    [data-mega-menu] .mega-item {
      animation: none !important;
    }
  }
</style>
