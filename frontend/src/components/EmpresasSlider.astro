---
import { obtenerEmpresasAliadas } from "../lib/empresas";
import { assetUrl } from "../lib/asset-url";

/* Respaldo en cuatro columnas, debajo del titular (mismo acomodo que la referencia). */
const beneficios = [
  {
    icono: "shield-check",
    titulo: "Marcas certificadas",
    descripcion: "Distribuidores autorizados con respaldo directo de fábrica.",
  },
  {
    icono: "truck",
    titulo: "Entrega oportuna",
    descripcion: "Material listo para salir a obra sin demoras.",
  },
  {
    icono: "building",
    titulo: "Cobertura regional",
    descripcion: "Tijuana, Ensenada y Mexicali con inventario local.",
  },
  {
    icono: "clock",
    titulo: "Atención el mismo día",
    descripcion: "Cotizaciones y surtido en horario extendido.",
  },
];

const empresas = obtenerEmpresasAliadas();
// En producción la sección se oculta si aún no hay logos; en desarrollo se muestra la ayuda.
const mostrar = empresas.length > 0 || import.meta.env.DEV;

// Repetimos los logos para que el recorrido no tenga huecos ni saltos visibles.
const copias = empresas.length >= 8 ? 2 : empresas.length >= 4 ? 3 : 6;
const logos = Array.from({ length: copias }, () => empresas).flat();
const desplazamiento = `-${(100 / copias).toFixed(4)}%`;
const duracion = `${Math.max(24, empresas.length * 5)}s`;
---

{
  mostrar && (
    <section
      id="aliados"
      class="scroll-mt-44 lg:scroll-mt-28 bg-white py-12"
      data-hide-on-product-detail
    >
      <div class="container-page flex flex-col">
        {empresas.length > 0 ? (
          <div
            class="aliados-carrusel relative mt-8 w-full overflow-hidden"
            style={`--aliados-desplazamiento: ${desplazamiento}; --aliados-duracion: ${duracion};`}
          >
            <ul
              class="aliados-pista flex w-max items-stretch"
              aria-label="Empresas aliadas"
            >
              {logos.map((empresa, indice) => (
                <li
                  class="w-40 shrink-0 px-2 sm:w-48 lg:w-52"
                  aria-hidden={indice >= empresas.length ? "true" : undefined}
                >
                  <div class="group flex h-24 items-center justify-center p-4 transition-all duration-200 hover:-translate-y-0.5 cursor-pointer">
                    <img
                      src={empresa.imagen}
                      alt={indice < empresas.length ? empresa.nombre : ""}
                      loading="lazy"
                      decoding="async"
                      class="max-h-24 w-full object-contain transition duration-300 group-hover:opacity-100 group-hover:grayscale-0"
                    />
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <p class="mt-8 rounded-card border border-dashed border-ink-300 bg-ink-50/60 p-8 text-center text-sm text-ink-500">
            Aún no hay logos. Coloca las imágenes en{" "}
            <code class="font-mono text-xs text-ink-700">
              public/images/empresas
            </code>{" "}
            (png, jpg, webp, avif o svg) y aparecerán aquí automáticamente.
          </p>
        )}

        <div class="max-w-3xl">
          <p class="text-2xs font-bold uppercase tracking-[0.18em] text-brand-600">
            Empresas aliadas
          </p>
          <h2 class="mt-2 font-display text-3xl font-bold text-ink-900 sm:text-4xl">
            Marcas y proveedores que nos respaldan
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-600">
            Trabajamos de la mano con fabricantes y distribuidores líderes para
            garantizar material certificado y entrega oportuna en cada proyecto.
          </p>
        </div>

        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" role="list">
          {beneficios.map((beneficio) => (
            <li>
              <svg class="size-5 text-ink-700" aria-hidden="true">
                <use href={`${assetUrl("/icons.svg")}#${beneficio.icono}`}></use>
              </svg>
              <h3 class="mt-3 text-sm font-bold text-ink-900">
                {beneficio.titulo}
              </h3>
              <p class="mt-1 text-xs leading-relaxed text-ink-600">
                {beneficio.descripcion}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .aliados-pista {
    animation: aliados-loop var(--aliados-duracion, 40s) linear infinite;
    will-change: transform;
  }

  .aliados-carrusel {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 5%,
      black 95%,
      transparent
    );
  }

  /* Se detiene al pasar el cursor para poder ver los logos con calma */
  .aliados-carrusel:hover .aliados-pista,
  .aliados-carrusel:focus-within .aliados-pista {
    animation-play-state: paused;
  }

  @keyframes aliados-loop {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(var(--aliados-desplazamiento, -50%), 0, 0);
    }
  }

  /* Accesibilidad: sin movimiento automático si el usuario lo prefiere */
  @media (prefers-reduced-motion: reduce) {
    .aliados-carrusel {
      overflow-x: auto;
      mask-image: none;
    }

    .aliados-pista {
      animation: none;
    }
  }
</style>
