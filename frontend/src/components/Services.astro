---
import { siteSeo } from "../lib/seo";
import { assetUrl } from "../lib/asset-url";

interface Servicio {
  id: string;
  titulo: string;
  descripcion: string;
  /** Foto en `public/images`. Sin imagen se muestra el placeholder de marca. */
  imagen?: string;
}

// Los id son anclas públicas (#servicio): no cambiarlos sin revisar los enlaces.
const servicios: Servicio[] = [
  {
    id: "venta-y-distribucion",
    titulo: "Venta y distribución de acero en Baja California",
    descripcion:
      "Con más de 5 sucursales y distintos centros de distribución ubicados estratégicamente. Proveemos acero al estado completo de Baja California.",
    imagen: assetUrl("/images/dsc06636.webp"),
  },
  {
    id: "productos-a-la-medida",
    titulo: "Productos a la medida",
    descripcion:
      "Somos fabricantes de ARMEX, anillos para castillos, lamina para techo R-72, lamina steel deck, entre otros. Además ofrecemos servicios como corte de placa.",
    imagen: assetUrl("/images/dsc06679.webp"),
  },
  {
    id: "venta-de-pintura",
    titulo: "Venta de pintura",
    descripcion:
      "Contamos con las mejores marcas de pintura en distintas presentaciones.",
    imagen: assetUrl("/images/dsc06771.webp"),
  },
  {
    id: "fabricacion-de-armex",
    titulo: "Fabricación de ARMEX, castillos y anillos",
    descripcion: "Somos fabricantes de ARMEX y anillos para castillos.",
    imagen: assetUrl("/images/dsc06588.webp"),
  },
  {
    id: "corte-de-placa",
    titulo: "Corte de placa",
    descripcion:
      "Ofrecemos corte de placa de aceros A36 en distintos grosores como 3/16″, 1/4″, 5/16″, 3/8″, 1/2″, 5/8″, 3/4″ y 1″",
    imagen: assetUrl("/images/dsc06752.webp"),
  },
  {
    id: "venta-y-servicio-de-herramienta",
    titulo: "Venta y servicio de herramienta",
    descripcion:
      "Contamos con venta y servicio de reparación de maquinaria de las mejores marcas. Somos centro de servicio autorizado de Makita, Bosch y Lincoln Electric.",
    imagen: assetUrl("/images/dsc06784.webp"),
  },
];

---

<section
  id="servicios"
  class="scroll-mt-44 lg:scroll-mt-28 border-t border-line bg-canvas py-16 lg:py-20"
  data-hide-on-product-detail
>
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="text-2xs font-bold uppercase tracking-[0.18em] text-brand-600">
        Nuestros Servicios
      </p>
      <h2 class="mt-2 font-display text-3xl font-bold text-ink-900 sm:text-4xl">
        Soluciones en acero y materiales para cada proyecto
      </h2>
      <p class="mt-4 text-base leading-relaxed text-ink-600">
        En Aceros Frontera no solo proveemos material de primera calidad:
        ponemos a tu disposición servicios especializados para optimizar tus
        tiempos, reducir mermas y garantizar la resistencia de tus obras.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        servicios.map((servicio) => {
          const mensajeWhatsapp = `Hola, quiero cotizar y solicitar información sobre el servicio de ${servicio.titulo}.`;
          const urlWhatsapp = `https://wa.me/${siteSeo.whatsapp}?text=${encodeURIComponent(mensajeWhatsapp)}`;

          return (
            <a
              id={servicio.id}
              href={urlWhatsapp}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Solicitar cotización de ${servicio.titulo} por WhatsApp`}
              class="group relative flex aspect-[3/4] scroll-mt-44 flex-col justify-end overflow-hidden bg-ink-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-400 lg:scroll-mt-32"
            >
              {servicio.imagen ? (
                <img
                  src={servicio.imagen}
                  alt={servicio.titulo}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              ) : (
                /* Sin imagen propia: fondo con la marca, como el placeholder de productos. */
                <span
                  aria-hidden="true"
                  class="absolute inset-0 grid place-items-center bg-ink-100 px-4 text-center"
                >
                  <span class="font-display text-sm font-bold uppercase tracking-[0.14em] text-ink-400">
                    Aceros Frontera
                  </span>
                </span>
              )}

              {/* Con foto el degradado queda fijo para que el texto se lea. */}
              {servicio.imagen ? (
                <span
                  aria-hidden="true"
                  class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent"
                >
                </span>
              ) : null}

              {/* Hover: degradado de negro abajo a transparente arriba. */}
              <span
                aria-hidden="true"
                class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
              >
              </span>

              <div class="relative z-[1] my-auto p-5 text-center">
                <h3
                  class={`font-display text-2xl font-bold uppercase leading-tight tracking-wide transition-colors duration-300 group-hover:text-white ${servicio.imagen ? "text-white" : "text-ink-900"}`}
                >
                  {servicio.titulo}
                </h3>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
