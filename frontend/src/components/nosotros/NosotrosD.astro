---
/**
 * NOSOTROS D · "Banner + sucursales" (ref. Buffer)
 * 1) Banner verde que empieza como tarjeta redondeada y se expande a todo
 *    lo ancho conforme haces scroll; la foto de adentro se aleja (zoom out)
 *    y el personaje saluda desde un círculo.
 * 2) "Un equipo cerca de ti": tarjetas de colores por sucursal con filtros
 *    por ciudad. Al filtrar, las tarjetas se reacomodan deslizándose (FLIP).
 */
import { textos, fotos, enlaces, sucursales, ciudades } from './nosotros-data';
import SectionTag from '../ui/SectionTag.astro';
import { assetUrl } from '../../lib/asset-url';

const colores = ['nod-c1', 'nod-c2', 'nod-c3', 'nod-c4'];
---

<section id="nosotros" data-nod class="nod scroll-mt-28 bg-neutral-100 pb-20 lg:pb-28">
  <!-- Banner -->
  <div data-nod-banner class="nod-banner-wrap pt-6 lg:pt-10">
    <div class="nod-banner relative mx-auto overflow-hidden bg-green-900 text-text-inverse">
      <div class="container-page grid items-center gap-10 py-14 lg:grid-cols-[1fr_1.1fr] lg:py-16">
        <div>
          <SectionTag label={textos.eyebrow} color="amarillo" />
          <h2 class="mt-6 flex flex-wrap items-center gap-x-4 font-display text-[clamp(3rem,7vw,6rem)] leading-[0.9] font-extrabold uppercase">
            Somos Aceros Frontera
            <span class="nod-saludo inline-grid size-[0.95em] place-items-center overflow-hidden rounded-full bg-accent-primary" aria-hidden="true">
              <img src={fotos.personaje} alt="" class="mt-[45%] w-[120%] max-w-none" loading="lazy" />
            </span>
          </h2>
          <p class="mt-6 max-w-lg type-body-l text-text-inverse-muted">{textos.parrafo}</p>
        </div>
        <div class="nod-foto relative aspect-[4/3] overflow-hidden rounded-2xl">
          <img src={fotos.sucursal} alt="Sucursal de Aceros Frontera" loading="lazy" decoding="async" class="size-full object-cover" />
        </div>
      </div>
    </div>
  </div>

  <!-- Sucursales -->
  <div class="container-page mt-20 lg:mt-28">
    <div class="mx-auto max-w-2xl text-center">
      <h3 class="type-h2">Un equipo <span class="text-text-brand">cerca de ti</span></h3>
      <p class="mt-4 type-body-m text-text-secondary">
        Personal de mostrador, almacén y reparto que conoce el acero, en {sucursales.length} sucursales de {ciudades.join(', ')}.
      </p>
    </div>

    <div role="group" aria-label="Filtrar por ciudad" class="mt-8 flex flex-wrap justify-center gap-2">
      {['Todas', ...ciudades].map((c, i) => (
        <button type="button" data-nod-filtro={i === 0 ? '*' : c} aria-pressed={i === 0 ? 'true' : 'false'} class="nod-chip">{c}</button>
      ))}
    </div>

    <ul data-nod-grid class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        sucursales.map((s, i) => (
          <li data-nod-card data-ciudad={s.ciudad} class:list={['nod-card', colores[i % colores.length]]} style={`--i:${i}`}>
            <div class="flex items-start justify-between gap-3">
              <span class="nod-pin grid size-11 place-items-center rounded-full">
                <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"><use href={`${assetUrl('/icons.svg')}#pin`} /></svg>
              </span>
              <span class="rounded-full bg-white/70 px-3 py-1 type-caption">{s.ciudad}</span>
            </div>
            <p class="mt-8 font-display text-3xl leading-none font-bold">{s.nombre.replace('Sucursal ', '')}</p>
            <p class="mt-2 type-body-s opacity-80">{s.direccion}, {s.colonia}</p>
            <div class="mt-6 flex items-center justify-between gap-3 border-t border-black/10 pt-4">
              <a href={`tel:${s.telefonos[0]?.replace(/\D/g, '')}`} class="type-label hover:underline">{s.telefonos[0]}</a>
              <a href={s.mapaUrl} target="_blank" rel="noopener noreferrer" class="nod-ir type-button-s">Cómo llegar <span aria-hidden="true">↗</span></a>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 text-center">
      <a href={enlaces.sucursales} class="type-button-m underline decoration-accent-primary decoration-4 underline-offset-8 hover:text-text-brand">Ver todas las sucursales</a>
    </div>
  </div>
</section>

<script>
  import { alAparecer, progresoScroll } from '../../lib/scroll-progreso';

  const sec = document.querySelector<HTMLElement>('[data-nod]');
  if (sec) {
    progresoScroll(sec.querySelector<HTMLElement>('[data-nod-banner]')!, 'entrada');
    const grid = sec.querySelector<HTMLElement>('[data-nod-grid]')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-nod-card]')];
    alAparecer([grid], 0.15);

    /* Filtro con reacomodo animado (FLIP) */
    const filtros = [...sec.querySelectorAll<HTMLButtonElement>('[data-nod-filtro]')];
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    filtros.forEach((f) =>
      f.addEventListener('click', () => {
        filtros.forEach((x) => x.setAttribute('aria-pressed', String(x === f)));
        const ciudad = f.dataset.nodFiltro!;
        const antes = new Map(cards.filter((c) => !c.hidden).map((c) => [c, c.getBoundingClientRect()]));
        cards.forEach((c) => (c.hidden = ciudad !== '*' && c.dataset.ciudad !== ciudad));
        if (quieto) return;
        cards.forEach((c, k) => {
          if (c.hidden) return;
          const r = c.getBoundingClientRect();
          const a = antes.get(c);
          if (a) {
            c.animate(
              [{ transform: `translate(${a.left - r.left}px, ${a.top - r.top}px)` }, { transform: 'none' }],
              { duration: 550, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
            );
          } else {
            c.animate(
              [{ opacity: 0, transform: 'scale(0.85) translateY(20px)' }, { opacity: 1, transform: 'none' }],
              { duration: 500, delay: k * 40, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)', fill: 'backwards' },
            );
          }
        });
      }),
    );
  }
</script>

<style>
  /* Banner: de tarjeta a todo lo ancho con el scroll */
  .nod-banner-wrap { --e: var(--p, 1); }
  .nod-banner {
    width: calc(100% - (1 - var(--e)) * clamp(2rem, 10vw, 10rem));
    border-radius: calc((1 - var(--e)) * 2.5rem + 0.01px);
    translate: 0 calc((1 - var(--e)) * 40px);
  }
  .nod-foto img { scale: calc(1.3 - var(--e) * 0.3); }
  .nod-saludo img { transform-origin: 50% 90%; animation: nod-saluda 2.6s ease-in-out infinite; }
  @keyframes nod-saluda { 0%, 60%, 100% { rotate: 0deg; } 70% { rotate: -12deg; } 80% { rotate: 10deg; } 90% { rotate: -6deg; } }

  .nod-chip {
    height: 2.5rem; padding: 0 1.1rem; border-radius: 999px; cursor: pointer;
    background: var(--color-neutral-0); box-shadow: inset 0 0 0 1px var(--color-border-default);
    font-size: 0.875rem; font-weight: 600; transition: background 250ms, color 250ms, box-shadow 250ms, transform 200ms;
  }
  .nod-chip:hover { box-shadow: inset 0 0 0 1px var(--color-neutral-950); }
  .nod-chip:active { transform: scale(0.96); }
  .nod-chip[aria-pressed="true"] { background: var(--color-neutral-950); color: var(--color-text-inverse); box-shadow: none; }

  .nod-card {
    display: flex; flex-direction: column; padding: 1.5rem; border-radius: 1.5rem;
    box-shadow: 0 1px 0 rgb(8 18 13 / 6%);
    transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 400ms;
    opacity: 0; translate: 0 40px;
  }
  .nod-card:hover { transform: translateY(-6px) rotate(-0.6deg); box-shadow: 0 24px 40px -16px rgb(8 18 13 / 30%); }
  [data-nod-grid]:global(.is-visible) .nod-card { opacity: 1; translate: 0 0; transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 400ms, opacity 600ms calc(var(--i) * 70ms), translate 800ms cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 70ms); }
  .nod-c1 { background: var(--color-green-200); }
  .nod-c2 { background: var(--color-yellow-200); }
  .nod-c3 { background: var(--color-neutral-0); }
  .nod-c4 { background: var(--color-green-100); }
  .nod-pin { background: var(--color-neutral-950); color: var(--color-accent-primary); transition: rotate 400ms; }
  .nod-card:hover .nod-pin { rotate: -12deg; }
  .nod-ir { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.5rem 0.85rem; border-radius: 999px; background: var(--color-neutral-950); color: var(--color-text-inverse); transition: background 200ms, color 200ms; }
  .nod-ir:hover { background: var(--color-accent-primary); color: var(--color-neutral-1000); }

  :global(html:not(.js)) .nod-card { opacity: 1; translate: none; }

  @media (prefers-reduced-motion: reduce) {
    .nod-banner-wrap { --e: 1 !important; }
    .nod-card { opacity: 1 !important; translate: none !important; }
    .nod-saludo img { animation: none; }
  }
</style>
