---
/**
 * HERO J · "Plano de localización"
 * Fondo negro. A la derecha, un plano esquemático de Baja California con
 * las sucursales en su posición real (latitud y longitud de
 * src/data/sucursales.ts), retícula de coordenadas y un "detalle" ampliado
 * de Tijuana, como en los planos de obra. Abajo, el cajetín de sucursales
 * dice cuál está abierta ahora (hora de Tijuana) y permite llamar directo;
 * al pasar sobre una sucursal se marca su punto en el plano.
 *
 * Sin JavaScript se ve el horario entre semana en lugar del estado.
 *
 * Uso: <HeroJ />
 */
import { assetUrl, rutaInterna } from '../../lib/asset-url';
import { whatsappUrl } from '../../lib/seo';
import { sucursales, telHref } from '../../data/sucursales';
import Button from '../ui/Button.astro';
import Cota from '../ui/Cota.astro';
import { coberturaTexto } from './heros-data';

/* Proyección equirectangular sencilla del área de las sucursales. */
const LNG0 = -117.15, LAT1 = 32.8, COS = Math.cos((32.2 * Math.PI) / 180), S = 348, PAD = 40;
const proy = (lat: number, lng: number) => ({ x: PAD + (lng - LNG0) * COS * S, y: PAD + (LAT1 - lat) * S });
const r1 = (n: number) => Math.round(n * 10) / 10;

const puntos = sucursales.map((s) => ({ ...s, ...proy(s.coordenadas.lat, s.coordenadas.lng) }));

/* Una marca por ciudad (centro de sus sucursales). */
const ciudades = [...new Set(sucursales.map((s) => s.ciudad))].map((ciudad) => {
  const ps = puntos.filter((p) => p.ciudad === ciudad);
  return { ciudad, x: ps.reduce((a, p) => a + p.x, 0) / ps.length, y: ps.reduce((a, p) => a + p.y, 0) / ps.length, n: ps.length };
});
const tij = ciudades.find((c) => c.ciudad === 'Tijuana')!;
const mxl = ciudades.find((c) => c.ciudad === 'Mexicali')!;
const ens = ciudades.find((c) => c.ciudad === 'Ensenada')!;

/* Detalle de Tijuana: mismas posiciones, 3 veces más grandes. */
const DET = { x: 460, y: 320, r: 95, k: 3 };
const detalle = puntos
  .filter((p) => p.ciudad === 'Tijuana')
  .map((p) => ({ ...p, dx: DET.x + (p.x - tij.x) * DET.k, dy: DET.y + (p.y - tij.y) * DET.k }));
const ang = Math.atan2(DET.y - tij.y, DET.x - tij.x);
const guia = {
  x1: tij.x + Math.cos(ang) * 22, y1: tij.y + Math.sin(ang) * 22,
  x2: DET.x - Math.cos(ang) * DET.r, y2: DET.y - Math.sin(ang) * DET.r,
};

/* Retícula cada medio grado. */
const meridianos = [-117, -116.5, -116, -115.5].map((lng) => ({ lng, x: proy(32, lng).x }));
const paralelos = [32.5, 32].map((lat) => ({ lat, y: proy(lat, -116).y }));
const grados = (n: number) => `${Math.abs(n).toLocaleString('es-MX', { minimumFractionDigits: 1 })}°`;

const corto = (nombre: string) => nombre.replace(/^Sucursal\s+/, '');
---

<section id="inicio" data-hj class="hj relative isolate overflow-hidden bg-neutral-950 text-text-inverse">
  <div class="container-page grid min-h-[calc(100svh-10rem)] grid-cols-[minmax(0,1fr)] content-center gap-x-12 gap-y-10 py-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:py-20">
    <div class="min-w-0 self-center">
      <h1 class="font-display text-[clamp(3.25rem,7.5vw,7rem)] leading-[0.88] font-extrabold uppercase">
        Acero cerca de tu obra
      </h1>
      <Cota texto={coberturaTexto} ancho="completo" class="mt-6 max-w-md text-text-accent" />
      <p class="mt-7 max-w-md type-body-l text-text-inverse-muted">
        Perfiles, vigas, lámina, tubería y ferretería en cada sucursal. Revisa cuál está abierta y llama
        directo, o cotiza por WhatsApp.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <Button href={whatsappUrl()} target="_blank" variant="secondary" size="lg" icon="whatsapp" iconPosition="right" label="Cotizar por WhatsApp" />
        <Button href={rutaInterna('/sucursales')} variant="primary" size="lg" icon="pin" iconPosition="right" label="Cómo llegar" />
      </div>
    </div>

    <!-- Plano -->
    <figure class="hj-plano relative min-w-0">
      <svg viewBox="0 0 640 470" class="h-auto w-full" fill="none" role="img" aria-label={`Plano esquemático con las ${sucursales.length} sucursales en Tijuana, Mexicali y Ensenada`}>
        <rect x="8" y="8" width="624" height="454" class="hj-marco" />
        {meridianos.map((m) => (
          <g class="hj-ret">
            <path d={`M${r1(m.x)} 8V462`} />
            <text x={r1(m.x) + 4} y="22">{grados(m.lng)} O</text>
          </g>
        ))}
        {paralelos.map((p) => (
          <g class="hj-ret">
            <path d={`M8 ${r1(p.y)}H632`} />
            <text x="14" y={r1(p.y) - 5}>{grados(p.lat)} N</text>
          </g>
        ))}

        <!-- Carreteras (esquemáticas) -->
        <path data-hj-ruta d={`M${r1(tij.x)} ${r1(tij.y)}Q${r1((tij.x + mxl.x) / 2)} ${r1(tij.y - 40)} ${r1(mxl.x)} ${r1(mxl.y)}`} pathLength="1" class="hj-ruta" />
        <path data-hj-ruta d={`M${r1(tij.x)} ${r1(tij.y)}Q${r1(tij.x + 10)} ${r1((tij.y + ens.y) / 2)} ${r1(ens.x)} ${r1(ens.y)}`} pathLength="1" class="hj-ruta" />

        {ciudades.map((c) => (
          <text x={r1(c.x) + (c.ciudad === 'Mexicali' ? -14 : 30)} y={r1(c.y) + (c.ciudad === 'Mexicali' ? -24 : 5)} text-anchor={c.ciudad === 'Mexicali' ? 'end' : 'start'} class="hj-ciudad">{c.ciudad}</text>
        ))}

        {puntos.filter((p) => p.ciudad !== 'Tijuana').map((p) => (
          <circle data-hj-punto={p.id} cx={r1(p.x)} cy={r1(p.y)} r="6" class="hj-punto" />
        ))}

        <!-- Tijuana: círculo de llamada y detalle -->
        <circle cx={r1(tij.x)} cy={r1(tij.y)} r="22" class="hj-llamada" />
        <path d={`M${r1(guia.x1)} ${r1(guia.y1)}L${r1(guia.x2)} ${r1(guia.y2)}`} class="hj-llamada" />
        <circle cx={DET.x} cy={DET.y} r={DET.r} class="hj-detalle" />
        <text x={DET.x} y={DET.y + DET.r + 20} text-anchor="middle" class="hj-etq">Detalle Tijuana, escala 3:1</text>
        {detalle.map((p) => (
          <g>
            <circle data-hj-punto={p.id} cx={r1(p.dx)} cy={r1(p.dy)} r="7" class="hj-punto" />
            <text x={r1(p.dx)} y={r1(p.dy) + (p.id === 'cucapah' ? -14 : 22)} text-anchor="middle" class="hj-etq">{corto(p.nombre)}</text>
          </g>
        ))}
      </svg>
    </figure>

    <!-- Cajetín de sucursales -->
    <ul class="hj-lista grid grid-cols-[minmax(0,1fr)] sm:grid-cols-2 lg:col-span-2 lg:grid-cols-6">
      {sucursales.map((s) => (
        <li data-hj-s={s.id} class="hj-celda min-w-0">
          <small>{s.ciudad}</small>
          <b>{corto(s.nombre)}</b>
          <span data-hj-estado data-horarios={JSON.stringify(s.horarios)} class="hj-estado">
            {s.horarios[0].dias} {s.horarios[0].horas}
          </span>
          <a href={telHref(s.telefonos[0])} class="hj-tel" aria-label={`Llamar a ${s.nombre}, ${s.telefonos[0]}`}>
            <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true"><use href={`${assetUrl('/icons.svg')}#phone`} /></svg>
            {s.telefonos[0]}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { estado, type Horario } from '../../lib/horario';

  const root = document.querySelector<HTMLElement>('[data-hj]');
  if (root) {
    const actualizar = () => {
      root.querySelectorAll<HTMLElement>('[data-hj-s]').forEach((li) => {
        const el = li.querySelector<HTMLElement>('[data-hj-estado]')!;
        const e = estado(JSON.parse(el.dataset.horarios!) as Horario[]);
        el.textContent = e.texto.replace(' · cierra a las ', ' hasta ').replace(' · abre ', ', abre ').replace(' a las ', ' ');
        li.classList.toggle('is-abierta', e.abierta);
        root.querySelectorAll(`[data-hj-punto="${li.dataset.hjS}"]`).forEach((p) => p.classList.toggle('is-abierta', e.abierta));
      });
    };
    actualizar();
    window.setInterval(actualizar, 60_000);

    /* Al pasar o enfocar una sucursal se marca su punto. */
    root.querySelectorAll<HTMLElement>('[data-hj-s]').forEach((li) => {
      const marcar = (on: boolean) => root.querySelectorAll(`[data-hj-punto="${li.dataset.hjS}"]`).forEach((p) => p.classList.toggle('is-marcado', on));
      li.addEventListener('pointerenter', () => marcar(true));
      li.addEventListener('pointerleave', () => marcar(false));
      li.addEventListener('focusin', () => marcar(true));
      li.addEventListener('focusout', () => marcar(false));
    });

    /* Las rutas se trazan una vez al aparecer. */
    new IntersectionObserver(([e], o) => {
      if (e.isIntersecting) { root.classList.add('is-visto'); o.disconnect(); }
    }, { threshold: 0.3 }).observe(root);
  }
</script>

<style>
  .hj-marco { stroke: rgb(255 255 255 / 0.3); }
  .hj-ret path { stroke: rgb(255 255 255 / 0.08); }
  .hj-ret text, .hj-etq { fill: var(--color-text-inverse-muted); font: 600 10px var(--font-sans); }
  .hj-etq { font-size: 11px; }
  .hj-ciudad { fill: var(--color-text-inverse); font: 700 22px var(--font-display); text-transform: uppercase; }

  .hj-ruta { stroke: var(--color-accent-primary); stroke-width: 1.5; stroke-dasharray: 0.012 0.008; opacity: 0.7; }
  :global(html.js) .hj-ruta { clip-path: inset(0 100% 0 0); transition: clip-path 1.6s cubic-bezier(0.65, 0, 0.35, 1) 200ms; }
  :global(html.js) .hj.is-visto .hj-ruta { clip-path: inset(0 0 0 0); }

  .hj-llamada { stroke: var(--color-text-inverse); stroke-width: 1; stroke-dasharray: 4 3; opacity: 0.6; }
  .hj-detalle { stroke: rgb(255 255 255 / 0.45); fill: rgb(255 255 255 / 0.03); }

  .hj-punto { fill: var(--color-neutral-950); stroke: var(--color-text-inverse-muted); stroke-width: 2; transition: r 200ms, fill 200ms, stroke 200ms; }
  .hj-punto.is-abierta { fill: var(--color-accent-primary); stroke: var(--color-accent-primary); }
  .hj-punto.is-marcado { r: 11px; stroke: var(--color-text-inverse); }

  .hj-lista { border: 1px solid rgb(255 255 255 / 0.25); }
  .hj-celda { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.85rem 1rem; transition: background-color 150ms; }
  .hj-celda:hover, .hj-celda:focus-within { background: rgb(255 255 255 / 0.05); }
  .hj-celda + .hj-celda { border-top: 1px solid rgb(255 255 255 / 0.25); }
  @media (min-width: 40rem) {
    .hj-celda + .hj-celda { border-top: 0; }
    .hj-celda:nth-child(n + 3) { border-top: 1px solid rgb(255 255 255 / 0.25); }
    .hj-celda:nth-child(even) { border-left: 1px solid rgb(255 255 255 / 0.25); }
  }
  @media (min-width: 64rem) {
    .hj-celda:nth-child(n + 3) { border-top: 0; }
    .hj-celda + .hj-celda { border-left: 1px solid rgb(255 255 255 / 0.25); }
  }
  .hj-celda small { font-size: 0.6875rem; color: var(--color-text-inverse-muted); }
  .hj-celda b { font-weight: 700; font-size: 0.9375rem; }
  .hj-estado { position: relative; padding-left: 0.9rem; font-size: 0.8125rem; color: var(--color-text-inverse-muted); }
  .hj-estado::before { content: ""; position: absolute; left: 0; top: 0.42em; width: 0.5rem; height: 0.5rem; border: 1.5px solid currentColor; }
  .hj-celda.is-abierta .hj-estado { color: var(--color-text-accent); }
  .hj-celda.is-abierta .hj-estado::before { background: currentColor; }
  .hj-tel { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.35rem; width: fit-content; font-size: 0.875rem; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgb(255 255 255 / 0.3); }
  .hj-tel:hover { text-decoration-color: var(--color-accent-primary); }
  .hj-tel:focus-visible { outline: 2px solid var(--color-accent-primary); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hj-ruta { clip-path: none; transition: none; }
    .hj-punto { transition: none; }
  }
</style>
