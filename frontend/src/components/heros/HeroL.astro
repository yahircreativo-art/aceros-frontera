---
/**
 * HERO L · "Lista de material"
 * Fondo blanco de hoja de dibujo. A la izquierda, el titular y un selector
 * de material por familia (pictogramas de marca + productos de
 * src/data/familias.ts). A la derecha, la "lista de material" de un plano:
 * cada producto que tocas se agrega como partida, con su medida y cantidad.
 * "Enviar lista por WhatsApp" manda todo en un solo mensaje.
 *
 * Sin JavaScript se ve la hoja vacía con el botón de WhatsApp normal.
 *
 * Uso: <HeroL />
 */
import { assetUrl, rutaInterna } from '../../lib/asset-url';
import { siteSeo, whatsappUrl } from '../../lib/seo';
import { familias } from '../../data/familias';
import Button from '../ui/Button.astro';
import Cota from '../ui/Cota.astro';
import Pictogram from '../ui/Pictogram.astro';

const icono = (id: string) => `${assetUrl('/icons.svg')}#${id}`;
---

<section id="inicio" data-hl data-wa={siteSeo.whatsapp} class="hl relative isolate overflow-hidden bg-neutral-0 text-text-primary">
  <div aria-hidden="true" class="hl-reticula absolute inset-0 -z-10"></div>

  <div class="container-page grid min-h-[calc(100svh-10rem)] grid-cols-[minmax(0,1fr)] items-center gap-12 py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:py-20">
    <div class="min-w-0">
      <h1 class="font-display text-[clamp(3rem,6.5vw,6rem)] leading-[0.88] font-extrabold uppercase">
        Arma tu lista. Te la cotizamos completa
      </h1>
      <Cota texto={`${familias.length} familias de producto, mayoreo y menudeo`} class="mt-6 text-text-brand" />

      <!-- Selector (solo con JS) -->
      <div data-hl-selector class="hl-selector mt-9">
        <div class="flex flex-wrap gap-1.5" role="tablist" aria-label="Familias de producto">
          {familias.map((f, i) => (
            <button type="button" role="tab" data-hl-fam={i} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`hl-panel-${i}`} tabindex={i === 0 ? 0 : -1} class="hl-fam chamfer [--chamfer:8px]" title={f.titulo}>
              <Pictogram name={f.icono} class="size-7" />
              <span class="sr-only sm:not-sr-only">{f.corto}</span>
            </button>
          ))}
        </div>
        {familias.map((f, i) => (
          <div id={`hl-panel-${i}`} role="tabpanel" data-hl-panel={i} hidden={i !== 0} class="mt-4 flex flex-wrap gap-2">
            {f.items.map((item) => (
              <button type="button" data-hl-add={item} data-familia={f.titulo} class="hl-chip chamfer [--chamfer:7px]">
                <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true"><use href={icono('cart-plus')} /></svg>
                {item}
              </button>
            ))}
          </div>
        ))}
        <p class="mt-4 type-caption text-text-muted">Toca un producto para agregarlo a tu lista.</p>
      </div>
      <p class="hl-sinjs mt-8 max-w-lg type-body-l text-text-secondary">
        Escríbenos qué material necesitas, con medidas y cantidades, y te cotizamos todo junto.
      </p>
    </div>

    <!-- Hoja: lista de material -->
    <div class="hl-hoja chamfer min-w-0 bg-neutral-0 [--chamfer:24px]">
      <div class="flex items-baseline justify-between gap-4 border-b border-neutral-950 px-5 py-4">
        <h2 class="font-display text-2xl font-bold uppercase leading-none">Lista de material</h2>
        <span data-hl-cuenta class="type-caption text-text-muted" aria-live="polite">Sin partidas</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[22rem] border-collapse text-left">
          <thead>
            <tr class="hl-cab">
              <th scope="col" class="w-12">Partida</th>
              <th scope="col">Material</th>
              <th scope="col" class="w-[30%]">Medida</th>
              <th scope="col" class="w-28">Cantidad</th>
              <th scope="col" class="w-10"><span class="sr-only">Quitar</span></th>
            </tr>
          </thead>
          <tbody data-hl-filas>
            {[0, 1, 2, 3].map(() => (
              <tr class="hl-vacia" aria-hidden="true"><td colspan="5"></td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-neutral-950 py-4 pl-5 pr-9">
        <a href={rutaInterna('/catalogo')} class="type-body-s font-semibold text-text-brand underline underline-offset-4">Buscar en el catálogo</a>
        <Button data-hl-enviar href={whatsappUrl()} target="_blank" variant="primary" size="md" icon="whatsapp" iconPosition="right" label="Enviar lista por WhatsApp" />
      </div>
    </div>
  </div>

  <template data-hl-tpl>
    <tr class="hl-fila">
      <td data-hl-num class="font-display text-xl font-bold"></td>
      <td><b data-hl-nombre class="block font-semibold"></b><small data-hl-familia class="type-caption text-text-muted"></small></td>
      <td><input data-hl-medida type="text" placeholder="Ej. 2″ cal. 14" class="hl-input" /></td>
      <td>
        <span class="hl-cant">
          <button type="button" data-hl-menos aria-label="Menos">−</button>
          <input data-hl-cant type="number" min="1" max="9999" value="1" inputmode="numeric" />
          <button type="button" data-hl-mas aria-label="Más">+</button>
        </span>
      </td>
      <td><button type="button" data-hl-quitar class="hl-quitar"><svg viewBox="0 0 24 24" class="size-4" aria-hidden="true"><use href={icono('x')} /></svg></button></td>
    </tr>
  </template>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-hl]');
  if (root) {
    root.classList.add('is-js');
    const filas = root.querySelector<HTMLTableSectionElement>('[data-hl-filas]')!;
    const tpl = root.querySelector<HTMLTemplateElement>('[data-hl-tpl]')!;
    const cuenta = root.querySelector<HTMLElement>('[data-hl-cuenta]')!;
    const enviar = root.querySelector<HTMLAnchorElement>('[data-hl-enviar]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-hl-fam]')];
    const paneles = [...root.querySelectorAll<HTMLElement>('[data-hl-panel]')];
    const MIN_FILAS = 4;

    /* Pestañas de familia (flechas para moverse entre ellas). */
    const elegir = (i: number, foco = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      paneles.forEach((p, k) => (p.hidden = k !== i));
      if (foco) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => elegir(i));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); elegir((i + d + tabs.length) % tabs.length, true); }
      });
    });

    const reales = () => [...filas.querySelectorAll<HTMLTableRowElement>('.hl-fila')];

    const actualizar = () => {
      const lista = reales();
      lista.forEach((f, i) => (f.querySelector('[data-hl-num]')!.textContent = String(i + 1).padStart(2, '0')));
      /* Renglones vacíos para que la hoja no "brinque". */
      filas.querySelectorAll('.hl-vacia').forEach((v) => v.remove());
      for (let i = lista.length; i < MIN_FILAS; i++) {
        const tr = document.createElement('tr');
        tr.className = 'hl-vacia';
        tr.setAttribute('aria-hidden', 'true');
        tr.innerHTML = '<td colspan="5"></td>';
        filas.append(tr);
      }
      cuenta.textContent = lista.length === 0 ? 'Sin partidas' : lista.length === 1 ? '1 partida' : `${lista.length} partidas`;

      const lineas = lista.map((f, i) => {
        const nombre = f.querySelector('[data-hl-nombre]')!.textContent;
        const medida = f.querySelector<HTMLInputElement>('[data-hl-medida]')!.value.trim();
        const cant = f.querySelector<HTMLInputElement>('[data-hl-cant]')!.value || '1';
        return `${i + 1}. ${nombre}${medida ? `, ${medida}` : ''}: ${cant}`;
      });
      const msg = lineas.length
        ? `Hola, quiero cotizar esta lista de material:\n${lineas.join('\n')}`
        : 'Hola, necesito cotizar acero y materiales para mi proyecto.';
      enviar.href = `https://wa.me/${root.dataset.wa}?text=${encodeURIComponent(msg)}`;
    };

    const agregar = (item: string, familia: string) => {
      const ya = reales().find((f) => f.dataset.item === item);
      if (ya) {
        const c = ya.querySelector<HTMLInputElement>('[data-hl-cant]')!;
        c.value = String(Number(c.value || 0) + 1);
        ya.classList.remove('is-nueva');
        void ya.offsetWidth;
        ya.classList.add('is-nueva');
        actualizar();
        return;
      }
      const fila = tpl.content.firstElementChild!.cloneNode(true) as HTMLTableRowElement;
      fila.dataset.item = item;
      fila.classList.add('is-nueva');
      fila.querySelector('[data-hl-nombre]')!.textContent = item;
      fila.querySelector('[data-hl-familia]')!.textContent = familia;
      fila.querySelector('[data-hl-medida]')!.setAttribute('aria-label', `Medida de ${item}`);
      fila.querySelector('[data-hl-cant]')!.setAttribute('aria-label', `Cantidad de ${item}`);
      fila.querySelector('[data-hl-quitar]')!.setAttribute('aria-label', `Quitar ${item}`);
      const primeraVacia = filas.querySelector('.hl-vacia');
      filas.insertBefore(fila, primeraVacia);
      actualizar();
    };

    root.querySelectorAll<HTMLButtonElement>('[data-hl-add]').forEach((b) =>
      b.addEventListener('click', () => agregar(b.dataset.hlAdd!, b.dataset.familia!)),
    );

    filas.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const fila = t.closest<HTMLTableRowElement>('.hl-fila');
      if (!fila) return;
      const c = fila.querySelector<HTMLInputElement>('[data-hl-cant]')!;
      if (t.closest('[data-hl-mas]')) c.value = String(Math.min(9999, Number(c.value || 0) + 1));
      else if (t.closest('[data-hl-menos]')) c.value = String(Math.max(1, Number(c.value || 1) - 1));
      else if (t.closest('[data-hl-quitar]')) {
        const sig = fila.nextElementSibling?.querySelector<HTMLElement>('[data-hl-quitar]');
        fila.remove();
        (sig ?? tabs.find((x) => x.tabIndex === 0))?.focus();
      } else return;
      actualizar();
    });
    filas.addEventListener('input', actualizar);
    actualizar();
  }
</script>

<style>
  .hl-reticula {
    background-image:
      linear-gradient(to right, rgb(0 74 52 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(0 74 52 / 0.05) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .hl-selector { display: none; }
  .hl.is-js .hl-selector { display: block; }
  .hl.is-js .hl-sinjs { display: none; }

  .hl-fam {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem;
    font-size: 0.8125rem; font-weight: 600; color: var(--color-text-secondary);
    background: var(--color-neutral-100); cursor: pointer; transition: background-color 150ms, color 150ms;
  }
  .hl-fam:hover { background: var(--color-neutral-200); color: var(--color-text-primary); }
  .hl-fam[aria-selected='true'] { background: var(--color-green-800); color: var(--color-text-inverse); }
  .hl-fam:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--color-accent-primary); }

  .hl-chip {
    display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.55rem 0.85rem;
    font-size: 0.9375rem; font-weight: 600; cursor: pointer;
    background: var(--color-neutral-0); box-shadow: inset 0 0 0 1px var(--color-neutral-400);
    transition: background-color 150ms, box-shadow 150ms;
  }
  .hl-chip:hover { background: var(--color-accent-primary); box-shadow: inset 0 0 0 1px var(--color-accent-primary); }
  .hl-chip:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--color-green-800); }

  .hl-hoja { box-shadow: inset 0 0 0 1px var(--color-neutral-950); }
  .hl-cab th { padding: 0.55rem 0.6rem; font-size: 0.6875rem; font-weight: 600; color: var(--color-text-muted); border-bottom: 1px solid var(--color-neutral-950); }
  .hl-cab th:first-child { padding-left: 1.25rem; }
  .hl-hoja :global(td) { padding: 0.55rem 0.6rem; border-bottom: 1px solid var(--color-neutral-200); vertical-align: middle; }
  .hl-hoja :global(td:first-child) { padding-left: 1.25rem; }
  .hl-hoja :global(.hl-vacia td) { height: 3.4rem; }
  .hl-hoja :global(.hl-fila.is-nueva) { animation: hl-nueva 700ms ease; }
  @keyframes hl-nueva { from { background: rgb(234 192 43 / 0.35); } to { background: transparent; } }

  .hl-hoja :global(.hl-input) { width: 100%; min-width: 6rem; padding: 0.35rem 0.4rem; font: 500 0.875rem var(--font-sans); background: transparent; box-shadow: inset 0 -1px 0 var(--color-neutral-400); outline: none; }
  .hl-hoja :global(.hl-input:focus-visible) { box-shadow: inset 0 0 0 2px var(--color-border-focus); }

  .hl-hoja :global(.hl-cant) { display: inline-grid; grid-template-columns: 1.75rem 2.75rem 1.75rem; box-shadow: inset 0 0 0 1px var(--color-neutral-400); }
  .hl-hoja :global(.hl-cant button) { height: 2rem; font-weight: 700; cursor: pointer; }
  .hl-hoja :global(.hl-cant button:hover) { background: var(--color-neutral-100); }
  .hl-hoja :global(.hl-cant input) { width: 100%; text-align: center; font: 600 0.875rem var(--font-sans); background: transparent; -moz-appearance: textfield; outline: none; }
  .hl-hoja :global(.hl-cant input::-webkit-inner-spin-button) { -webkit-appearance: none; }
  .hl-hoja :global(.hl-cant :focus-visible) { box-shadow: inset 0 0 0 2px var(--color-border-focus); }
  .hl-hoja :global(.hl-quitar) { display: grid; place-items: center; width: 2rem; height: 2rem; color: var(--color-text-muted); cursor: pointer; }
  .hl-hoja :global(.hl-quitar:hover) { color: var(--color-text-primary); background: var(--color-neutral-100); }
  .hl-hoja :global(.hl-quitar:focus-visible) { outline: none; box-shadow: inset 0 0 0 2px var(--color-border-focus); }

  @media (prefers-reduced-motion: reduce) { .hl-hoja :global(.hl-fila.is-nueva) { animation: none; } }
</style>
