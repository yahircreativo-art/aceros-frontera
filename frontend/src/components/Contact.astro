---
import { siteSeo } from '../lib/seo';
import { assetUrl } from '../lib/asset-url';

const location = '32.4851102,-116.873457';
const encodedLocation = encodeURIComponent(location);
---

<section id="contacto" class="container-page scroll-mt-44 lg:scroll-mt-28 border-t border-line  py-16 lg:py-20">
  

    <div class="mt-9 grid gap-8 md:grid-cols-[1.4fr_0.8fr] lg:gap-12">
      <iframe
        title={`Mapa de ubicación: ${siteSeo.address.street}, ${siteSeo.address.city}`}
        src={`https://maps.google.com/maps?q=${encodedLocation}&z=17&output=embed`}
        class="aspect-4/3 min-h-full w-full border-0 sm:aspect-video lg:aspect-auto"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>

      <div class="flex flex-col justify-center border-t border-line pt-7 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
        <div>
      <h2 class="mt-3 font-display text-3xl font-bold text-ink-900 sm:text-4xl">
        Cotiza acero y materiales para tu proyecto
      </h2>
        <address class="mt-5 not-italic text-sm leading-relaxed text-ink-600">
          {siteSeo.address.street}<br />
          {siteSeo.address.city}, {siteSeo.address.region}<br />
          {siteSeo.address.countryName}
        </address>

        <dl class="mt-6 space-y-4 text-sm">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-ink-400">Teléfono</dt>
            <dd class="mt-1">
              <a class="font-medium text-ink-800 hover:text-brand-700" href={`tel:${siteSeo.phoneHref}`}>
                {siteSeo.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-ink-400">Correo</dt>
            <dd class="mt-1">
              <a class="font-medium text-ink-800 hover:text-brand-700" href={`mailto:${siteSeo.email}`}>
                {siteSeo.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-ink-400">Horario de atención</dt>
            <dd class="mt-2 space-y-1 text-ink-600">
              {siteSeo.openingHours.map((horario) => (
                <p>{horario.label}: {horario.opens}–{horario.closes}</p>
              ))}
            </dd>
          </div>
        </dl>

        <a
          href={`https://www.google.com/maps/dir/?api=1&destination=${encodedLocation}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7 inline-flex w-fit items-center gap-2 border-b border-brand-600 pb-1 text-sm font-semibold text-brand-700 hover:text-brand-900"
        >
          Cómo llegar
          <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
            <use href={`${assetUrl('/icons.svg')}#arrow-right`}></use>
          </svg>
        </a>
      </div>
    </div>
    </div>

    <div id="formulario-cotizacion" class="mt-14 scroll-mt-44 border-t border-line pt-10 lg:mt-16 lg:scroll-mt-28">
      <div class="mx-auto w-full max-w-5xl">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-2xs font-bold uppercase tracking-[0.18em] text-brand-600">Cotización</p>
          <h2 class="mt-3 font-display text-2xl font-bold text-ink-900 sm:text-3xl">
            Cuéntanos qué material necesitas
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-600">
            Completa los datos y continuaremos tu solicitud por WhatsApp.
          </p>
        </div>

      <form id="formulario-whatsapp" class="mx-auto mt-7 grid w-full gap-5 sm:grid-cols-2">
        <div>
          <label for="cotizacion-nombre" class="mb-1.5 block text-sm font-semibold text-ink-800">Nombre</label>
          <input
            id="cotizacion-nombre"
            name="nombre"
            type="text"
            autocomplete="name"
            required
            class="h-12 w-full border border-line bg-white px-3 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
            placeholder="Tu nombre"
          />
        </div>
        <div>
          <label for="cotizacion-telefono" class="mb-1.5 block text-sm font-semibold text-ink-800">Teléfono</label>
          <input
            id="cotizacion-telefono"
            name="telefono"
            type="tel"
            autocomplete="tel"
            required
            class="h-12 w-full border border-line bg-white px-3 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
            placeholder="664 000 0000"
          />
        </div>
        <div>
          <label for="cotizacion-material" class="mb-1.5 block text-sm font-semibold text-ink-800">Material o pieza</label>
          <div class="relative">
            <select
              id="cotizacion-material"
              name="material"
              required
              class="h-12 w-full appearance-none border border-line bg-white py-3 pl-3 pr-12 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
            >
              <option value="" disabled selected>Selecciona un material</option>
              <option>Perfil tubular cuadrado</option>
              <option>Perfil ángulo</option>
              <option>Tubo redondo</option>
              <option>Alambrón</option>
              <option>Malla electrosoldada</option>
              <option>Placa o lámina</option>
              <option value="otro">Otro material</option>
            </select>
            <svg viewBox="0 0 24 24" class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-ink-500" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </div>
          <input
            id="cotizacion-material-otro"
            name="material_otro"
            type="text"
            hidden
            class="mt-3 h-12 w-full border border-line bg-white px-3 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
            placeholder="Especifica el material o pieza"
          />
        </div>
        <div>
          <label for="cotizacion-medidas" class="mb-1.5 block text-sm font-semibold text-ink-800">Medidas o especificaciones</label>
          <div class="relative">
            <select
              id="cotizacion-medidas"
              name="medidas"
              class="h-12 w-full appearance-none border border-line bg-white py-3 pl-3 pr-12 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
            >
              <option value="" selected>Selecciona una especificación</option>
              <option>Calibre o espesor</option>
              <option>Diámetro</option>
              <option>Largo</option>
              <option>Ancho</option>
              <option>Medida de sección</option>
              <option>Grado o acabado</option>
              <option>Presentación o peso</option>
              <option value="otro">Otra especificación</option>
            </select>
            <svg viewBox="0 0 24 24" class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-ink-500" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </div>
          <input
            id="cotizacion-medidas-otro"
            name="medidas_otro"
            type="text"
            hidden
            class="mt-3 h-12 w-full border border-line bg-white px-3 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
            placeholder="Especifica las medidas o características"
          />
        </div>
        <div>
          <label for="cotizacion-cantidad" class="mb-1.5 block text-sm font-semibold text-ink-800">Cantidad aproximada</label>
          <input
            id="cotizacion-cantidad"
            name="cantidad"
            type="text"
            class="h-12 w-full border border-line bg-white px-3 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
            placeholder="Piezas, metros, toneladas..."
          />
        </div>
        <div>
          <label for="cotizacion-notas" class="mb-1.5 block text-sm font-semibold text-ink-800">Detalles adicionales</label>
          <input
            id="cotizacion-notas"
            name="notas"
            type="text"
            class="h-12 w-full border border-line bg-white px-3 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
            placeholder="Cuéntanos sobre tu proyecto"
          />
        </div>
        <button
          type="submit"
          class="inline-flex rounded-lg min-h-12 w-full items-center justify-center gap-2 bg-brand-700 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-800 sm:col-span-2 sm:w-fit sm:justify-self-center"
        >
          Enviar por WhatsApp
          <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
            <use href={`${assetUrl('/icons.svg')}#whatsapp`}></use>
          </svg>
        </button>
      </form>
      </div>
    </div>
</section>

<script>
  import { siteSeo } from '../lib/seo';

  const form = document.querySelector<HTMLFormElement>('#formulario-whatsapp');

  const enlazarOpcionOtro = (selectId: string, inputId: string) => {
    const select = document.querySelector<HTMLSelectElement>(`#${selectId}`);
    const input = document.querySelector<HTMLInputElement>(`#${inputId}`);
    if (!select || !input) return;

    const actualizarCampoOtro = () => {
      const mostrar = select.value === 'otro';
      input.hidden = !mostrar;
      input.required = mostrar;
      if (!mostrar) input.value = '';
    };

    select.addEventListener('change', actualizarCampoOtro);
    actualizarCampoOtro();
  };

  enlazarOpcionOtro('cotizacion-material', 'cotizacion-material-otro');
  enlazarOpcionOtro('cotizacion-medidas', 'cotizacion-medidas-otro');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const material = data.get('material') === 'otro'
      ? data.get('material_otro')
      : data.get('material');
    const medidas = data.get('medidas') === 'otro'
      ? data.get('medidas_otro')
      : data.get('medidas');
    const mensaje = [
      'Hola, quiero solicitar una cotización.',
      `Nombre: ${data.get('nombre')}`,
      `Teléfono: ${data.get('telefono')}`,
      `Material o pieza: ${material}`,
      medidas ? `Medidas o especificaciones: ${medidas}` : '',
      data.get('cantidad') ? `Cantidad aproximada: ${data.get('cantidad')}` : '',
      data.get('notas') ? `Detalles: ${data.get('notas')}` : '',
    ].filter(Boolean).join('\n');

    window.location.href = `https://wa.me/${siteSeo.whatsapp}?text=${encodeURIComponent(mensaje)}`;
  });
</script>