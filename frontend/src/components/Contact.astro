---
/**
 * Bloque de contacto de la portada: ubicación + formulario de cotización
 * (los mismos componentes que la página /contacto).
 */
import Ubicacion from './contacto/Ubicacion.astro';
import Cotizacion from './contacto/Cotizacion.astro';
---

<section id="contacto" class="scroll-mt-44 bg-surface-canvas py-20 lg:scroll-mt-28 lg:py-28">
  <div class="container-page flex flex-col gap-20 lg:gap-28">
    <Ubicacion />
    <Cotizacion />
  </div>
</section>
