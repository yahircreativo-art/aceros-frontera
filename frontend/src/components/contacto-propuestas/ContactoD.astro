---
/**
 * CONTACTO D · "Canales en bento"
 * Un "¿HABLAMOS?" gigante se desliza de lado con el scroll. Debajo, un
 * bento con los canales: WhatsApp (grande), Llamar, Correo y Visítanos.
 * Las tarjetas entran escalonadas, se inclinan siguiendo el cursor y tienen
 * un brillo que lo sigue. Teléfono y correo se copian con un clic (aviso
 * "¡Copiado!").
 */
import { siteSeo, whatsappUrl, sucursales, ciudades, icono } from './contacto-data';
import { assetUrl, rutaInterna } from '../../lib/asset-url';

const horario = siteSeo.openingHours.map((h) => `${h.label}: ${h.opens}–${h.closes}`).join(' · ');
---

<section id="contacto" data-cod class="cod scroll-mt-28 overflow-hidden bg-neutral-100 py-20 lg:py-28">
  <div data-cod-gigante class="cod-gigante" aria-hidden="true">
    <span>¿Hablamos?</span><span class="cod-hueco">¿Hablamos?</span><span>¿Hablamos?</span>
  </div>
  <h2 class="sr-only">Contacto</h2>

  <div data-cod-grid class="container-page mt-10 grid gap-4 md:grid-cols-6 lg:mt-14">
    <!-- WhatsApp -->
    <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" data-cod-card class="cod-card group bg-brand-primary text-text-on-brand md:col-span-4 md:row-span-2" style="--i:0">
      <span class="cod-brillo" aria-hidden="true"></span>
      <span class="flex items-start justify-between">
        <span class="cod-ico bg-white/15"><svg viewBox="0 0 24 24" class="size-7" aria-hidden="true"><use href={icono('whatsapp')} /></svg></span>
        <span class="cod-ir" aria-hidden="true">↗</span>
      </span>
      <img src={assetUrl('/images/personaje.webp')} alt="" loading="lazy" class="cod-personaje" />
      <span class="relative mt-auto block max-w-sm">
        <span class="block type-overline text-green-200">La vía más rápida</span>
        <span class="mt-2 block font-display text-[clamp(2.5rem,5vw,4.5rem)] leading-[0.9] font-extrabold uppercase">Cotiza por WhatsApp</span>
        <span class="mt-3 block type-body-m text-green-100">Mándanos tu lista o una foto del plano y te respondemos con precio y existencia.</span>
      </span>
    </a>

    <!-- Llamar -->
    <div data-cod-card class="cod-card bg-accent-primary text-neutral-1000 md:col-span-2" style="--i:1">
      <span class="cod-brillo" aria-hidden="true"></span>
      <span class="cod-ico bg-black/10"><svg viewBox="0 0 24 24" class="size-6" aria-hidden="true"><use href={icono('phone')} /></svg></span>
      <span class="mt-auto block type-overline">Llámanos</span>
      <a href={`tel:${siteSeo.phoneHref}`} class="relative mt-1 block font-display text-3xl font-bold hover:underline">{siteSeo.phone}</a>
      <button type="button" data-cod-copiar={siteSeo.phone} class="cod-copiar">Copiar</button>
    </div>

    <!-- Correo -->
    <div data-cod-card class="cod-card bg-neutral-950 text-text-inverse md:col-span-2" style="--i:2">
      <span class="cod-brillo" aria-hidden="true"></span>
      <span class="cod-ico bg-white/10 text-accent-primary"><svg viewBox="0 0 24 24" class="size-6" aria-hidden="true"><use href={icono('mail')} /></svg></span>
      <span class="mt-auto block type-overline text-text-inverse-muted">Escríbenos</span>
      <a href={`mailto:${siteSeo.email}`} class="relative mt-1 block break-all type-h4 hover:text-accent-primary">{siteSeo.email}</a>
      <button type="button" data-cod-copiar={siteSeo.email} class="cod-copiar cod-copiar-inv">Copiar</button>
    </div>

    <!-- Visítanos -->
    <a href={rutaInterna("/sucursales")} data-cod-card class="cod-card bg-neutral-0 md:col-span-3" style="--i:3">
      <span class="cod-brillo" aria-hidden="true"></span>
      <span class="flex items-start justify-between">
        <span class="cod-ico bg-green-100 text-text-brand"><svg viewBox="0 0 24 24" class="size-6" aria-hidden="true"><use href={icono('pin')} /></svg></span>
        <span class="cod-ir" aria-hidden="true">→</span>
      </span>
      <span class="mt-8 block font-display text-5xl leading-none font-extrabold">{sucursales.length} sucursales</span>
      <span class="mt-2 block type-body-s text-text-secondary">{ciudades.join(' · ')}</span>
    </a>

    <!-- Horario -->
    <div data-cod-card class="cod-card bg-green-900 text-text-inverse md:col-span-3" style="--i:4">
      <span class="cod-brillo" aria-hidden="true"></span>
      <span class="cod-ico bg-white/10 text-accent-primary"><svg viewBox="0 0 24 24" class="size-6" aria-hidden="true"><use href={icono('clock')} /></svg></span>
      <span class="mt-8 block type-overline text-green-200">Horario</span>
      <span class="mt-1 block type-h4">{horario}</span>
    </div>
  </div>

  <p data-cod-aviso class="cod-aviso" role="status" aria-live="polite"></p>
</section>

<script>
  import { alAparecer, progresoScroll } from '../../lib/scroll-progreso';

  const sec = document.querySelector<HTMLElement>('[data-cod]');
  if (sec) {
    progresoScroll(sec.querySelector<HTMLElement>('[data-cod-gigante]')!, 'paso');
    alAparecer([sec.querySelector('[data-cod-grid]')!], 0.15);

    /* Inclinación + brillo que sigue al cursor */
    const fino = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (fino && !quieto) {
      sec.querySelectorAll<HTMLElement>('[data-cod-card]').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width;
          const y = (e.clientY - r.top) / r.height;
          card.style.setProperty('--mx', `${x * 100}%`);
          card.style.setProperty('--my', `${y * 100}%`);
          card.style.setProperty('--rx', `${(0.5 - y) * 6}deg`);
          card.style.setProperty('--ry', `${(x - 0.5) * 8}deg`);
        });
        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--rx', '0deg');
          card.style.setProperty('--ry', '0deg');
        });
      });
    }

    /* Copiar */
    const aviso = sec.querySelector<HTMLElement>('[data-cod-aviso]')!;
    let t: number | undefined;
    sec.querySelectorAll<HTMLButtonElement>('[data-cod-copiar]').forEach((b) =>
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.codCopiar!);
          aviso.textContent = `¡Copiado! ${b.dataset.codCopiar}`;
          b.textContent = '✓ Copiado';
        } catch {
          aviso.textContent = 'No se pudo copiar';
        }
        aviso.classList.add('is-on');
        window.clearTimeout(t);
        t = window.setTimeout(() => {
          aviso.classList.remove('is-on');
          b.textContent = 'Copiar';
        }, 1800);
      }),
    );
  }
</script>

<style>
  .cod-gigante {
    display: flex; gap: 0.25em; white-space: nowrap; width: max-content;
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase; line-height: 0.85;
    font-size: clamp(5rem, 17vw, 16rem); color: var(--color-neutral-950);
    translate: calc(-20% + var(--p, 0.5) * 18%) 0;
  }
  .cod-hueco { color: transparent; -webkit-text-stroke: 2px var(--color-green-700); }

  .cod-card {
    position: relative; isolation: isolate; display: flex; flex-direction: column; min-height: 15rem; padding: 1.5rem; overflow: hidden; border-radius: 1.75rem;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 700ms, translate 900ms cubic-bezier(0.2, 0.8, 0.2, 1), scale 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
    opacity: 0; translate: 0 50px; scale: 0.94;
  }
  @media (min-width: 48rem) { .cod-card { padding: 2rem; } }
  [data-cod-grid]:global(.is-visible) .cod-card { opacity: 1; translate: 0 0; scale: 1; transition-delay: 0s, calc(var(--i) * 90ms), calc(var(--i) * 90ms), calc(var(--i) * 90ms); }
  .cod-brillo { position: absolute; inset: 0; z-index: -1; opacity: 0; background: radial-gradient(400px circle at var(--mx, 50%) var(--my, 50%), rgb(255 255 255 / 18%), transparent 45%); transition: opacity 300ms; }
  .cod-card:hover .cod-brillo { opacity: 1; }

  .cod-ico { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 1rem; transition: rotate 400ms cubic-bezier(0.34, 1.5, 0.5, 1); }
  .cod-card:hover .cod-ico { rotate: -10deg; }
  .cod-ir { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 999px; box-shadow: inset 0 0 0 1px currentColor; font-size: 1.25rem; transition: background 250ms, color 250ms, rotate 400ms; }
  .cod-card:hover .cod-ir { background: var(--color-neutral-950); color: var(--color-accent-primary); box-shadow: none; rotate: 45deg; }

  .cod-personaje { position: absolute; right: -2rem; bottom: -3rem; z-index: -1; width: min(48%, 20rem); pointer-events: none; translate: 0 20%; transition: translate 600ms cubic-bezier(0.2, 0.8, 0.2, 1), rotate 600ms; }
  .cod-card:hover .cod-personaje { translate: 0 6%; rotate: -4deg; }
  @media (max-width: 47.99rem) { .cod-personaje { opacity: 0.35; } }

  .cod-copiar { position: absolute; right: 1.25rem; top: 1.25rem; padding: 0.4rem 0.8rem; border-radius: 999px; cursor: pointer; font-size: 0.75rem; font-weight: 700; background: rgb(0 0 0 / 10%); transition: background 200ms, scale 200ms; }
  .cod-copiar:hover { background: rgb(0 0 0 / 20%); scale: 1.05; }
  .cod-copiar-inv { background: rgb(255 255 255 / 10%); }
  .cod-copiar-inv:hover { background: rgb(255 255 255 / 20%); }

  .cod-aviso { position: fixed; left: 50%; bottom: 2rem; z-index: 60; padding: 0.7rem 1.2rem; border-radius: 999px; background: var(--color-neutral-950); color: var(--color-text-inverse); font-weight: 600; font-size: 0.875rem; translate: -50% 150%; opacity: 0; pointer-events: none; transition: translate 400ms cubic-bezier(0.34, 1.4, 0.5, 1), opacity 300ms; }
  .cod-aviso:global(.is-on) { translate: -50% 0; opacity: 1; }

  :global(html:not(.js)) .cod-card { opacity: 1; translate: none; scale: 1; }
  @media (prefers-reduced-motion: reduce) {
    .cod-gigante { translate: -10% 0; }
    .cod-card { opacity: 1 !important; translate: none !important; scale: 1 !important; }
  }
</style>
