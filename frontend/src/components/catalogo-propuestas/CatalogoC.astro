---
/**
 * CATÁLOGO C · "Recorrido horizontal"
 * En escritorio la sección se queda fija y, al bajar con el scroll, las
 * tarjetas de familia viajan de derecha a izquierda. La tarjeta más cercana
 * al centro crece, se ilumina y gira su pictograma; las demás se encogen.
 * Contador "03 / 07" y barra de avance. En celular: carrusel deslizable con
 * imán (scroll-snap).
 */
import type { Producto } from '../../lib/types';
import Pictogram from '../ui/Pictogram.astro';
import { prepararFamilias, catalogoUrl, cotizarLista } from './catalogo-data';
import { assetUrl } from '../../lib/asset-url';

interface Props { productos: Producto[] }
const familias = prepararFamilias(Astro.props.productos);
const tonos = ['cac-t1', 'cac-t2', 'cac-t3', 'cac-t4'];
const check = `${assetUrl('/icons.svg')}#check`;
---

<section id="categorias" data-cac class="cac relative scroll-mt-28 bg-neutral-950 text-text-inverse">
  <div class="cac-fijo flex flex-col justify-center overflow-hidden py-16 lg:sticky lg:top-0 lg:h-svh lg:py-0">
    <div class="container-page flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="type-overline text-text-accent">Catálogo</p>
        <h2 class="mt-3 font-display text-[clamp(2.5rem,5.5vw,4.5rem)] leading-[0.9] font-extrabold uppercase">Lo que encuentras<br /><span class="text-text-accent">en la tienda</span></h2>
      </div>
      <div class="hidden items-center gap-4 lg:flex">
        <span class="font-mono text-sm"><span data-cac-n>01</span> / {String(familias.length).padStart(2, '0')}</span>
        <span class="relative h-[3px] w-40 overflow-hidden bg-white/15"><i class="cac-barra absolute inset-0 bg-accent-primary"></i></span>
      </div>
    </div>

    <div data-cac-ventana class="cac-ventana mt-10 lg:mt-14">
      <ul data-cac-pista class="cac-pista flex gap-5">
        {familias.map((f, i) => (
          <li data-cac-card class:list={['cac-card', tonos[i % tonos.length]]}>
            <a href={f.href} class="flex h-full flex-col p-6 sm:p-8">
              <span class="flex items-start justify-between">
                <span class="cac-ico"><Pictogram name={f.icono} class="size-10" /></span>
                <span class="font-display text-7xl leading-none font-extrabold opacity-20">{f.numero}</span>
              </span>
              <span class="mt-auto block font-display text-[2.6rem] leading-[0.92] font-extrabold uppercase">{f.titulo}</span>
              <ul class="mt-4 grid grid-cols-2 gap-x-3 gap-y-1.5 type-body-s">
                {f.items.map((it) => (
                  <li class="flex items-center gap-1.5"><svg viewBox="0 0 24 24" class="size-3.5 shrink-0 opacity-70" aria-hidden="true"><use href={check} /></svg>{it}</li>
                ))}
              </ul>
              <span class="cac-ver mt-6 type-button-s">Ver productos →</span>
            </a>
          </li>
        ))}
        <li data-cac-card class="cac-card cac-final">
          <div class="flex h-full flex-col justify-between p-6 sm:p-8">
            <span class="font-display text-4xl leading-[0.92] font-extrabold uppercase">¿No encuentras lo que buscas?</span>
            <span class="flex flex-col gap-3">
              <a href={cotizarLista} target="_blank" rel="noopener noreferrer" class="cac-btn bg-accent-primary text-neutral-1000">Cotiza tu lista por WhatsApp</a>
              <a href={catalogoUrl} class="cac-btn ring-1 ring-white/25">Ver catálogo completo</a>
            </span>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-cac]');
  if (sec) {
    const ventana = sec.querySelector<HTMLElement>('[data-cac-ventana]')!;
    const pista = sec.querySelector<HTMLElement>('[data-cac-pista]')!;
    const cards = [...sec.querySelectorAll<HTMLElement>('[data-cac-card]')];
    const n = sec.querySelector<HTMLElement>('[data-cac-n]')!;
    const escritorio = window.matchMedia('(min-width: 64rem)');
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let recorrido = 0;
    let pendiente = false;

    /* Alto de la sección = lo que hay que recorrer + una pantalla */
    const medir = () => {
      if (!escritorio.matches || quieto) {
        sec.style.height = '';
        pista.style.transform = '';
        sec.classList.remove('is-recorrido');
        return;
      }
      sec.classList.add('is-recorrido');
      const cs = getComputedStyle(ventana);
      const util = ventana.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      recorrido = Math.max(0, pista.scrollWidth - util);
      sec.style.height = `${window.innerHeight + recorrido}px`;
      pintar();
    };
    const pintar = () => {
      pendiente = false;
      if (!sec.classList.contains('is-recorrido')) return;
      const r = sec.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / Math.max(1, recorrido)));
      pista.style.transform = `translate3d(${-p * recorrido}px, 0, 0)`;
      sec.style.setProperty('--avance', p.toFixed(4));
      const centro = window.innerWidth / 2;
      let cerca = 0, min = Infinity;
      cards.forEach((c, i) => {
        const b = c.getBoundingClientRect();
        const d = Math.abs(b.left + b.width / 2 - centro) / window.innerWidth;
        c.style.setProperty('--cerca', Math.max(0, 1 - d * 2.2).toFixed(3));
        if (d < min) { min = d; cerca = i; }
      });
      cards.forEach((c, i) => c.classList.toggle('is-centro', i === cerca));
      n.textContent = String(Math.min(cerca + 1, cards.length - 1)).padStart(2, '0');
    };
    window.addEventListener('scroll', () => {
      if (!pendiente) { pendiente = true; requestAnimationFrame(pintar); }
    }, { passive: true });
    window.addEventListener('resize', medir);
    escritorio.addEventListener('change', medir);
    medir();
  }
</script>

<style>
  .cac-ventana { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-inline: max(1rem, calc((100vw - 80rem) / 2 + 1.5rem)); }
  .cac-ventana::-webkit-scrollbar { display: none; }
  .cac.is-recorrido .cac-ventana { overflow: visible; scroll-snap-type: none; }
  .cac-pista { width: max-content; padding-bottom: 1rem; will-change: transform; }

  .cac-card {
    --cerca: 1;
    width: min(82vw, 23rem); height: min(62svh, 32rem); min-height: 26rem; flex-shrink: 0; scroll-snap-align: center;
    overflow: hidden; border-radius: 1.75rem; transform-origin: center bottom;
  }
  .cac.is-recorrido .cac-card {
    --cerca: 0;
    scale: calc(0.86 + var(--cerca) * 0.14);
    rotate: calc((1 - var(--cerca)) * -2deg);
    filter: saturate(calc(0.5 + var(--cerca) * 0.5));
    transition: scale 200ms linear, rotate 200ms linear;
  }
  .cac-t1 { background: var(--color-green-800); }
  .cac-t2 { background: var(--color-accent-primary); color: var(--color-neutral-1000); }
  .cac-t3 { background: var(--color-neutral-0); color: var(--color-neutral-1000); }
  .cac-t4 { background: var(--color-neutral-800); }
  .cac-final { background: transparent; box-shadow: inset 0 0 0 2px rgb(255 255 255 / 20%); }

  .cac-ico { display: grid; place-items: center; width: 4.5rem; height: 4.5rem; border-radius: 1.25rem; background: rgb(0 0 0 / 15%); transition: rotate 600ms cubic-bezier(0.34, 1.5, 0.5, 1), scale 600ms cubic-bezier(0.34, 1.5, 0.5, 1); }
  .cac-card.is-centro .cac-ico, .cac-card:hover .cac-ico { rotate: -12deg; scale: 1.12; }
  .cac-ver { display: inline-flex; width: fit-content; padding-bottom: 0.2rem; border-bottom: 2px solid currentColor; transition: gap 200ms, padding 200ms; }
  .cac-card a:hover .cac-ver { padding-left: 0.4rem; }
  .cac-btn { display: block; padding: 0.9rem 1.2rem; border-radius: 999px; text-align: center; font-weight: 600; transition: transform 200ms; }
  .cac-btn:hover { transform: scale(1.03); }

  .cac-barra { transform: scaleX(var(--avance, 0)); transform-origin: left; }
</style>
