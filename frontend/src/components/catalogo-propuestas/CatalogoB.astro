---
/**
 * CATÁLOGO B · "Índice tipográfico"
 * Fondo claro. Las familias son renglones de tipografía gigante; al entrar,
 * cada renglón se destapa de abajo hacia arriba. En escritorio, al pasar el
 * cursor el renglón se llena de verde desde la izquierda y el boceto de la
 * pieza (a la derecha del renglón) se vuelve a dibujar en amarillo.
 */
import type { Producto } from '../../lib/types';
import { prepararFamilias, catalogoUrl, cotizarLista } from './catalogo-data';
import PlanoLinea from './PlanoLinea.astro';
import Button from '../ui/Button.astro';

interface Props { productos: Producto[] }
const familias = prepararFamilias(Astro.props.productos);
---

<section id="categorias" data-cab class="cab relative scroll-mt-28 bg-neutral-100 py-20 lg:py-28">
  <div class="container-page">
    <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="type-overline text-text-brand">Catálogo</p>
        <h2 class="mt-3 type-h1">Lo que encuentras <span class="text-text-brand">en la tienda</span></h2>
      </div>
      <p class="max-w-sm type-body-m text-text-secondary">{familias.length} familias de producto, del acero estructural a la ferretería para tu obra.</p>
    </div>

    <ul data-cab-lista class="mt-12 border-t border-neutral-950/15">
      {familias.map((f, i) => (
        <li class="cab-fila" data-cab-fila={i} style={`--i:${i}`}>
          <a href={f.href} class="cab-enlace">
            <span class="cab-fondo" aria-hidden="true"></span>
            <span class="cab-num font-mono text-xs">{f.numero}</span>
            <span class="cab-mascara"><span class="cab-nombre">{f.titulo}</span></span>
            <span class="cab-items hidden type-body-s xl:block">{f.items.slice(0, 3).join(' · ')}</span>
            <span class="cab-mini" aria-hidden="true"><PlanoLinea plano={f.plano} nombre={f.pieza} notas={false} class="size-full" /></span>
            <span class="cab-flecha" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex flex-wrap gap-4">
      <Button href={catalogoUrl} variant="primary" size="lg" icon="arrow-right" iconPosition="right" label="Ver catálogo completo" />
      <Button href={cotizarLista} target="_blank" variant="secondary" size="lg" icon="whatsapp" iconPosition="right" label="Cotiza tu lista por WhatsApp" />
    </div>
  </div>

</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-cab]');
  if (sec) {
    const filas = [...sec.querySelectorAll<HTMLElement>('[data-cab-fila]')];
    const obs = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('is-visible', 'is-trazado');
      obs.unobserve(e.target);
    }), { threshold: 0.4 });
    filas.forEach((f) => obs.observe(f));

    /* Al pasar el cursor, el boceto del renglón se vuelve a trazar */
    if (window.matchMedia('(hover: hover)').matches) {
      filas.forEach((f) =>
        f.addEventListener('mouseenter', () => {
          f.classList.remove('is-trazado');
          void f.offsetWidth;
          f.classList.add('is-trazado');
        }),
      );
    }
  }
</script>

<style>
  .cab-enlace {
    position: relative; isolation: isolate; display: grid; align-items: center; gap: 1rem;
    grid-template-columns: 2.5rem 1fr auto auto; padding: 1.1rem 0.5rem; border-bottom: 1px solid rgb(8 18 13 / 15%);
    transition: color 350ms, padding 450ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @media (min-width: 80rem) { .cab-enlace { grid-template-columns: 3rem 1fr 20rem auto auto; } }
  .cab-fondo { position: absolute; inset: 0; z-index: -1; background: var(--color-green-800); scale: 0 1; transform-origin: left; transition: scale 500ms cubic-bezier(0.7, 0, 0.2, 1); }
  .cab-mascara { display: block; overflow: hidden; }
  .cab-nombre { display: block; font-family: var(--font-display); font-weight: 800; text-transform: uppercase; line-height: 0.95; font-size: clamp(2rem, 6vw, 5.25rem); translate: 0 105%; }
  .cab-fila:global(.is-visible) .cab-nombre { translate: 0 0; transition: translate 900ms cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 60ms); }
  .cab-num, .cab-items { color: var(--color-text-muted); transition: color 350ms; }
  .cab-mini { width: 5.5rem; height: 4rem; color: var(--color-green-700); transition: color 350ms; }
  @media (min-width: 64rem) { .cab-mini { width: 8rem; height: 5.5rem; } }
  .cab-flecha { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 999px; box-shadow: inset 0 0 0 1px rgb(8 18 13 / 20%); font-size: 1.1rem; transition: background 300ms, color 300ms, rotate 400ms; }

  @media (hover: hover) {
    .cab-enlace:hover { color: var(--color-text-inverse); padding-left: 1.5rem; }
    .cab-enlace:hover .cab-fondo { scale: 1 1; }
    .cab-enlace:hover .cab-num, .cab-enlace:hover .cab-items { color: var(--color-text-inverse-muted); }
    .cab-enlace:hover .cab-mini { color: var(--color-accent-primary); }
    .cab-enlace:hover .cab-flecha { background: var(--color-accent-primary); color: var(--color-neutral-1000); box-shadow: none; rotate: -45deg; }
  }


  :global(html:not(.js)) .cab-nombre { translate: none; }
  @media (prefers-reduced-motion: reduce) { .cab-nombre { translate: none !important; } }
</style>
