---
/**
 * Figma: "Section/Patrocinadores — Carrusel" + "Section/Marcas"
 * Fondo negro y una sola cinta de logos en blanco (filtro sobre los PNG/WebP
 * transparentes) que se detiene al pasar el cursor.
 */
import { obtenerEmpresasAliadas } from '../../lib/empresas';
import SectionHeading from '../ui/SectionHeading.astro';

const empresas = obtenerEmpresasAliadas();

/* Los logos se ven en blanco (silueta) sobre el negro. Los que son una
   figura rellena con el texto dentro (DeWalt, Yale…) quedarían como un
   bloque blanco sin texto; esos van en gris de alto contraste para que el
   texto siga leyéndose. Para un logo nuevo de ese tipo, agrega aquí una
   palabra de su nombre de archivo. */
const LOGOS_BLOQUE = ['dewalt', 'elite', 'gram bel', 'lincolnelectric', 'prolamsa', 'sweiss', 'ujueta', 'yale'];
const esBloque = (nombre: string) => LOGOS_BLOQUE.some((clave) => nombre.toLowerCase().includes(clave));
---

{
  empresas.length > 0 && (
    <section
      id="marcas"
      class="scroll-mt-24 overflow-hidden bg-surface-inverse py-20 text-text-inverse lg:py-28"
    >
      <div class="container-page flex flex-wrap items-end justify-between gap-6">
        <SectionHeading
          tone="dark"
          title="Marcas que manejamos"
          cota={`${empresas.length} marcas de acero, herramienta y ferretería`}
          description="Pregunta por la marca que usas en tu obra o taller."
        />
      </div>

      <div class="mt-12 overflow-hidden max-w-[1200px] mx-auto [mask-image:linear-gradient(to_right,transparent,black_6%,black_94%,transparent)]">
        <ul
          class="marquesina-pista flex w-max items-center gap-12 hover:[animation-play-state:paused] [:focus-within>&]:[animation-play-state:paused] active:[animation-play-state:paused]"
          style={`--marquesina-duracion: ${Math.max(40, empresas.length * 4)}s`}
        >
          {[...empresas, ...empresas].map((empresa, i) => (
            <li
              class="grid h-24 w-40 shrink-0 place-items-center sm:w-48"
              aria-hidden={i >= empresas.length ? 'true' : undefined}
            >
              <img
                src={empresa.imagen}
                alt={i < empresas.length ? empresa.nombre : ''}
                loading="lazy"
                decoding="async"
                class:list={[
                  'max-h-24 w-full object-contain opacity-80 transition duration-300 hover:scale-110 hover:opacity-100',
                  esBloque(empresa.nombre) ? 'grayscale brightness-160 contrast-140' : 'brightness-0 invert',
                ]}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
