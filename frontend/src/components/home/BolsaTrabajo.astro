---
/**
 * Figma: "Section/Bolsa de trabajo" (Job Card) — "¡Únete a nuestro equipo!".
 * Las vacantes viven en src/data/vacantes.ts.
 */
import { assetUrl } from '../../lib/asset-url';
import { whatsappUrl } from '../../lib/seo';
import { vacantes } from '../../data/vacantes';
import { badgeClasses } from '../ui/badge-styles';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const postular = (puesto: string) =>
  whatsappUrl(`Hola, me interesa la vacante de ${puesto}. ¿Cómo puedo enviar mi CV?`);
---

<section
  id="bolsa-de-trabajo"
  class="scroll-mt-44 bg-surface-primary py-20 lg:scroll-mt-28 lg:py-28"
>
  <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <SectionHeading
        eyebrow="Bolsa de trabajo"
        title="¡Únete a nuestro"
        accent="equipo!"
        description="Crece con una empresa sólida de la región. Envíanos tu CV aunque no veas tu puesto aquí."
      />
      <Button
        href={whatsappUrl('Hola, quiero enviar mi CV a Aceros Frontera.')}
        target="_blank"
        variant="dark"
        size="md"
        icon="whatsapp"
        iconPosition="right"
        label="Enviar mi CV"
        className="reveal mt-8"
      />
    </div>

    {
      vacantes.length > 0 && (
        <ul class="flex flex-col gap-3">
          {vacantes.map((vacante, indice) => (
            <li class="reveal" style={`--reveal-delay: ${indice * 80}ms`}>
              <article class="group flex flex-col gap-4 border-l-4 border-brand-primary bg-surface-secondary p-6 transition-colors hover:border-accent-primary hover:bg-surface-canvas sm:flex-row sm:items-center sm:gap-8">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class={badgeClasses('brand')}>{vacante.jornada}</span>
                    <span class="inline-flex items-center gap-1.5 type-caption text-text-muted">
                      <svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true">
                        <use href={`${assetUrl('/icons.svg')}#pin`} />
                      </svg>
                      {vacante.ciudad}
                    </span>
                  </div>
                  <h3 class="mt-3 type-h3 text-text-primary">{vacante.puesto}</h3>
                  <p class="mt-1 type-body-s text-text-secondary">{vacante.descripcion}</p>
                </div>
                <Button
                  href={postular(vacante.puesto)}
                  target="_blank"
                  variant="secondary"
                  size="sm"
                  icon="arrow-right"
                  iconPosition="right"
                  label="Postularme"
                  className="w-fit shrink-0"
                />
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
