---
/**
 * Figma: "Section/Sucursales" (Branch Card) — "Visítanos".
 */
import { assetUrl, rutaInterna } from '../../lib/asset-url';
import { sucursales, telHref, rutaUrl } from '../../data/sucursales';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const icono = (nombre: string) => `${assetUrl('/icons.svg')}#${nombre}`;
---

<section
  id="sucursales-home"
  class="scroll-mt-24 bg-surface-canvas py-20 lg:py-28"
>
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        title="Visítanos en Baja California"
        cota={`${sucursales.length} sucursales en Tijuana, Mexicali y Ensenada`}
        description="Dirección, teléfono y horario de cada sucursal."
      />
      <Button href="/sucursales" variant="link" icon="arrow-right" iconPosition="right" label="Ver mapa de sucursales" className="reveal" />
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        sucursales.map((sucursal, indice) => (
          <li class="reveal" style={`--reveal-delay: ${(indice % 3) * 80}ms`}>
            <article class="chamfer group flex h-full flex-col bg-surface-primary [--chamfer:22px]">
              <header class="pattern-placa relative flex items-end justify-between gap-4 overflow-hidden bg-surface-inverse px-6 pb-5 pt-10 text-text-inverse">
                <div class="relative">
                  <p class="type-label text-text-accent">{sucursal.ciudad}</p>
                  <h3 class="mt-1 type-h3 uppercase">{sucursal.nombre.replace(/^Sucursal\s+/i, '')}</h3>
                </div>
              </header>
              <div class="h-1.5 bg-accent-primary" aria-hidden="true" />
              <div class="flex flex-1 flex-col gap-3 p-6 type-body-s text-text-secondary">
                <p class="flex gap-3">
                  <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-text-brand" aria-hidden="true"><use href={icono('pin')} /></svg>
                  <span>
                    {sucursal.direccion}, {sucursal.colonia}
                    {sucursal.codigoPostal ? `, C.P. ${sucursal.codigoPostal}` : ''}
                  </span>
                </p>
                <p class="flex gap-3">
                  <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-text-brand" aria-hidden="true"><use href={icono('clock')} /></svg>
                  <span class="flex flex-col">
                    {sucursal.horarios.map((h) => <span>{h.dias}: {h.horas}</span>)}
                  </span>
                </p>
                {sucursal.telefonos[0] && (
                  <p class="flex gap-3">
                    <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-text-brand" aria-hidden="true"><use href={icono('phone')} /></svg>
                    <a class="hover:text-text-brand" href={telHref(sucursal.telefonos[0])}>
                      Tel. {sucursal.telefonos[0]}
                    </a>
                  </p>
                )}
                <div class="mt-auto flex flex-wrap gap-x-6 gap-y-2 pt-3">
                  <a href={rutaInterna(`/sucursales/#${sucursal.id}`)} class="type-button-m text-text-brand hover:text-brand-hover hover:underline">
                    Ver sucursal
                  </a>
                  <a href={rutaUrl(sucursal)} target="_blank" rel="noopener noreferrer" class="type-button-m text-text-secondary hover:text-text-primary hover:underline">
                    Cómo llegar
                  </a>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
