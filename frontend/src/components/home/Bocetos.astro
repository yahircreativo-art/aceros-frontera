---
/**
 * "Planos de producto": bento grid de bocetos isométricos de línea
 * (inspirado en el "Build the perfect tools" de raycast.com).
 * Cada boceto se traza una sola vez cuando su celda entra en pantalla.
 * Geometría y textos de las piezas en src/lib/planos.ts.
 */
import { whatsappUrl } from '../../lib/seo';
import { rutaInterna } from '../../lib/asset-url';
import { piezasPlano } from '../../lib/planos';
import PlanoDibujo from './PlanoDibujo.astro';
import Texto from './PlanoTexto.astro';

const [ipr, ptr, angulo, monten, tubo, lamina] = piezasPlano;
const cotizar = (nombre: string) => whatsappUrl(`Hola, quiero cotizar ${nombre}.`);

/* Clases compartidas de las celdas. */
const celda = 'relative border-r border-b border-white/10';
const celdaDibujoAncha = `${celda} h-72 sm:h-96 lg:col-span-2 lg:h-[27rem]`;
const celdaTexto = `${celda} group flex min-h-56 flex-col justify-end p-6 transition-colors hover:bg-white/[0.03] sm:p-8`;
const dibujo = 'absolute inset-x-4 top-10 bottom-4 h-[calc(100%-3.5rem)] w-[calc(100%-2rem)]';
---

<section
  id="planos"
  class="planos relative isolate scroll-mt-24 bg-surface-inverse py-20 text-text-inverse lg:py-28"
>
  <div aria-hidden="true" class="planos-reticula absolute inset-0 -z-10"></div>

  <div class="container-page">
    <div class="grid border-t border-l border-white/10 lg:grid-cols-3">
      <!-- Intro -->
      <div class={`${celda} flex flex-col justify-between gap-10 p-6 sm:p-8 lg:p-10`}>
        <div>
          <h2 class="font-display text-5xl leading-[0.9] font-extrabold uppercase sm:text-6xl">
            El perfil<br />exacto para<br />tu obra
          </h2>
          <p class="mt-6 type-body-m text-text-inverse-muted">
            Perfiles estructurales, tubería y lámina con las medidas que tu proyecto necesita, del plano a
            tu obra.
          </p>
        </div>
        <a
          href={rutaInterna('/catalogo')}
          class="inline-flex w-fit items-center gap-2 border-b-2 border-accent-primary pb-1 type-button-s text-text-inverse hover:text-text-accent"
        >
          Ver catálogo
        </a>
      </div>

      <!-- FIG 01 · IPR -->
      <div class={celdaDibujoAncha}>
        <PlanoDibujo plano={ipr.plano} nombre={ipr.nombre} indice={0} class={dibujo} />
        <p class="absolute bottom-4 left-4 flex flex-col type-body-s text-text-inverse-muted">
          <span class="type-label text-text-inverse">{ipr.nombre}</span>
          <span>{ipr.spec.replace(/ · /g, ', ')}</span>
        </p>
      </div>

      <!-- FIG 02 · PTR -->
      <div class="flex flex-col lg:contents">
        <div class={celdaDibujoAncha}>
          <PlanoDibujo plano={ptr.plano} nombre={ptr.nombre} indice={1} class={dibujo} />
        </div>
        <a href={cotizar(ptr.nombre)} target="_blank" rel="noopener noreferrer" class={celdaTexto}>
          <Texto pieza={ptr} />
        </a>
      </div>

      <!-- FIG 03 · Ángulo y FIG 04 · Monten (celdas compactas) -->
      {
        [angulo, monten].map((pieza, i) => (
          <a
            href={cotizar(pieza.nombre)}
            target="_blank"
            rel="noopener noreferrer"
            class={`${celda} group flex flex-col transition-colors hover:bg-white/[0.03]`}
          >
            <div class="relative h-64">
              <PlanoDibujo plano={pieza.plano} nombre={pieza.nombre} indice={2 + i} class={dibujo} />
            </div>
            <div class="relative flex flex-1 flex-col justify-end px-6 pb-6 sm:px-8 sm:pb-8">
              <Texto pieza={pieza} />
            </div>
          </a>
        ))
      }

      <!-- Celda de cotización -->
      <a
        href={whatsappUrl('Hola, necesito cotizar un perfil o una medida especial.')}
        target="_blank"
        rel="noopener noreferrer"
        class={`${celda} flex min-h-56 flex-col justify-end bg-accent-primary p-6 text-text-on-accent transition-colors hover:bg-accent-hover sm:p-8`}
      >
        <span class="font-display text-4xl leading-[0.95] font-extrabold uppercase">¿Otra medida?</span>
        <span class="mt-3 type-body-s">Cortamos y fabricamos a la medida. Mándanos la medida por WhatsApp.</span>
      </a>

      <!-- FIG 05 · Tubo (texto a la izquierda en escritorio) -->
      <div class="flex flex-col lg:contents">
        <a href={cotizar(tubo.nombre)} target="_blank" rel="noopener noreferrer" class={`${celdaTexto} order-2 lg:order-none`}>
          <Texto pieza={tubo} />
        </a>
        <div class={celdaDibujoAncha}>
          <PlanoDibujo plano={tubo.plano} nombre={tubo.nombre} indice={4} class={dibujo} />
        </div>
      </div>

      <!-- FIG 06 · Lámina -->
      <div class="flex flex-col lg:contents">
        <div class={celdaDibujoAncha}>
          <PlanoDibujo plano={lamina.plano} nombre={lamina.nombre} indice={5} class={dibujo} />
        </div>
        <a href={cotizar(lamina.nombre)} target="_blank" rel="noopener noreferrer" class={celdaTexto}>
          <Texto pieza={lamina} />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  /* Cada boceto se traza una sola vez al entrar en pantalla. */
  const dibujos = document.querySelectorAll<SVGElement>('#planos .plano');
  const observador = new IntersectionObserver(
    (entradas) => {
      for (const entrada of entradas) {
        if (!entrada.isIntersecting) continue;
        entrada.target.classList.add('activo');
        observador.unobserve(entrada.target);
      }
    },
    { threshold: 0.4 },
  );
  dibujos.forEach((dibujo) => observador.observe(dibujo));
</script>

<style is:global>
  .planos-reticula {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: linear-gradient(to bottom, transparent, #000 10%, #000 90%, transparent);
  }

  /* ── Dibujo ─────────────────────────────────────────────── */
  .plano {
    /* Color de las líneas del boceto. */
    --linea: rgb(255 255 255 / 0.9);
    overflow: visible;
  }
  .plano-lineas {
    fill: var(--linea);
  }

  /* Dentro de la máscara: blanco = línea visible, negro = oculto. */
  .plano-pieza path {
    stroke: #fff;
    stroke-width: 1.4;
    fill: #000;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }
  .plano-pieza .plano-liso {
    stroke: #000;
    stroke-width: 0.8;
    stroke-dasharray: none;
  }
  .plano-pieza .plano-silueta {
    fill: none;
  }

  /* Estado activo: las líneas se trazan (una sola vez). */
  .plano.activo .plano-pieza path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.1s cubic-bezier(0.65, 0, 0.35, 1) calc(0.15s + var(--orden) * 0.025s);
  }
  .plano.activo .plano-pieza .plano-frente {
    transition: stroke-dashoffset 1s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .plano.activo .plano-pieza .plano-silueta {
    transition: stroke-dashoffset 1.2s cubic-bezier(0.65, 0, 0.35, 1) 0.4s;
  }

  /* Cota y etiquetas de partes. */
  .plano-cota,
  .plano-notas {
    color: var(--color-text-inverse-muted);
    opacity: 0;
  }
  .plano-cota path,
  .plano-notas path {
    stroke: currentColor;
    stroke-width: 0.9;
  }
  .plano-cota path {
    stroke-dasharray: 3 3;
  }
  .plano-notas circle {
    fill: currentColor;
  }
  .plano-cota text,
  .plano-notas text {
    fill: currentColor;
    font: 600 10px var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .plano.activo .plano-cota,
  .plano.activo .plano-notas {
    opacity: 1;
    transition: opacity 0.6s ease 1.3s;
  }

  /* Sin JS o con movimiento reducido: dibujos completos y estáticos. */
  html:not(.js) .plano .plano-pieza path {
    stroke-dashoffset: 0;
  }
  html:not(.js) .plano .plano-cota,
  html:not(.js) .plano .plano-notas {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .plano .plano-pieza path {
      stroke-dashoffset: 0;
      transition: none !important;
    }
    .plano .plano-cota,
    .plano .plano-notas {
      opacity: 1;
      transition: none !important;
    }
  }
</style>
