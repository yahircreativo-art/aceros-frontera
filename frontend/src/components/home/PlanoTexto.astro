---
/** Texto de una celda del bento "Planos de producto". */
import type { PiezaPlano } from '../../lib/planos';

interface Props {
  pieza: PiezaPlano;
}

const { pieza } = Astro.props;
---

<span class="type-body-s text-text-inverse-muted">{pieza.spec.replace(/ · /g, ', ')}</span>
<span class="mt-2 font-display text-3xl font-extrabold uppercase sm:text-4xl">{pieza.nombre}</span>
<span class="mt-2 max-w-xs type-body-s text-text-inverse-muted">{pieza.texto}</span>
<span class="mt-4 w-fit border-b-2 border-accent-primary pb-1 type-button-s text-text-inverse transition-colors group-hover:text-text-accent">
  Cotizar por WhatsApp<span class="sr-only"> {pieza.nombre}</span>
</span>
