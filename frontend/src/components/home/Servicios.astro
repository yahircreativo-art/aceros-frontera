---
/**
 * Servicios en paneles numerados que se expanden (referencia: "Catálogo
 * central" / "Infraestructura que respalda").
 * En escritorio la sección queda fija mientras se hace scroll y cada tramo
 * de scroll abre el siguiente panel (01 → 06); al pasar el cursor se abre
 * el panel señalado. En celular los paneles van apilados.
 */
import { assetUrl } from '../../lib/asset-url';
import { whatsappUrl } from '../../lib/seo';
import SectionHeading from '../ui/SectionHeading.astro';

/* Datos compartidos con las propuestas Servicios A–E. */
import { servicios } from '../servicios-propuestas/servicios-data';

const flecha = `${assetUrl('/icons.svg')}#arrow-right`;
---

<section
  id="servicios"
  data-servicios
  class="relative scroll-mt-24 bg-surface-inverse py-20 text-text-inverse lg:h-[280svh] lg:py-0"
  style={`--paneles: ${servicios.length}`}
>
  <div
    class="container-page lg:sticky lg:top-20 lg:flex lg:h-[calc(100svh-5rem)] lg:flex-col lg:justify-center lg:py-10"
  >
    <SectionHeading
      tone="dark"
      title="Infraestructura que respalda"
      cota={`${servicios.length} servicios para tu obra o taller`}
      description="Cobertura, versatilidad en transformación y soporte técnico para optimizar tus tiempos y reducir mermas."
    />

    <ul
      class="servicios-lista reveal mt-12 flex flex-col gap-3 lg:mt-8 lg:h-[min(34rem,calc(100svh-19rem))] lg:min-h-[22rem] lg:flex-row"
    >
      {
        servicios.map((servicio, indice) => (
          <li
            id={servicio.id}
            data-servicio={indice}
            class:list={[
              { activo: indice === 0 },
              'group relative min-h-[18rem] scroll-mt-24 overflow-hidden bg-surface-inverse lg:min-h-0',
            ]}
          >
            <a
              href={whatsappUrl(`Hola, quiero información sobre el servicio de ${servicio.titulo}.`)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${servicio.titulo}: solicitar información por WhatsApp`}
              class="absolute inset-0 flex flex-col justify-between p-6"
            >
              <img
                src={servicio.imagen}
                alt=""
                loading="lazy"
                decoding="async"
                class="absolute inset-0 -z-0 size-full object-cover opacity-60 lg:left-1/2 lg:w-[48rem] lg:max-w-none lg:-translate-x-1/2 grayscale transition duration-1000 group-hover:opacity-90 group-hover:grayscale-0"
              />
              <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-black/10" />

              <span aria-hidden="true" class="relative block h-1 w-12 bg-accent-primary" />

              <span
                aria-hidden="true"
                class="servicio-vertical absolute bottom-6 left-6 hidden font-display text-2xl font-extrabold whitespace-nowrap uppercase [writing-mode:vertical-rl] rotate-180"
              >
                {servicio.titulo}
              </span>

              <span class="servicio-cuerpo relative block">
                <span class="block font-display text-3xl leading-[0.95] font-extrabold uppercase lg:max-w-[20rem]">
                  {servicio.titulo}
                </span>
                <span class="servicio-desc mt-3 block max-w-md overflow-hidden type-body-s text-text-inverse-muted">
                  {servicio.descripcion}
                </span>
                <span class="mt-5 inline-flex items-center gap-2 type-button-s text-text-accent">
                  Solicitar información
                  <svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:translate-x-1" aria-hidden="true">
                    <use href={flecha} />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  /* Escritorio: el avance del scroll dentro de la sección decide qué panel
     está abierto (01 al principio, 06 al final). */
  const seccion = document.querySelector<HTMLElement>('[data-servicios]');
  const paneles = [...(seccion?.querySelectorAll<HTMLElement>('[data-servicio]') ?? [])];
  const escritorio = window.matchMedia('(min-width: 64rem)');

  if (seccion && paneles.length) {
    let actual = 0;
    let pendiente = false;

    const activar = (indice: number) => {
      if (indice === actual) return;
      paneles[actual]?.classList.remove('activo');
      paneles[indice]?.classList.add('activo');
      actual = indice;
    };

    const actualizar = () => {
      pendiente = false;
      if (!escritorio.matches) return;
      const caja = seccion.getBoundingClientRect();
      const recorrido = caja.height - window.innerHeight;
      const avance = recorrido > 0 ? Math.min(Math.max(-caja.top / recorrido, 0), 0.999) : 0;
      activar(Math.floor(avance * paneles.length));
    };

    const programar = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(actualizar);
    };

    window.addEventListener('scroll', programar, { passive: true });
    window.addEventListener('resize', programar);
    escritorio.addEventListener('change', programar);
    actualizar();
  }
</script>

<style>
  @media (min-width: 64rem) {
    .servicios-lista > li {
      flex: 1 1 0%;
      transition: flex 900ms cubic-bezier(0.25, 0.8, 0.25, 1);
    }
    /* Abierto: el panel señalado con el cursor o, si no hay cursor encima,
       el que marca el scroll (.activo). */
    .servicios-lista > li:hover,
    .servicios-lista > li:focus-within,
    .servicios-lista:not(:hover):not(:focus-within) > li.activo {
      flex-grow: 5;
    }
    .servicio-desc {
      max-height: 0;
      opacity: 0;
      transition:
        max-height 900ms ease,
        opacity 700ms ease;
    }
    .servicio-vertical {
      display: block;
      transition: opacity 500ms ease;
    }
    .servicio-cuerpo {
      min-width: 22rem;
      transition: opacity 500ms ease;
    }
    .servicios-lista > li .servicio-cuerpo {
      opacity: 0;
    }
    .servicios-lista > li:hover .servicio-vertical,
    .servicios-lista > li:focus-within .servicio-vertical,
    .servicios-lista:not(:hover):not(:focus-within) > li.activo .servicio-vertical {
      opacity: 0;
    }
    .servicios-lista > li:hover .servicio-cuerpo,
    .servicios-lista > li:focus-within .servicio-cuerpo,
    .servicios-lista:not(:hover):not(:focus-within) > li.activo .servicio-cuerpo {
      opacity: 1;
      transition-delay: 300ms;
    }
    .servicios-lista > li:hover .servicio-desc,
    .servicios-lista > li:focus-within .servicio-desc,
    .servicios-lista:not(:hover):not(:focus-within) > li.activo .servicio-desc {
      max-height: 10rem;
      opacity: 1;
    }
    /* El panel abierto por scroll también se ve a color. */
    .servicios-lista:not(:hover):not(:focus-within) > li.activo img {
      filter: none;
      opacity: 0.9;
    }
  }
  /* Foco visible: el enlace ocupa todo el panel y el li recorta el contorno, así que se dibuja por dentro. */
  .servicios-lista a:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 3px var(--color-accent-primary);
  }
  @media (prefers-reduced-motion: reduce) {
    .servicios-lista > li,
    .servicio-desc,
    .servicio-vertical,
    .servicio-cuerpo {
      transition: none !important;
    }
  }
</style>
