---
/**
 * SERVICIOS J · "Historias"
 * Fondo negro. Un visor grande con la foto del servicio a todo lo ancho,
 * cortado en chaflán, y encima su nombre, descripción y botón. Arriba, una
 * barra por servicio (como historias) que se llena: al terminar pasa solo
 * al siguiente. Debajo de cada barra, el nombre del servicio para saltar a
 * él. Se pausa con el cursor encima, con el foco dentro, fuera de pantalla
 * o con la pestaña oculta. Flechas de anterior y siguiente.
 *
 * Sin JavaScript se ve el primer servicio; con
 * "reducir movimiento" no avanza solo ni hace zoom.
 *
 * Uso: <ServiciosJ />
 */
import Button from '../ui/Button.astro';
import Cota from '../ui/Cota.astro';
import { servicios, infoUrl, cotaServicios, encabezado } from './servicios-data';
import { assetUrl } from '../../lib/asset-url';

const flecha = `${assetUrl('/icons.svg')}#arrow-right`;
---

<section id="servicios" data-svj class="svj relative scroll-mt-24 bg-neutral-950 py-20 text-text-inverse lg:py-24">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-3xl">
        <h2 class="font-display text-[clamp(2.5rem,5vw,4.5rem)] leading-[0.92] font-extrabold uppercase">{encabezado.titulo}</h2>
        <Cota texto={cotaServicios} class="mt-4 text-text-accent" />
      </div>
      <div class="flex gap-2">
        <button type="button" data-svj-mover="-1" class="svj-flecha" aria-label="Servicio anterior">
          <svg viewBox="0 0 24 24" class="size-5 rotate-180" aria-hidden="true"><use href={flecha} /></svg>
        </button>
        <button type="button" data-svj-mover="1" class="svj-flecha" aria-label="Servicio siguiente">
          <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"><use href={flecha} /></svg>
        </button>
      </div>
    </div>

    <!-- Barras de avance: una por servicio -->
    <div class="svj-barras mt-10 grid gap-2" style={`grid-template-columns: repeat(${servicios.length}, minmax(0, 1fr))`} role="tablist" aria-label="Servicios">
      {servicios.map((s, i) => (
        <button type="button" role="tab" data-svj-ir={i} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`svj-panel-${i}`} class="svj-barra group min-w-0 text-left">
          <span class="relative block h-[3px] overflow-hidden bg-white/20"><i class="svj-relleno absolute inset-0 bg-accent-primary"></i></span>
          <span class="svj-nombre mt-3 hidden truncate font-display text-sm font-bold tracking-wide uppercase md:block">{s.titulo}</span>
        </button>
      ))}
    </div>

    <!-- Visor -->
    <div class="svj-visor chamfer relative mt-6 overflow-hidden [--chamfer:36px]">
      {servicios.map((s, i) => (
        <article id={`svj-panel-${i}`} data-svj-panel={i} role="tabpanel" class:list={['svj-panel absolute inset-0', { 'is-on': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
          <img src={s.imagen} alt="" loading="lazy" decoding="async" class="svj-foto absolute inset-0 size-full object-cover" />
          <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-black/10"></span>
          <div class="absolute inset-x-0 bottom-0 p-6 sm:p-10">
            <h3 class="font-display text-[clamp(2.25rem,5vw,4.5rem)] leading-[0.9] font-extrabold uppercase">{s.titulo}</h3>
            <p class="mt-3 max-w-xl type-body-m text-text-inverse-muted">{s.descripcion}</p>
            <Button href={infoUrl(s)} target="_blank" variant="secondary" size="md" icon="whatsapp" iconPosition="right" label="Solicitar información" class="mt-6" />
          </div>
        </article>
      ))}
    </div>
    <p class="mt-6 max-w-xl type-body-s text-text-inverse-muted">{encabezado.descripcion}</p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-svj]');
  if (root) {
    const barras = [...root.querySelectorAll<HTMLButtonElement>('[data-svj-ir]')];
    const paneles = [...root.querySelectorAll<HTMLElement>('[data-svj-panel]')];
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actual = 0;
    root.classList.add('is-js');
    if (!quieto) root.classList.add('is-auto');

    const ir = (i: number) => {
      actual = (i + paneles.length) % paneles.length;
      barras.forEach((b, k) => {
        b.setAttribute('aria-selected', String(k === actual));
        b.classList.toggle('is-hecha', k < actual);
        /* Reinicia la animación de llenado de la barra activa. */
        const r = b.querySelector<HTMLElement>('.svj-relleno')!;
        r.classList.remove('is-llena');
        if (k === actual) { void r.offsetWidth; r.classList.add('is-llena'); }
      });
      paneles.forEach((p, k) => {
        const on = k === actual;
        p.classList.toggle('is-on', on);
        p.toggleAttribute('aria-hidden', !on);
        p.querySelector('a')?.setAttribute('tabindex', on ? '0' : '-1');
      });
    };

    barras.forEach((b, i) => b.addEventListener('click', () => ir(i)));
    root.querySelectorAll<HTMLButtonElement>('[data-svj-mover]').forEach((b) =>
      b.addEventListener('click', () => ir(actual + Number(b.dataset.svjMover))),
    );
    /* Al llenarse la barra activa, pasa sola al siguiente servicio. */
    root.addEventListener('animationend', (e) => {
      if ((e.target as HTMLElement).classList.contains('is-llena')) ir(actual + 1);
    });

    /* Pausa: cursor encima, foco dentro, fuera de pantalla o pestaña oculta. */
    let fuera = true;
    const pausar = () => root.classList.toggle('is-pausa', fuera || document.hidden || root.matches(':hover') || root.contains(document.activeElement));
    new IntersectionObserver(([e]) => { fuera = !e.isIntersecting; pausar(); }, { threshold: 0.35 }).observe(root);
    ['pointerenter', 'pointerleave', 'focusin', 'focusout'].forEach((ev) => root.addEventListener(ev, () => requestAnimationFrame(pausar)));
    document.addEventListener('visibilitychange', pausar);

    ir(0);
    pausar();
  }
</script>

<style>
  .svj-visor { height: clamp(26rem, 62svh, 40rem); background: var(--color-neutral-900); }
  .svj-panel { opacity: 0; visibility: hidden; transition: opacity 600ms ease, visibility 0s 600ms; }
  .svj-panel.is-on { opacity: 1; visibility: visible; transition: opacity 600ms ease, visibility 0s; z-index: 1; }
  /* Zoom lento de la foto activa (efecto Ken Burns). */
  .svj-panel.is-on .svj-foto { animation: svj-zoom 7s linear both; }
  @keyframes svj-zoom { from { scale: 1; } to { scale: 1.08; } }

  .svj-barra { cursor: pointer; padding-block: 0.5rem; color: var(--color-text-inverse-muted); transition: color 200ms; }
  .svj-barra:hover, .svj-barra[aria-selected='true'] { color: var(--color-text-inverse); }
  .svj-barra:focus-visible { outline: 2px solid var(--color-accent-primary); outline-offset: 2px; }
  .svj-relleno { transform-origin: left; scale: 0 1; }
  .svj-barra.is-hecha .svj-relleno, .svj-barra[aria-selected='true'] .svj-relleno { scale: 1 1; }
  /* Con avance automático, la barra activa se llena en 6 s. */
  .svj.is-auto .svj-relleno.is-llena { animation: svj-llena 6s linear both; }
  .svj.is-pausa .svj-relleno.is-llena, .svj.is-pausa .svj-panel.is-on .svj-foto { animation-play-state: paused; }
  @keyframes svj-llena { from { scale: 0 1; } to { scale: 1 1; } }

  .svj-flecha {
    display: grid; place-items: center; width: 3rem; height: 3rem; cursor: pointer;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 25%); color: var(--color-text-inverse);
    transition: background 200ms, color 200ms;
  }
  .svj-flecha:hover { background: var(--color-accent-primary); color: var(--color-neutral-1000); }
  .svj-flecha:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--color-accent-primary); }

  @media (prefers-reduced-motion: reduce) {
    .svj-panel, .svj-panel.is-on { transition: none; }
    .svj-panel.is-on .svj-foto { animation: none; }
  }
</style>
