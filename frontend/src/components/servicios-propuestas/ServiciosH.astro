---
/**
 * SERVICIOS H · "Tarjetas apiladas"
 * Fondo negro. En escritorio el encabezado queda fijo a la izquierda y, a
 * la derecha, los servicios son tarjetas que se apilan al bajar: cada una
 * sube y se acomoda encima de la anterior, que se encoge un poco y se
 * oscurece, como láminas que se van estibando. Cada tarjeta: color de marca
 * con el texto a un lado y la foto al otro, con esquina cortada.
 * En celular las tarjetas van una debajo de otra (sin apilarse) para no
 * alargar la página.
 *
 * Sin JavaScript se apilan igual (position: sticky) pero sin encogerse; con
 * "reducir movimiento" tampoco se encogen.
 *
 * Uso: <ServiciosH />
 */
import Button from '../ui/Button.astro';
import Cota from '../ui/Cota.astro';
import Pictogram from '../ui/Pictogram.astro';
import { servicios, infoUrl, cotaServicios, encabezado } from './servicios-data';

const tonos = ['svh-verde', 'svh-amarillo', 'svh-blanco', 'svh-gris'];
---

<section id="servicios" data-svh class="svh relative scroll-mt-24 bg-neutral-950 py-20 text-text-inverse lg:py-28">
  <div class="container-page grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:gap-14">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <h2 class="font-display text-[clamp(2.5rem,4.5vw,4.25rem)] leading-[0.92] font-extrabold uppercase">{encabezado.titulo}</h2>
      <Cota texto={cotaServicios} class="mt-4 text-text-accent" />
      <p class="mt-5 max-w-sm type-body-m text-text-inverse-muted">{encabezado.descripcion}</p>
    </div>

    <ul class="svh-pila grid grid-cols-[minmax(0,1fr)] gap-4 lg:gap-10" role="list">
      {servicios.map((s, i) => (
        <li id={s.id} data-svh-tarjeta class="svh-item min-w-0 scroll-mt-28" style={`--i:${i}`}>
          <article class:list={['svh-tarjeta chamfer grid overflow-hidden [--chamfer:28px] sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]', tonos[i % tonos.length]]}>
            <div class="flex flex-col p-6 sm:p-8 lg:p-10">
              <Pictogram name={s.pictograma} class="size-12" />
              <h3 class="mt-auto pt-10 font-display text-[clamp(2rem,3vw,2.75rem)] leading-[0.92] font-extrabold uppercase">{s.titulo}</h3>
              <p class="svh-desc mt-3 type-body-s">{s.descripcion}</p>
              <Button href={infoUrl(s)} target="_blank" variant={i % tonos.length === 1 ? 'dark' : 'secondary'} size="sm" icon="whatsapp" iconPosition="right" label="Solicitar información" class="mt-6 w-fit" />
            </div>
            <img src={s.imagen} alt="" loading="lazy" decoding="async" class="aspect-[16/10] size-full object-cover sm:aspect-auto" />
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-svh]');
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !quieto) {
    const items = [...root.querySelectorAll<HTMLElement>('[data-svh-tarjeta]')];
    const escritorio = window.matchMedia('(min-width: 64rem)');
    let pendiente = false;
    /* --t de cada tarjeta: cuánto la tapa la siguiente (0 = nada, 1 = completa). */
    const pintar = () => {
      pendiente = false;
      items.forEach((it, i) => {
        const sig = items[i + 1];
        if (!escritorio.matches || !sig) return it.style.setProperty('--t', '0');
        const a = it.getBoundingClientRect();
        const dist = sig.getBoundingClientRect().top - a.top;
        it.style.setProperty('--t', Math.min(1, Math.max(0, 1 - dist / a.height)).toFixed(3));
      });
    };
    const programar = () => {
      if (!pendiente) { pendiente = true; requestAnimationFrame(pintar); }
    };
    window.addEventListener('scroll', programar, { passive: true });
    window.addEventListener('resize', programar);
    pintar();
  }
</script>

<style>
  .svh-verde { background: var(--color-green-800); color: var(--color-text-inverse); }
  .svh-amarillo { background: var(--color-accent-primary); color: var(--color-neutral-1000); }
  .svh-blanco { background: var(--color-neutral-0); color: var(--color-text-primary); }
  .svh-gris { background: var(--color-neutral-800); color: var(--color-text-inverse); }
  .svh-desc { opacity: 0.8; max-width: 32ch; }

  @media (min-width: 64rem) {
    /* Cada tarjeta se detiene un poco más abajo que la anterior: se ve el borde de las de atrás. */
    .svh-item { position: sticky; top: calc(7rem + var(--i) * 1.1rem); }
    .svh-pila { padding-bottom: 4rem; }
    .svh-tarjeta {
      min-height: clamp(22rem, 58svh, 28rem);
      transform-origin: center top;
      scale: calc(1 - var(--t, 0) * 0.07);
      filter: brightness(calc(1 - var(--t, 0) * 0.45));
    }
  }
</style>
