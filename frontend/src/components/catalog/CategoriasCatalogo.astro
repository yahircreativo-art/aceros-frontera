---
/**
 * Categorías del catálogo en línea (/catalogo), montadas sobre la franja de
 * promociones. Mosaicos con pictograma y número real de productos; el último
 * lleva a "Todos los productos". En celular se desplazan de lado.
 */
import { obtenerProductos } from "../../lib/productos";
import { rutaInterna } from "../../lib/asset-url";
import { iconoCategoria, rutaCategoria } from "../../lib/categorias";
import TarjetaCategoria from "./TarjetaCategoria.astro";

/* Usa la misma descarga del catálogo que el resto del build. */
const productos = await obtenerProductos();
const conteo = new Map<string, number>();
for (const p of productos) {
  const c = String(p.Categoria ?? "").trim();
  if (c) conteo.set(c, (conteo.get(c) ?? 0) + 1);
}
const categorias = [...conteo.keys()].sort((a, b) => a.localeCompare(b, "es"));
---

{
  categorias.length ? (
    <nav id="categorias" aria-label="Categorías del catálogo" class="scroll-mt-24 py-4">
      <ul class="cat-lista">
        {categorias.map((categoria) => (
          <li>
            <TarjetaCategoria
              href={rutaInterna(`${rutaCategoria(categoria, categorias)}/`)}
              nombre={categoria}
              total={conteo.get(categoria) ?? 0}
              icono={iconoCategoria(categoria)}
            />
          </li>
        ))}
        <li>
          <TarjetaCategoria href="#catalogo" nombre="Todos los productos" total={productos.length} icono="herramienta" oscura />
        </li>
      </ul>
    </nav>
  ) : null
}

<style>
  .cat-lista {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 40rem) { .cat-lista { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .cat-lista { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 80rem) { .cat-lista { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .cat-lista > li { min-width: 0; }
</style>
