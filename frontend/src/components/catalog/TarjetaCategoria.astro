---
/**
 * Mosaico de una categoría del catálogo en línea: pictograma, nombre y
 * número real de productos. Lo usan CategoriasCatalogo (/catalogo) y la
 * sección "Otras categorías" de /catalogo/<categoria>.
 * `oscura` es la variante para "Todos los productos".
 */
import Pictogram, { type PictogramName } from '../ui/Pictogram.astro';

interface Props {
  href: string;
  nombre: string;
  total: number;
  icono: PictogramName;
  oscura?: boolean;
  class?: string;
}

const { href, nombre, total, icono, oscura = false, class: clase = '' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'cat-tile chamfer group relative flex h-full flex-col items-start justify-between gap-3 overflow-hidden p-4 [--chamfer:14px] sm:gap-5 sm:p-5 sm:[--chamfer:18px]',
    oscura ? 'pattern-placa bg-neutral-950 text-text-inverse' : 'bg-surface-primary text-text-primary',
    clase,
  ]}
>
  <span
    class:list={[
      'cat-tile-icono relative grid size-10 shrink-0 place-items-center transition-colors duration-200 sm:size-12',
      oscura ? 'bg-accent-primary text-text-on-accent' : 'bg-neutral-100 text-green-700',
    ]}
  >
    <Pictogram name={icono} class="size-6 sm:size-7" />
  </span>
  <span class="relative block min-w-0">
    <span class="block font-display text-base leading-[1.05] font-extrabold uppercase sm:text-xl">{nombre}</span>
    <span class:list={['mt-0.5 block type-body-s sm:mt-1', oscura ? 'text-text-inverse-muted' : 'text-text-secondary']}>
      {total} {total === 1 ? 'producto' : 'productos'}
    </span>
  </span>
  <span class="cat-tile-barra absolute inset-x-0 bottom-0 h-1 bg-accent-primary" aria-hidden="true"></span>
</a>

<style>
  .cat-tile { transition: background-color 200ms; }
  .cat-tile-barra { transform: scaleX(0); transform-origin: left; transition: transform 250ms ease; }
  .cat-tile:hover .cat-tile-barra,
  .cat-tile:focus-visible .cat-tile-barra { transform: scaleX(1); }
  .cat-tile:hover .cat-tile-icono:not(.bg-accent-primary) { background: var(--color-green-700); color: var(--color-neutral-0); }
  .cat-tile:focus-visible { outline: none; box-shadow: inset 0 0 0 3px var(--color-border-focus); }
  @media (prefers-reduced-motion: reduce) {
    .cat-tile-barra, .cat-tile-icono { transition: none; }
  }
</style>
