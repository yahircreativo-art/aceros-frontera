---
import { assetUrl } from '../lib/asset-url';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const logoSrc = assetUrl('/images/LOGO.webp');
---

<a href="#" class="inline-flex shrink-0 items-center" aria-label="Aceros Frontera — ir al inicio">
  <img
    src={logoSrc}
    alt="Logo aceros frontera"
    class={compact ? 'h-8 w-auto' : 'h-10 w-auto'}
    width="286"
    height="72"
    decoding="async"
  />
</a>
