---
/**
 * Figma: Footer [Type=Desktop / Mobile]
 * surface/inverse + Pattern/Placa antiderrapante · Brand Stripe[L] arriba ·
 * Brand (Logo 56 px, tagline Heading/H4 text/accent, Body-S) · columnas con
 * título Body/Overline (text/accent) y enlaces Body/Body-S (text/inverse-muted) ·
 * divisor y pie Body/Caption.
 */
import Logo from './Logo.astro';
import { siteSeo, whatsappUrl } from '../lib/seo';
import { assetUrl, rutaInterna } from '../lib/asset-url';

const anio = new Date().getFullYear();

const columnas = [
  {
    titulo: 'Catálogo',
    enlaces: [
      { href: '/catalogo', label: 'Todos los productos' },
      { href: '/#marcas', label: 'Materiales que manejamos' },
      {
        href: whatsappUrl('Hola, necesito cotizar acero y materiales para mi proyecto.'),
        label: 'Cotizar materiales',
        externo: true,
      },
    ],
  },
  {
    titulo: 'Empresa',
    enlaces: [
      { href: '/nosotros', label: 'Nosotros' },
      { href: '/#servicios', label: 'Servicios' },
      { href: '/sucursales', label: 'Sucursales' },
      { href: '/contacto', label: 'Contacto' },
    ],
  },
];
---

<footer id="pie" class="brand-stripe-top-lg pattern-placa bg-surface-inverse">
  <div class="container-page pb-8 pt-12 md:pt-16">
    <div class="grid gap-12 md:grid-cols-[minmax(0,18.75rem)_1fr] md:gap-16">
      <div class="flex flex-col gap-4">
        <Logo large />
        <p class="type-h4 text-text-accent">¿Precios? ¡Nos arreglamos!</p>
        <p class="type-body-s text-text-inverse-muted">{siteSeo.description}</p>
        <ul class="flex flex-col gap-2 type-caption text-text-inverse">
          <li>
            <a
              class="inline-flex items-center gap-2 transition-colors hover:text-text-accent"
              href={whatsappUrl()}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 24 24" class="size-4 shrink-0 text-text-accent" aria-hidden="true">
                <use href={`${assetUrl('/icons.svg')}#whatsapp`}></use>
              </svg>
              WhatsApp {siteSeo.phone}
            </a>
          </li>
          <li>
            <a
              class="inline-flex items-center gap-2 transition-colors hover:text-text-accent"
              href={`tel:${siteSeo.phoneHref}`}
            >
              <svg viewBox="0 0 24 24" class="size-4 shrink-0 text-text-accent" aria-hidden="true">
                <use href={`${assetUrl('/icons.svg')}#phone`}></use>
              </svg>
              {siteSeo.phone}
            </a>
          </li>
          <li>
            <a
              class="inline-flex items-center gap-2 transition-colors hover:text-text-accent"
              href={`mailto:${siteSeo.email}`}
            >
              <svg viewBox="0 0 24 24" class="size-4 shrink-0 text-text-accent" aria-hidden="true">
                <use href={`${assetUrl('/icons.svg')}#mail`}></use>
              </svg>
              {siteSeo.email}
            </a>
          </li>
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4 lg:gap-12">
        {
          columnas.map((columna) => (
            <div>
              <h2 class="type-overline text-text-accent">{columna.titulo}</h2>
              <ul class="mt-3 flex flex-col gap-3 type-body-s text-text-inverse-muted">
                {columna.enlaces.map((enlace) => (
                  <li>
                    <a
                      class="transition-colors hover:text-text-inverse"
                      href={rutaInterna(enlace.href)}
                      target={enlace.externo ? '_blank' : undefined}
                      rel={enlace.externo ? 'noopener noreferrer' : undefined}
                    >
                      {enlace.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div>
          <h2 class="type-overline text-text-accent">Ubicación</h2>
          <address class="mt-3 type-body-s not-italic text-text-inverse-muted">
            {siteSeo.address.street}
            <br />
            {siteSeo.address.city}, {siteSeo.address.region}
          </address>
        </div>

        <div>
          <h2 class="type-overline text-text-accent">Horario</h2>
          <ul class="mt-3 flex flex-col gap-3 type-body-s text-text-inverse-muted">
            {
              siteSeo.openingHours.map((horario) => (
                <li>
                  {horario.label}
                  <br />
                  {horario.opens} – {horario.closes}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-text-inverse-muted/40 pt-8 type-caption text-text-inverse-muted sm:flex-row sm:items-center sm:justify-between sm:gap-6"
    >
      <p>© {anio} {siteSeo.legalName}®. Todos los derechos reservados.</p>
      <p>Atención para proyectos y fabricación</p>
    </div>
  </div>
</footer>
