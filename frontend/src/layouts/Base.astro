---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { siteSeo, type PageId, whatsappUrl } from '../lib/seo';
import { assetUrl } from '../lib/asset-url';

interface Props {
  page?: PageId;
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const { page = 'home', title, description, canonicalPath } = Astro.props;
---

<!doctype html>
<html lang={siteSeo.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/png" href={assetUrl('/favicon.png')} />

    {/* Google Fonts (Design System Figma): Montserrat para texto y Barlow Condensed para títulos y botones. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Montserrat:wght@400;500;600;700&display=swap"
    />

    <Seo page={page} title={title} description={description} path={canonicalPath} />
    <slot name="head" />
  </head>

  <body class="bg-white text-ink-900 antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-field focus:bg-brand-700 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Saltar al contenido
    </a>
    <slot />
    <nav
      aria-label="Contacto rápido"
      class="fixed bottom-5 right-4 z-40 flex flex-col gap-3 md:hidden"
    >
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contactar por WhatsApp"
        title="Contactar por WhatsApp"
        class="flex size-16 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lift transition-transform hover:scale-105 focus-visible:outline-offset-4"
      >
        <svg viewBox="0 0 24 24" class="size-8" aria-hidden="true">
          <use href={`${assetUrl('/icons.svg')}#whatsapp`}></use>
        </svg>
      </a>
      <a
        href={`mailto:${siteSeo.email}`}
        aria-label={`Enviar correo a ${siteSeo.email}`}
        title="Enviar correo"
        class="flex size-16 items-center justify-center rounded-full bg-brand-700 text-white shadow-lift transition-transform hover:scale-105 focus-visible:outline-offset-4"
      >
        <svg viewBox="0 0 24 24" class="size-8" aria-hidden="true">
          <use href={`${assetUrl('/icons.svg')}#mail`}></use>
        </svg>
      </a>
    </nav>
    <script>
      /* Animación de aparición (.reveal) al entrar en pantalla. */
      const elementos = document.querySelectorAll<HTMLElement>('.reveal');
      if (!('IntersectionObserver' in window)) {
        elementos.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observador = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (entrada.isIntersecting) {
                entrada.target.classList.add('is-visible');
                observador.unobserve(entrada.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        const alto = window.innerHeight;
        elementos.forEach((el) => {
          /* Lo que ya está en pantalla al cargar se muestra sin esperar al observador. */
          const caja = el.getBoundingClientRect();
          if (caja.top < alto && caja.bottom > 0) el.classList.add('is-visible');
          else observador.observe(el);
        });
      }
    </script>
  </body>
</html>
