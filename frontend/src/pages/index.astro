---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";
import HeroHome from "../components/home/HeroHome.astro";
import Marcas from "../components/home/Marcas.astro";
import Categorias from "../components/home/Categorias.astro";
import Fabricantes from "../components/home/Fabricantes.astro";
import Destacados from "../components/home/Destacados.astro";
import Servicios from "../components/home/Servicios.astro";
import CentroServicio from "../components/home/CentroServicio.astro";
import Eslogan from "../components/home/Eslogan.astro";
import Nosotros from "../components/home/Nosotros.astro";
import Sucursales from "../components/home/Sucursales.astro";
import BolsaTrabajo from "../components/home/BolsaTrabajo.astro";
import CtaFinal from "../components/home/CtaFinal.astro";
import { obtenerProductos } from "../lib/productos";

// Catálogo desde Supabase si está configurado; si no, desde los .md locales.
const productos = await obtenerProductos();
---

<Base page="home">
  <link
    slot="head"
    rel="preload"
    href="/images/hero-bg.webp"
    as="image"
    type="image/webp"
    fetchpriority="high"
  />
  <Header productos={productos} />

  <main id="contenido" class="overflow-x-clip">
    <HeroHome />
    <Marcas />
    <Categorias productos={productos} />
    <Fabricantes />
    <Destacados productos={productos} />
    <Servicios />
    <CentroServicio />
    <Eslogan />
    <Nosotros />
    <Sucursales />
    <BolsaTrabajo />
    <Contact />
    <CtaFinal />
  </main>

  <Footer />
</Base>
