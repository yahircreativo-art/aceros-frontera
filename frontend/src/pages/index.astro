---
/* Variantes publicadas. Para comparar otras sin tocar el sitio: /propuestas/
   (src/data/propuestas.ts). Si cambias una aquí, cambia también su `actual`. */
import Portada from "../components/Portada.astro";
import Header from "../components/navbars/NavbarE.astro";
import Hero from "../components/heros/HeroG.astro";
import Nosotros from "../components/nosotros/NosotrosA.astro";
import Categorias from "../components/catalogo-propuestas/CatalogoB.astro";
import Contacto from "../components/contacto-propuestas/ContactoD.astro";
import { obtenerProductos } from "../lib/productos";

// Catálogo desde Supabase (sin credenciales, la portada se genera sin productos).
const productos = await obtenerProductos();
---

<Portada
  productos={productos}
  Header={Header}
  Hero={Hero}
  Nosotros={Nosotros}
  Categorias={Categorias}
  Contacto={Contacto}
/>
