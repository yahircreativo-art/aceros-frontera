---
import Base from "../layouts/Base.astro";
import Header from "../components/navbars/NavbarC.astro";
import Footer from "../components/Footer.astro";
import Catalog from "../components/catalog/Catalog";
import PromocionesDestacadas from "../components/catalog/PromocionesDestacadas";
import CategoriasCatalogo from "../components/catalog/CategoriasCatalogo.astro";
import SeccionesPromociones from "../components/catalog/SeccionesPromociones.astro";
import { obtenerProductos, paraTarjetas } from "../lib/productos";
import { esBanner, obtenerPromociones } from "../lib/destacados";

const productos = await obtenerProductos();
const promociones = await obtenerPromociones();
/* Banner = TRUE → carrusel principal · Banner = FALSE → cuadrícula de abajo. */
const promocionesBanner = promociones.filter(esBanner);
const promocionesGrid = promociones.filter((promocion) => !esBanner(promocion));
const categorias = [...new Set(productos.map((producto) => producto.Categoria).filter(Boolean))]
  .map(String);

const supabaseUrl = (import.meta.env.SUPABASE_URL ?? '').trim();
const supabaseKey = (import.meta.env.SUPABASE_ANON_KEY ?? '').trim();
const supabaseDestacadosTable =
  import.meta.env.SUPABASE_DESTACADOS_TABLE ?? "Promociones";
const supabasePromosBucket =
  import.meta.env.SUPABASE_PROMOS_BUCKET ?? "Productos-imagenes";
---

<Base page="catalogo">
  <Header productos={productos} />

  <main id="contenido">
    <h1 class="sr-only">Catálogo de acero, ferretería y pintura en Tijuana, Mexicali y Ensenada</h1>
    {/* Publicidades a todo el ancho y, dentro de la misma franja, las categorías. */}
    <section
      id="destacados"
      class="scroll-mt-24"
    >
      {promocionesBanner.length ? (
        <PromocionesDestacadas
          client:load
          promociones={promocionesBanner}
          categorias={categorias}
          supabaseUrl={supabaseUrl}
          supabaseKey={supabaseKey}
          supabaseTabla={supabaseDestacadosTable}
          supabaseBucket={supabasePromosBucket}
        />
      ) : null}

      {/* La tarjeta de categorías se monta ligeramente sobre la franja de promociones. */}
      <div
        class={`container-page relative ${promocionesBanner.length ? "-mt-12 lg:-mt-18" : ""}`}
      >
        <CategoriasCatalogo />
      </div>
    </section>

    {/* Imágenes promocionales administradas en la misma tabla de Supabase. */}
    {promocionesGrid.length ? (
      <div class="container-page">
        <SeccionesPromociones promociones={promocionesGrid} categorias={categorias} />
      </div>
    ) : null}

    <section
      id="catalogo"
      class="scroll-mt-24 bg-surface-canvas pt-4 pb-16"
    >
      <div class="container-page">
        <Catalog
          client:idle
          productos={paraTarjetas(productos)}
        />
      </div>
    </section>
  </main>

  <Footer />
</Base>
