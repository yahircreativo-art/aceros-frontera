---
import Base from '../layouts/Base.astro';
import Header from '../components/navbars/NavbarC.astro';
import Footer from '../components/Footer.astro';
import { siteSeo, whatsappUrl } from '../lib/seo';
import { obtenerProductos } from '../lib/productos';
import { assetUrl } from '../lib/asset-url';
import { slugCategoria } from '../lib/categorias';
import Button from '../components/ui/Button.astro';
import Cota from '../components/ui/Cota.astro';
import {
  mapaEmbed,
  rutaUrl,
  sucursales,
  sucursalesPorCiudad,
  telHref,
} from '../data/sucursales';

const productos = await obtenerProductos();
const grupos = sucursalesPorCiudad();
const totalSucursales = sucursales.length;

const slugCiudad = (ciudad: string) => slugCategoria(ciudad);

---

<Base page="sucursales">
  <Header productos={productos} />

  <main id="contenido" class="bg-surface-canvas">
    <section class="bg-neutral-950 text-text-inverse">
      <div class="container-page py-12 lg:py-20">
        <h1 class="max-w-4xl font-display text-5xl leading-[0.95] font-extrabold uppercase sm:text-6xl lg:text-7xl">
          {totalSucursales} sucursales de acero en Baja California
        </h1>
        <Cota texto="Tijuana, Mexicali y Ensenada" class="mt-5 text-text-accent" />
        <p class="mt-6 max-w-2xl type-body-l text-text-inverse-muted">
          Encuentra la sucursal más cercana, consulta teléfonos y horarios y abre la ruta para llegar.
        </p>

        <nav aria-label="Ir a una ciudad" class="mt-8 grid max-w-2xl grid-cols-3 gap-2">
          {grupos.map(({ ciudad, sucursales: lista }) => (
            <a href={`#${slugCiudad(ciudad)}`} class="suc-ciudad chamfer flex flex-col gap-1 bg-white/5 p-4 [--chamfer:14px]">
              <span class="type-h4">{ciudad}</span>
              <span class="type-body-s text-text-inverse-muted">{lista.length} {lista.length === 1 ? 'sucursal' : 'sucursales'}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <div class="container-page py-12 lg:py-16">
      <div class="space-y-14 lg:space-y-20">
        {
          grupos.map(({ ciudad, sucursales: lista }) => (
            <section id={slugCiudad(ciudad)} class="scroll-mt-24" aria-labelledby={`ciudad-${slugCiudad(ciudad)}`}>
              <h2 id={`ciudad-${slugCiudad(ciudad)}`} class="font-display text-4xl font-extrabold uppercase text-text-primary">{ciudad}</h2>

              <ul class="mt-7 grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-2 lg:gap-8">
                {lista.map((sucursal) => (
                  <li id={sucursal.id} class="chamfer scroll-mt-24 bg-surface-primary [--chamfer:28px]">
                    <iframe
                      title={`Mapa de ${sucursal.nombre}, ${sucursal.ciudad}`}
                      src={mapaEmbed(sucursal)}
                      class="aspect-4/3 w-full border-0 sm:aspect-video"
                      loading="lazy"
                      referrerpolicy="no-referrer-when-downgrade"
                      allowfullscreen
                    />
                    <div class="h-1.5 bg-accent-primary" aria-hidden="true" />

                    <div class="p-5 sm:p-7">
                      <h3 class="font-display text-3xl font-extrabold uppercase text-text-primary">
                        {sucursal.nombre.replace(/^Sucursal\s+/, '')}
                      </h3>

                      <address class="mt-4 flex gap-3 type-body-s not-italic text-text-secondary">
                        <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-text-brand" aria-hidden="true">
                          <use href={`${assetUrl('/icons.svg')}#pin`} />
                        </svg>
                        <span>
                          {sucursal.direccion}, {sucursal.colonia}
                          <br />
                          {sucursal.codigoPostal ? `${sucursal.codigoPostal} ` : ''}
                          {sucursal.ciudad}, {sucursal.estado}
                        </span>
                      </address>

                      <div class="mt-4 flex gap-3 type-body-s text-text-secondary">
                        <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-text-brand" aria-hidden="true">
                          <use href={`${assetUrl('/icons.svg')}#phone`} />
                        </svg>
                        <div class="flex flex-wrap gap-x-4 gap-y-1">
                          {sucursal.telefonos.map((telefono) => (
                            <a class="font-semibold text-text-primary hover:text-text-brand hover:underline" href={telHref(telefono)} aria-label={`Llamar a ${sucursal.nombre} al ${telefono}`}>
                              {telefono}
                            </a>
                          ))}
                        </div>
                      </div>

                      <div class="mt-4 flex gap-3 type-body-s text-text-secondary">
                        <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-text-brand" aria-hidden="true">
                          <use href={`${assetUrl('/icons.svg')}#clock`} />
                        </svg>
                        <div>
                          {sucursal.horarios.map((horario) => (
                            <p><span class="font-semibold text-text-primary">{horario.dias}:</span> {horario.horas}</p>
                          ))}
                        </div>
                      </div>

                      <div class="mt-6 flex flex-wrap gap-3">
                        <Button href={rutaUrl(sucursal)} target="_blank" variant="primary" size="md" label="Cómo llegar" />
                        <Button
                          href={whatsappUrl(`Hola, quiero información de la ${sucursal.nombre} en ${sucursal.ciudad}.`)}
                          target="_blank"
                          variant="outline"
                          size="md"
                          icon="whatsapp"
                          iconPosition="right"
                          label="WhatsApp"
                        />
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <section aria-labelledby="atencion-general" class="chamfer mt-14 bg-neutral-950 p-6 text-text-inverse [--chamfer:28px] sm:p-10 lg:mt-20">
        <h2 id="atencion-general" class="font-display text-4xl font-extrabold uppercase">¿No sabes cuál te queda más cerca?</h2>
        <p class="mt-3 max-w-2xl type-body-m text-text-inverse-muted">
          Escríbenos y te canalizamos a la sucursal con el material que necesitas.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={whatsappUrl()} target="_blank" variant="secondary" size="lg" icon="whatsapp" iconPosition="right" label="Cotizar por WhatsApp" />
          <Button href={`mailto:${siteSeo.email}`} variant="outline" size="lg" label="Enviar correo" />
        </div>
      </section>
    </div>
  </main>

  <Footer />

</Base>

<style>
  .suc-ciudad { transition: background-color 200ms; }
  .suc-ciudad:hover { background: rgb(255 255 255 / 10%); }
  .suc-ciudad:focus-visible { outline: none; box-shadow: inset 0 0 0 3px var(--color-accent-primary); }
</style>
