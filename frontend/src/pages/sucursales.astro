---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteSeo, whatsappUrl } from '../lib/seo';
import { obtenerProductos } from '../lib/productos';
import { assetUrl } from '../lib/asset-url';
import {
  mapaEmbed,
  rutaUrl,
  sucursales,
  sucursalesPorCiudad,
  telHref,
} from '../data/sucursales';

const productos = await obtenerProductos();
const grupos = sucursalesPorCiudad();
const totalSucursales = sucursales.length;

const slugCiudad = (ciudad: string) =>
  ciudad
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/\s+/g, '-');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sucursales de Aceros Frontera',
  numberOfItems: totalSucursales,
  itemListElement: sucursales.map((sucursal, indice) => ({
    '@type': 'ListItem',
    position: indice + 1,
    item: {
      '@type': 'HardwareStore',
      name: `${siteSeo.name} — ${sucursal.nombre}`,
      telephone: `+52${sucursal.telefonos[0].replace(/\D/g, '')}`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: sucursal.direccion,
        addressLocality: sucursal.ciudad,
        addressRegion: sucursal.estado,
        postalCode: sucursal.codigoPostal,
        addressCountry: siteSeo.address.country,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: sucursal.coordenadas.lat,
        longitude: sucursal.coordenadas.lng,
      },
      openingHoursSpecification: sucursal.horarios.map((horario) => ({
        '@type': 'OpeningHoursSpecification',
        description: `${horario.dias}: ${horario.horas}`,
      })),
      url: sucursal.mapaUrl,
    },
  })),
};

---

<Base page="sucursales">
  <Header productos={productos} />

  <main id="contenido">
    <!-- Portada de la sección -->
    <section class="border-b border-line bg-ink-50/60">
      <div class="container-page py-12 lg:py-16">
        <p class="text-2xs font-bold uppercase tracking-[0.18em] text-brand-600">Sucursales</p>
        <h1 class="mt-3 max-w-3xl font-display text-3xl font-bold text-ink-900 sm:text-4xl lg:text-5xl">
          {totalSucursales} sucursales de acero en Baja California
        </h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-600 sm:text-base">
          Visítanos en Tijuana, Mexicali y Ensenada. Encuentra en el mapa la sucursal más cercana,
          consulta teléfonos, horarios y la ruta para llegar.
        </p>

        <nav aria-label="Ir a una ciudad" class="mt-7 flex flex-wrap gap-2">
          {grupos.map(({ ciudad, sucursales: lista }) => (
            <a
              href={`#${slugCiudad(ciudad)}`}
              class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-ink-700 shadow-card transition-colors hover:border-brand-600 hover:text-brand-700"
            >
              {ciudad}
              <span class="text-xs font-medium text-ink-400">{lista.length}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <!-- Listado por ciudad -->
    <div class="container-page py-12 lg:py-16">
      <div class="space-y-14 lg:space-y-20">
        {
          grupos.map(({ ciudad, sucursales: lista }) => (
            <section id={slugCiudad(ciudad)} class="scroll-mt-40 lg:scroll-mt-32">
              <div class="flex flex-wrap items-end justify-between gap-3 border-b border-line pb-4">
                <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">{ciudad}</h2>
                <p class="text-sm text-ink-500">
                  {lista.length} {lista.length === 1 ? 'sucursal' : 'sucursales'}
                </p>
              </div>

              <ul class="mt-7 grid gap-6 lg:grid-cols-2 lg:gap-8">
                {lista.map((sucursal) => (
                  <li
                    id={sucursal.id}
                    class="scroll-mt-40 overflow-hidden rounded-panel border border-line bg-white shadow-card lg:scroll-mt-32"
                  >
                    <iframe
                      title={`Mapa de ${sucursal.nombre}, ${sucursal.ciudad}`}
                      src={mapaEmbed(sucursal)}
                      class="aspect-4/3 w-full border-0 sm:aspect-video"
                      loading="lazy"
                      referrerpolicy="no-referrer-when-downgrade"
                      allowfullscreen
                    />

                    <div class="p-5 sm:p-6">
                      <h3 class="font-display text-lg font-bold text-ink-900 sm:text-xl">
                        {sucursal.nombre}
                      </h3>

                      <address class="mt-3 flex gap-2.5 text-sm not-italic leading-relaxed text-ink-600">
                        <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-brand-600" aria-hidden="true">
                          <use href={`${assetUrl('/icons.svg')}#pin`} />
                        </svg>
                        <span>
                          {sucursal.direccion}, {sucursal.colonia}
                          <br />
                          {sucursal.codigoPostal ? `${sucursal.codigoPostal} ` : ''}
                          {sucursal.ciudad}, {sucursal.estado}
                        </span>
                      </address>

                      <div class="mt-4 flex gap-2.5 text-sm text-ink-600">
                        <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-brand-600" aria-hidden="true">
                          <use href={`${assetUrl('/icons.svg')}#phone`} />
                        </svg>
                        <div class="flex flex-wrap gap-x-3 gap-y-1">
                          {sucursal.telefonos.map((telefono, indice) => (
                            <a
                              class="font-medium text-ink-800 hover:text-brand-700"
                              href={telHref(telefono)}
                              aria-label={`Llamar a ${sucursal.nombre} al ${telefono}`}
                            >
                              {telefono}
                              {indice === 0 && (
                                <span class="ml-1.5 align-middle text-2xs font-semibold uppercase tracking-wide text-brand-600">
                                  Ventas
                                </span>
                              )}
                            </a>
                          ))}
                        </div>
                      </div>

                      <div class="mt-4 flex gap-2.5 text-sm text-ink-600">
                        <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-brand-600" aria-hidden="true">
                          <use href={`${assetUrl('/icons.svg')}#clock`} />
                        </svg>
                        <div class="space-y-0.5">
                          {sucursal.horarios.map((horario) => (
                            <p>
                              <span class="font-medium text-ink-800">{horario.dias}:</span>{' '}
                              {horario.horas}
                            </p>
                          ))}
                        </div>
                      </div>

                      <div class="mt-6 flex flex-wrap gap-3">
                        <a
                          href={rutaUrl(sucursal)}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 rounded-field bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-800"
                        >
                          Cómo llegar
                          <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
                            <use href={`${assetUrl('/icons.svg')}#arrow-right`} />
                          </svg>
                        </a>
                        <a
                          href={whatsappUrl(
                            `Hola, quiero información de la ${sucursal.nombre} en ${sucursal.ciudad}.`,
                          )}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 rounded-field border border-line px-4 py-2.5 text-sm font-semibold text-ink-800 transition-colors hover:border-brand-600 hover:text-brand-700"
                        >
                          <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
                            <use href={`${assetUrl('/icons.svg')}#whatsapp`} />
                          </svg>
                          WhatsApp
                        </a>
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <!-- Atención general -->
      <section
        aria-labelledby="atencion-general"
        class="mt-14 rounded-panel border border-line bg-ink-50/60 p-6 sm:p-8 lg:mt-20"
      >
        <h2 id="atencion-general" class="font-display text-xl font-bold text-ink-900 sm:text-2xl">
          ¿No sabes cuál te queda más cerca?
        </h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-600">
          Escríbenos y te canalizamos a la sucursal con el material que necesitas, o cotiza
          directamente por WhatsApp y correo.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={whatsappUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-field bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-800"
          >
            <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
              <use href={`${assetUrl('/icons.svg')}#whatsapp`} />
            </svg>
            Cotizar por WhatsApp
          </a>
          <a
            href={`tel:${siteSeo.phoneHref}`}
            class="inline-flex items-center gap-2 rounded-field border border-line bg-white px-4 py-2.5 text-sm font-semibold text-ink-800 transition-colors hover:border-brand-600 hover:text-brand-700"
          >
            <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
              <use href={`${assetUrl('/icons.svg')}#phone`} />
            </svg>
            {siteSeo.phone}
          </a>
          <a
            href={`mailto:${siteSeo.email}`}
            class="inline-flex items-center gap-2 rounded-field border border-line bg-white px-4 py-2.5 text-sm font-semibold text-ink-800 transition-colors hover:border-brand-600 hover:text-brand-700"
          >
            <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
              <use href={`${assetUrl('/icons.svg')}#mail`} />
            </svg>
            {siteSeo.email}
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
