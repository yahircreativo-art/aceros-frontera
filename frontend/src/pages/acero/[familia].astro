---
/**
 * Página fija por familia de acero (Láminas, Perfiles, Estructurales…).
 * El catálogo en línea (Supabase) hoy solo trae ferretería y pintura; estas
 * páginas dan a cada familia de acero su propia URL para Google con
 * contenido real: qué se maneja, en qué sucursales y cómo cotizar.
 * Si una familia ya tiene categoría en Supabase, rutaFamilia() enlaza a esa
 * categoría y esta página no se genera.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/navbars/NavbarC.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/ui/Button.astro';
import Cota from '../../components/ui/Cota.astro';
import Pictogram from '../../components/ui/Pictogram.astro';
import PlanoLinea from '../../components/catalogo-propuestas/PlanoLinea.astro';
import { prepararFamilias, type FamiliaCatalogo } from '../../components/catalogo-propuestas/catalogo-data';
import { familias, categoriaDeFamilia, slugFamilia } from '../../data/familias';
import { sucursalesPorCiudad, telHref } from '../../data/sucursales';
import { obtenerCategorias, obtenerProductos } from '../../lib/productos';
import { rutaInterna } from '../../lib/asset-url';
import { ciudadesSeo, recortarTexto, siteSeo, whatsappUrl } from '../../lib/seo';

export async function getStaticPaths() {
  const categorias = await obtenerCategorias();
  return familias
    .filter((f) => !categoriaDeFamilia(f, categorias))
    .map((f) => ({ params: { familia: slugFamilia(f) }, props: { titulo: f.titulo } }));
}

const { titulo } = Astro.props as { titulo: string };
const productos = await obtenerProductos();
const todas = prepararFamilias(productos);
const familia = todas.find((f) => f.titulo === titulo) as FamiliaCatalogo;
const otras = todas.filter((f) => f.titulo !== titulo);
const grupos = sucursalesPorCiudad();
const totalSucursales = grupos.reduce((n, g) => n + g.sucursales.length, 0);

/* En medio de la frase va en minúscula, salvo siglas (PTR / HSS). */
const enFrase = (t: string) => (/^[A-ZÁÉÍÓÚÑ]{2,}/.test(t) ? t : t.toLocaleLowerCase('es-MX'));
const lista = familia.items.map(enFrase).join(', ').replace(/, ([^,]*)$/, ' y $1');
const ruta = `/acero/${slugFamilia(familia)}/`;
const title = recortarTexto(`${familia.titulo} de acero en Tijuana`, 60 - ' | Aceros Frontera'.length) + ' | Aceros Frontera';
const description = recortarTexto(
  `${familia.titulo} en Aceros Frontera: ${lista}. Cotiza por WhatsApp y recoge en ${totalSucursales} sucursales de ${ciudadesSeo}.`,
  158,
);

const sitio = Astro.site ?? new URL(siteSeo.baseUrl);
const absoluta = (r: string) => new URL(rutaInterna(r), sitio).toString();
const extraLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: 'Catálogo', item: absoluta('/catalogo/') },
      { name: familia.titulo, item: absoluta(ruta) },
    ].map((paso, i) => ({ '@type': 'ListItem', position: i + 1, ...paso })),
  },
];

const cotizar = whatsappUrl(`Hola, quiero cotizar ${familia.titulo.toLocaleLowerCase('es-MX')}.`);
---

<Base page="familia" title={title} description={description} canonicalPath={ruta} extraLd={extraLd}>
  <Header productos={productos} />

  <main id="contenido" class="bg-surface-canvas">
    <section class="bg-neutral-950 text-text-inverse">
      <div class="fam-hero container-page grid items-center gap-10 py-12 lg:py-20">
        <div class="min-w-0">
          <nav aria-label="Ruta de navegación" class="type-body-s text-text-inverse-muted">
            <a href={rutaInterna('/catalogo/')} class="type-label text-text-accent hover:underline">Catálogo</a>
            <span aria-hidden="true" class="mx-2">/</span>
            <span>{familia.titulo}</span>
          </nav>
          <h1 class="mt-6 font-display text-5xl leading-[0.95] font-extrabold uppercase sm:text-6xl lg:text-7xl">
            {familia.titulo} en {ciudadesSeo}
          </h1>
          <Cota texto={`${totalSucursales} sucursales para cotizar y recoger`} class="mt-5 text-text-accent" />
          <p class="mt-6 max-w-xl type-body-l text-text-inverse-muted">
            Manejamos {lista}. Pregunta medidas, calibres y existencias en tu
            sucursal o envíanos tu lista por WhatsApp.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href={cotizar} target="_blank" variant="secondary" size="lg" icon="whatsapp" iconPosition="right" label={`Cotizar ${familia.corto.toLocaleLowerCase('es-MX')}`} />
            <Button href="/sucursales/" variant="outline" size="lg" label="Ver sucursales" />
          </div>
        </div>
        <div class="mx-auto w-full max-w-sm text-text-inverse lg:max-w-none">
          <PlanoLinea plano={familia.plano} nombre={familia.pieza} notas={false} class="fam-plano w-full" />
        </div>
      </div>
    </section>

    <section aria-labelledby="fam-productos" class="container-page py-14 lg:py-20">
      <h2 id="fam-productos" class="font-display text-4xl font-extrabold uppercase text-text-primary">Qué manejamos</h2>
      <ul class="mt-8 grid grid-cols-[minmax(0,1fr)] gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {familia.items.map((item) => (
          <li>
            <a
              href={whatsappUrl(`Hola, quiero cotizar ${enFrase(item)} (${familia.titulo.toLocaleLowerCase('es-MX')}).`)}
              target="_blank"
              rel="noopener noreferrer"
              class="fam-item chamfer group flex items-center justify-between gap-4 bg-surface-primary p-5 [--chamfer:18px]"
            >
              <span class="flex items-center gap-4">
                <Pictogram name={familia.icono} class="size-8 shrink-0 text-green-700" />
                <span class="type-h4 text-text-primary">{item}</span>
              </span>
              <span class="type-label text-text-brand group-hover:underline">Cotizar</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="fam-sucursales" class="bg-surface-primary py-14 lg:py-20">
      <div class="container-page">
        <h2 id="fam-sucursales" class="font-display text-4xl font-extrabold uppercase text-text-primary">Dónde comprar</h2>
        <div class="mt-8 grid grid-cols-[minmax(0,1fr)] gap-10 md:grid-cols-3">
          {grupos.map(({ ciudad, sucursales }) => (
            <div class="min-w-0">
              <h3 class="type-h4 text-text-primary">{ciudad}</h3>
              <ul class="mt-4 flex flex-col gap-4">
                {sucursales.map((s) => (
                  <li class="border-l-2 border-accent-primary pl-4">
                    <a href={rutaInterna(`/sucursales/#${s.id}`)} class="type-label text-text-brand hover:underline">
                      {s.nombre.replace(/^Sucursal\s+/, '')}
                    </a>
                    <p class="type-body-s text-text-secondary">{s.direccion}, {s.colonia}</p>
                    <a href={telHref(s.telefonos[0])} class="type-body-s text-text-secondary hover:text-text-primary">{s.telefonos[0]}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section aria-labelledby="fam-otras" class="container-page py-14 lg:py-20">
      <h2 id="fam-otras" class="font-display text-4xl font-extrabold uppercase text-text-primary">Otras familias</h2>
      <ul class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
        {otras.map((f) => (
          <li>
            <a href={f.href} class="fam-item chamfer flex h-full flex-col gap-3 bg-surface-primary p-4 [--chamfer:14px]">
              <Pictogram name={f.icono} class="size-7 text-green-700" />
              <span class="type-label text-text-primary">{f.titulo}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <Footer />
</Base>

<script>
  /* El boceto se traza una vez al cargar la página. */
  requestAnimationFrame(() => document.querySelector('.fam-plano')?.classList.add('is-trazado'));
</script>

<style>
  .fam-hero { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 64rem) { .fam-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 26rem); } }
  .fam-item { transition: background-color 200ms, color 200ms; }
  .fam-item:hover { background: var(--color-neutral-100); }
  .fam-item:focus-visible { outline: none; box-shadow: inset 0 0 0 3px var(--color-border-focus); }
</style>
