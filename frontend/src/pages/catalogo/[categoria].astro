---
import Base from "../../layouts/Base.astro";
import Header from "../../components/navbars/NavbarC.astro";
import Footer from "../../components/Footer.astro";
import Catalog from "../../components/catalog/Catalog";
import { obtenerProductos, paraTarjetas } from "../../lib/productos";
import { rutasCategorias } from "../../lib/categorias";
import { ciudadesSeo, recortarTexto } from "../../lib/seo";

export async function getStaticPaths() {
  const productos = await obtenerProductos();
  const categorias = [
    ...new Set(
      productos
        .map((producto) => String(producto.Categoria ?? "").trim())
        .filter(Boolean),
    ),
  ];
  const rutas = rutasCategorias(categorias);

  return categorias.map((categoria) => ({
    params: { categoria: rutas.get(categoria)!.slice("/catalogo/".length) },
    props: { categoria, categorias, productos },
  }));
}

const { categoria, categorias, productos } = Astro.props;
const canonicalPath = rutasCategorias(categorias).get(categoria) ?? "/catalogo";
const total = productos.filter((p) => String(p.Categoria ?? "").trim() === categoria).length;
const title = recortarTexto(`${categoria} en Tijuana`, 60 - " | Aceros Frontera".length) + " | Aceros Frontera";
const description = recortarTexto(
  `${total} productos de ${categoria.toLocaleLowerCase("es-MX")} en el catálogo de Aceros Frontera. Busca por nombre o clave y cotiza por WhatsApp en ${ciudadesSeo}.`,
  158,
);
/* La cuadrícula solo necesita los productos de esta categoría (antes recibía el catálogo completo). */
const productosCategoria = productos.filter((p) => String(p.Categoria ?? "").trim() === categoria);
---

<Base
  page="catalogo"
  title={title}
  description={description}
  canonicalPath={canonicalPath}
>
  <Header productos={productos} />

  <main id="contenido">
    <section id="catalogo" class="scroll-mt-24 bg-surface-canvas pt-4 pb-16">
      <div class="container-page">
        <Catalog
          client:load
          productos={paraTarjetas(productosCategoria)}
          categoriaInicial={categoria}
        />
      </div>
    </section>
  </main>

  <Footer />
</Base>
