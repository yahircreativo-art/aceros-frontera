---
/**
 * Vista interna para comparar las variantes de la portada (noindex, fuera del
 * sitemap). /propuestas/ es el diseño publicado y /propuestas/<seccion>-<letra>/
 * cambia solo esa sección. Configuración en src/data/propuestas.ts.
 */
import Portada from '../../components/Portada.astro';
import PanelPropuestas from '../../components/PanelPropuestas.astro';
import { obtenerProductos } from '../../lib/productos';
import { propuestas, seleccionActual, type Seleccion, type SeccionPropuesta } from '../../data/propuestas';

import NavbarA from '../../components/navbars/NavbarA.astro';
import NavbarB from '../../components/navbars/NavbarB.astro';
import NavbarC from '../../components/navbars/NavbarC.astro';
import NavbarD from '../../components/navbars/NavbarD.astro';
import NavbarE from '../../components/navbars/NavbarE.astro';
import HeroA from '../../components/heros/HeroA.astro';
import HeroB from '../../components/heros/HeroB.astro';
import HeroC from '../../components/heros/HeroC.astro';
import HeroD from '../../components/heros/HeroD.astro';
import HeroE from '../../components/heros/HeroE.astro';
import HeroF from '../../components/heros/HeroF.astro';
import HeroG from '../../components/heros/HeroG.astro';
import HeroH from '../../components/heros/HeroH.astro';
import HeroI from '../../components/heros/HeroI.astro';
import HeroJ from '../../components/heros/HeroJ.astro';
import HeroK from '../../components/heros/HeroK.astro';
import HeroL from '../../components/heros/HeroL.astro';
import NosotrosA from '../../components/nosotros/NosotrosA.astro';
import NosotrosB from '../../components/nosotros/NosotrosB.astro';
import NosotrosC from '../../components/nosotros/NosotrosC.astro';
import NosotrosD from '../../components/nosotros/NosotrosD.astro';
import NosotrosE from '../../components/nosotros/NosotrosE.astro';
import CatalogoA from '../../components/catalogo-propuestas/CatalogoA.astro';
import CatalogoB from '../../components/catalogo-propuestas/CatalogoB.astro';
import CatalogoC from '../../components/catalogo-propuestas/CatalogoC.astro';
import CatalogoD from '../../components/catalogo-propuestas/CatalogoD.astro';
import CatalogoE from '../../components/catalogo-propuestas/CatalogoE.astro';
import ResenasA from '../../components/resenas/ResenasA.astro';
import ResenasB from '../../components/resenas/ResenasB.astro';
import ResenasC from '../../components/resenas/ResenasC.astro';
import ResenasD from '../../components/resenas/ResenasD.astro';
import ResenasE from '../../components/resenas/ResenasE.astro';
import ServiciosA from '../../components/servicios-propuestas/ServiciosA.astro';
import ServiciosB from '../../components/servicios-propuestas/ServiciosB.astro';
import ServiciosC from '../../components/servicios-propuestas/ServiciosC.astro';
import ServiciosD from '../../components/servicios-propuestas/ServiciosD.astro';
import ServiciosE from '../../components/servicios-propuestas/ServiciosE.astro';
import FooterA from '../../components/footers/FooterA.astro';
import FooterB from '../../components/footers/FooterB.astro';
import FooterC from '../../components/footers/FooterC.astro';
import FooterD from '../../components/footers/FooterD.astro';
import FooterE from '../../components/footers/FooterE.astro';
import ContactoA from '../../components/contacto-propuestas/ContactoA.astro';
import ContactoB from '../../components/contacto-propuestas/ContactoB.astro';
import ContactoC from '../../components/contacto-propuestas/ContactoC.astro';
import ContactoD from '../../components/contacto-propuestas/ContactoD.astro';
import ContactoE from '../../components/contacto-propuestas/ContactoE.astro';

export function getStaticPaths() {
  const base = seleccionActual();
  return [
    { params: { variante: undefined }, props: { seleccion: base, vista: null } },
    ...propuestas.flatMap((p) =>
      p.letras
        .filter((letra) => letra !== p.actual)
        .map((letra) => ({
          params: { variante: `${p.id}-${letra.toLowerCase()}` },
          props: { seleccion: { ...base, [p.id]: letra }, vista: p.id },
        })),
    ),
  ];
}

const { seleccion, vista } = Astro.props as { seleccion: Seleccion; vista: SeccionPropuesta | null };

const componentes: Record<SeccionPropuesta, Record<string, any>> = {
  navbar: { A: NavbarA, B: NavbarB, C: NavbarC, D: NavbarD, E: NavbarE },
  hero: { A: HeroA, B: HeroB, C: HeroC, D: HeroD, E: HeroE, F: HeroF, G: HeroG, H: HeroH, I: HeroI, J: HeroJ, K: HeroK, L: HeroL },
  nosotros: { A: NosotrosA, B: NosotrosB, C: NosotrosC, D: NosotrosD, E: NosotrosE },
  catalogo: { A: CatalogoA, B: CatalogoB, C: CatalogoC, D: CatalogoD, E: CatalogoE },
  resenas: { A: ResenasA, B: ResenasB, C: ResenasC, D: ResenasD, E: ResenasE },
  servicios: { A: ServiciosA, B: ServiciosB, C: ServiciosC, D: ServiciosD, E: ServiciosE },
  footer: { A: FooterA, B: FooterB, C: FooterC, D: FooterD, E: FooterE },
  contacto: { A: ContactoA, B: ContactoB, C: ContactoC, D: ContactoD, E: ContactoE },
};

const productos = await obtenerProductos();
const ruta = Astro.params.variante ? `/propuestas/${Astro.params.variante}/` : '/propuestas/';
---

<Portada
  page="propuestas"
  canonicalPath={ruta}
  productos={productos}
  Header={componentes.navbar[seleccion.navbar]}
  Hero={componentes.hero[seleccion.hero]}
  Nosotros={componentes.nosotros[seleccion.nosotros]}
  Categorias={componentes.catalogo[seleccion.catalogo]}
  Resenas={componentes.resenas[seleccion.resenas]}
  Contacto={componentes.contacto[seleccion.contacto]}
  Pie={componentes.footer[seleccion.footer]}
  ServiciosSec={componentes.servicios[seleccion.servicios]}
>
  <PanelPropuestas seleccion={seleccion} vista={vista} />
</Portada>
